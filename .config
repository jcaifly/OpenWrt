# ==============================================================================
# OpenWrt .config 配置文件
# 适用于 Newifi 3 (D2) 路由器，基于 lede 分支
# 包含 OpenClash, Firewall4, dnsmasq-full, SmartDNS, USB 打印机, TurboACC, 关机, IPv6
# 排除 UPnP 和 DDNS
# 使用默认 Bootstrap 主题
# ==============================================================================

# 基本配置
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# 固件格式和压缩
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ==============================================================================
# 网络配置
# ==============================================================================

# IPv6 支持
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ip6tables-extra=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_luci-proto-ipv6=y # LuCI 对 IPv6 的支持

# Firewall4 (nftables)
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-fullcone=y # FullCone NAT 内核模块
CONFIG_PACKAGE_iptables-nft=y # iptables 兼容层 (使用 nftables 后端)
CONFIG_PACKAGE_ip6tables-nft=y # ip6tables 兼容层 (使用 nftables 后端)
CONFIG_PACKAGE_xtables-nft=y # xtables 兼容层 (使用 nftables 后端)
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y # Firewall4 LuCI 中文语言包

# 禁用 Firewall3 (iptables) 以避免冲突
# CONFIG_PACKAGE_firewall is not set
# CONFIG_PACKAGE_iptables is not set
# CONFIG_PACKAGE_ip6tables is not set

# DNS 配置
# 使用 dnsmasq-full 代替 dnsmasq
# CONFIG_PACKAGE_dnsmasq is not set # 禁用默认 dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y # 启用 dnsmasq-full
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y # dnsmasq-full 的 DHCPv6 支持
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_noid=y

# SmartDNS
CONFIG_PACKAGE_smartdns=y # SmartDNS 二进制
CONFIG_PACKAGE_luci-app-smartdns=y # SmartDNS LuCI 界面
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y # SmartDNS LuCI 中文语言包

# 禁用 UPnP 和 DDNS
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ddns-scripts is not set

# 无线驱动
CONFIG_PACKAGE_kmod-mt7603e=y # MT7603E 驱动 (2.4G)
CONFIG_PACKAGE_kmod-mt76x2e=y # MT7612E / MT7602E 驱动 (5G)

# ==============================================================================
# 软件包和应用
# ==============================================================================

# OpenClash
CONFIG_PACKAGE_luci-app-openclash=y # OpenClash LuCI 界面
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y # OpenClash LuCI 中文语言包
# OpenClash 依赖项 (根据项目要求和常见配置添加)
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ipset=y # IP 集支持
CONFIG_PACKAGE_ip-full=y # 完整的 ip 命令工具
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
# 可能需要的其他依赖，编译时如果提示缺失再添加

# TurboACC
CONFIG_PACKAGE_luci-app-turboacc=y # TurboACC LuCI 界面
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y # TurboACC LuCI 中文语言包
# TurboACC 选项
# 禁用 Shortcut-FE 以避免与 Firewall4 或其他功能冲突
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y # 包含 BBR 拥塞控制算法
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_PDNSD=y # 包含 PDNSD (作为 SmartDNS 的备选或补充)

# USB 打印机支持
CONFIG_PACKAGE_kmod-usb-printer=y # USB 打印机内核模块
CONFIG_PACKAGE_p910nd=y # 打印机服务器守护进程
CONFIG_PACKAGE_luci-app-p910nd=y # p910nd LuCI 界面
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y # p910nd LuCI 中文语言包

# 关机功能
CONFIG_PACKAGE_luci-app-poweroffdevice=y # 关机 LuCI 界面
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y # 关机 LuCI 中文语言包
# 关机命令通常由 busybox 提供，poweroffdevice 只是 LuCI 界面

# ==============================================================================
# LuCI 界面和主题
# ==============================================================================

CONFIG_PACKAGE_luci=y # LuCI 核心
CONFIG_PACKAGE_luci-compat=y # LuCI 兼容性库
CONFIG_PACKAGE_luci-lib-ipkg=y # LuCI 包管理库
CONFIG_PACKAGE_luci-base=y # LuCI 基础模块
CONFIG_PACKAGE_luci-proto-ppp=y # LuCI 对 PPP 协议的支持 (如 PPPoE)

# 默认主题: Bootstrap
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 中文语言包 (已包含在各应用部分，此处确保基础和防火墙语言包)
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # LuCI 基础中文语言包

# ==============================================================================
# 系统工具和基础组件
# ==============================================================================

# 必要的网络工具
CONFIG_PACKAGE_htop=y # 进程监视工具
CONFIG_PACKAGE_curl=y # 命令行下载工具 (OpenClash 依赖)
CONFIG_PACKAGE_wget=y # 命令行下载工具
CONFIG_PACKAGE_ip-full=y # 完整的 ip 命令工具 (OpenClash 依赖)
CONFIG_PACKAGE_iperf3=y # 网络性能测试工具
CONFIG_PACKAGE_tcpdump=y # 网络抓包工具
CONFIG_PACKAGE_ethtool=y # 网卡配置工具

# 文件系统工具 (用于 USB 存储等)
CONFIG_PACKAGE_block-mount=y # 块设备挂载支持
CONFIG_PACKAGE_fdisk=y # 磁盘分区工具
CONFIG_PACKAGE_lsblk=y # 列出块设备信息
CONFIG_PACKAGE_vim-full=y # 全功能 Vim 编辑器

# 安全增强
CONFIG_PACKAGE_openssh-sftp-server=y # SFTP 服务器
CONFIG_PACKAGE_luci-ssl-openssl=y # LuCI 的 HTTPS 支持 (使用 OpenSSL)

# 其他基础系统工具
CONFIG_PACKAGE_coremark=y # 性能测试工具
CONFIG_PACKAGE_coreutils=y # GNU core utilities (OpenClash 依赖)
CONFIG_PACKAGE_jshn=y # JSON 解析工具
CONFIG_PACKAGE_libjson-script=y # JSON 脚本库
CONFIG_PACKAGE_openssl-util=y # OpenSSL 工具集

# ==============================================================================
# 内核模块 (已包含在相关功能部分，此处列出一些常见的或重要的)
# ==============================================================================

# 文件系统模块 (根据需要添加，如 ext4, ntfs 等)
# CONFIG_PACKAGE_kmod-fs-ext4=y
# CONFIG_PACKAGE_kmod-fs-ntfs=y

# USB 支持模块 (已包含打印机模块，此处列出基础模块)
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y # USB 1.1
CONFIG_PACKAGE_kmod-usb-ehci=y # USB 2.0
CONFIG_PACKAGE_kmod-usb2=y # USB 2.0 支持
# CONFIG_PACKAGE_kmod-usb3=y # USB 3.0 支持 (如果硬件支持且需要)

# 网络过滤模块 (Firewall4 使用 nftables，这些 iptables 模块通常不需要)
# CONFIG_PACKAGE_iptables-mod-filter=y
# CONFIG_PACKAGE_kmod-ipt-filter=y
# CONFIG_PACKAGE_kmod-ipt-ipset=y # ipset 内核模块 (ipset 工具依赖)

# ==============================================================================
# 调试选项 (通常不需要在最终固件中启用)
# ==============================================================================
# CONFIG_DEBUG=y
# CONFIG_KERNEL_DEBUG=y

# ==============================================================================
# 保存和退出时，make menuconfig 会自动添加或删除依赖项和冲突项
# 请在生成此文件后，运行 make defconfig && make menuconfig 检查和调整
# ==============================================================================
