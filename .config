# OpenWrt Configuration - Highly Optimized for Newifi D2 (Official Source)
# Target Features: OpenClash, Firewall, Dnsmasq Full, USB Print (p910nd), Overlay, Disk Mgmt (partexp+diskman), Samba4, UPnP, TurboACC (Offload), IPv6
# WARNING: USB Overlay (EXT4) is MANDATORY due to firmware size exceeding 32MB flash!

#============================================================================
# Target System (目标系统)
#============================================================================
CONFIG_TARGET_ramips=y                          # 目标架构: ramips
CONFIG_TARGET_ramips_mt7621=y                   # 子目标 SoC: mt7621
CONFIG_TARGET_ramips_mt7621_DEVICE_newifi_d2=y  # 【重要】设备 Profile: Newifi D2 (官方名通常用下划线, 请在 menuconfig 中仔细核对!)

#============================================================================
# Base System & Essential Tools (基础系统与必要工具 - 精简优化)
#============================================================================
CONFIG_PACKAGE_base-files=y                     # 基础文件系统结构
CONFIG_PACKAGE_busybox=y                        # 核心 Linux 工具集
CONFIG_PACKAGE_ca-bundle=y                      # SSL 证书包
CONFIG_PACKAGE_ca-certificates=y                # 证书管理工具
CONFIG_PACKAGE_dropbear=y                       # 轻量级 SSH 服务器
CONFIG_PACKAGE_firewall4=y                      # 防火墙后端 (Nftables - Default for OpenWrt 22.03+)
CONFIG_PACKAGE_fstools=y                        # 文件系统挂载/管理工具
CONFIG_PACKAGE_fwtool=y                         # 固件处理工具
CONFIG_PACKAGE_getrandom=y                      # getrandom 系统调用接口
CONFIG_PACKAGE_iptables-nft=y                   # iptables 命令兼容层 (重要依赖 for ipset/OpenClash)
CONFIG_PACKAGE_ipset=y                          # IP 地址集合管理 (重要依赖 for OpenClash/Dnsmasq)
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y       # GPIO 按键热插拔内核模块
CONFIG_PACKAGE_kmod-leds-gpio=y                 # GPIO 控制 LED 内核模块
CONFIG_PACKAGE_kmod-nft-core=y                  # Nftables 核心内核模块
CONFIG_PACKAGE_kmod-nf-reject=y                 # Nftables REJECT 目标 (IPv4)
CONFIG_PACKAGE_kmod-nf-reject6=y                # Nftables REJECT 目标 (IPv6)
CONFIG_PACKAGE_libc=y                           # 标准 C 库
CONFIG_PACKAGE_libgcc=y                         # GCC 运行时库
CONFIG_PACKAGE_libpthread=y                     # POSIX 线程库
CONFIG_PACKAGE_librt=y                          # 实时库
CONFIG_PACKAGE_libstdcpp=y                      # 标准 C++ 库
CONFIG_PACKAGE_libopenssl=y                     # OpenSSL 核心库
CONFIG_PACKAGE_libustream-openssl=y             # ustream SSL/TLS 库 (使用 OpenSSL)
CONFIG_PACKAGE_libyaml=y                        # YAML 解析库 (OpenClash 依赖)
CONFIG_PACKAGE_logd=y                           # 系统日志守护进程
CONFIG_PACKAGE_mtd=y                            # MTD (闪存设备) 工具
CONFIG_PACKAGE_netifd=y                         # 网络接口守护进程
CONFIG_PACKAGE_opkg=y                           # 包管理器
CONFIG_PACKAGE_procd=y                          # 进程管理守护进程
CONFIG_PACKAGE_procd-ujail=y                    # Procd 沙箱支持
CONFIG_PACKAGE_uci=y                            # 统一配置接口
CONFIG_PACKAGE_ubus=y                           # 微型总线系统
CONFIG_PACKAGE_ubusd=y                          # ubus 守护进程
CONFIG_PACKAGE_uclient-fetch=y                  # URL 传输客户端
CONFIG_PACKAGE_urandom-seed=y                   # 随机数种子管理
CONFIG_PACKAGE_usign=y                          # 签名验证工具
CONFIG_PACKAGE_libcap=y                         # libcap 库 (OpenClash 依赖)
# CONFIG_PACKAGE_libcap-bin is not set            #【优化】移除 libcap 工具以减小体积
CONFIG_PACKAGE_ruby=y                           # Ruby 解释器 (OpenClash 依赖)
CONFIG_PACKAGE_ruby-yaml=y                      # Ruby YAML 库 (OpenClash 依赖)

#============================================================================
# LuCI (Web Interface - Default Theme & Core Modules)
#============================================================================
CONFIG_PACKAGE_luci=y                           # LuCI 元包
CONFIG_PACKAGE_luci-base=y                      # LuCI 基础文件
CONFIG_PACKAGE_luci-mod-admin-full=y            # LuCI 完整管理界面 (含系统概览, 挂载点, 系统控制等)
CONFIG_PACKAGE_luci-theme-bootstrap=y           # LuCI 默认 Bootstrap 主题
CONFIG_LUCI_LANG_zh_Hans=y                      # LuCI 简体中文语言包
CONFIG_PACKAGE_luci-compat=y                    # LuCI 兼容包

#============================================================================
# Feature Packages - As Requested & Optimized
#============================================================================

# 1. Shutdown/Reboot (关机/重启 - LuCI)
CONFIG_PACKAGE_luci-app-shutdown=y

# 2. USB Printer (轻量级 p910nd - 资源优化)
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y                      # EHCI for MT7621
CONFIG_PACKAGE_kmod-usb3=y                      # XHCI for MT7621
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y                         # 轻量级打印服务器后台
CONFIG_PACKAGE_luci-app-p910nd=y                # p910nd 的 LuCI 界面

# 3. USB Overlay (ext4), Partition Expansion & Disk Management
CONFIG_PACKAGE_block-mount=y                    # Overlay & 挂载管理必需
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y                   # EXT4 文件系统支持
CONFIG_PACKAGE_e2fsprogs=y                      # EXT4 工具 (含 mkfs, fsck, resize2fs)
CONFIG_PACKAGE_parted=y                         # 分区工具 (依赖)
CONFIG_PACKAGE_lsblk=y                          # 列出块设备工具 (依赖)
CONFIG_PACKAGE_luci-app-partexp=y               # 【请求】一键分区扩容工具 LuCI 界面
CONFIG_PACKAGE_luci-app-diskman=y               # 【请求】通用磁盘管理 LuCI 界面

# 4. Network Acceleration (TurboACC with Flow Offloading)
CONFIG_PACKAGE_luci-app-turboacc=y              # TurboACC LuCI 界面
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y # 启用 Flow Offloading 集成 (推荐)
CONFIG_PACKAGE_kmod-nft-offload=y               # Nftables Flow Offloading 内核模块 (硬件加速)
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set #【检查】确保冲突的 SFE 未选择

# 5. File Management (LuCI File Transfer & Samba 4 Network Share)
CONFIG_PACKAGE_luci-app-filetransfer=y          # 简单的 LuCI 文件上传/下载
CONFIG_PACKAGE_luci-app-samba4=y                # Samba 4 LuCI 界面
CONFIG_PACKAGE_samba4-server=y                  # Samba 4 服务器

# 6. Scientific Internet Access (OpenClash)
CONFIG_PACKAGE_luci-app-openclash=y             # OpenClash LuCI App (来自 kenzo/small feed)
CONFIG_PACKAGE_coreutils-nohup=y                # nohup 命令
CONFIG_PACKAGE_bash=y                           # Bash shell
CONFIG_PACKAGE_curl=y                           # Curl utility
CONFIG_PACKAGE_dnsmasq-full=y                   # Dnsmasq Full (含 ipset 支持 - 推荐)
# CONFIG_PACKAGE_dnsmasq is not set               #【重要】明确禁用基础版 dnsmasq 避免冲突
# Optional kernel modules depending on OpenClash mode (add if needed):
# CONFIG_PACKAGE_kmod-tun=y
# CONFIG_PACKAGE_kmod-ipt-tproxy=y

# 7. IPv6 Support
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y
CONFIG_PACKAGE_odhcp6c=y                        # IPv6 DHCP Client
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y             # IPv6 Connection Tracking
CONFIG_PACKAGE_kmod-nft-nat6=y                  # IPv6 NAT for NFTables
CONFIG_PACKAGE_dnsmasq-full_dhcpv6=y            # Enable DHCPv6 in Dnsmasq-full

#============================================================================
# Wireless Drivers (Official Open Source mt76)
#============================================================================
CONFIG_PACKAGE_kmod-mt76=y                      # mt76 开源驱动元包 (包含 mt7603, mt76x2)
#   【重要】确保禁用冲突的驱动模块 (覆盖可能存在的默认值)
# CONFIG_PACKAGE_kmod-mt7603e is not set
# CONFIG_PACKAGE_kmod-mt76x2e is not set
# CONFIG_PACKAGE_mt_wifi is not set
# CONFIG_PACKAGE_luci-app-mtwifi is not set

#============================================================================
# Other Required LuCI Applications
#============================================================================
CONFIG_PACKAGE_luci-app-firewall=y              # 防火墙 LuCI 界面 (Firewall4)
CONFIG_PACKAGE_luci-app-opkg=y                  # 软件包管理 LuCI 界面
CONFIG_PACKAGE_luci-app-upnp=y                  # UPnP LuCI 界面
CONFIG_PACKAGE_miniupnpd=y                      # UPnP 后台服务
CONFIG_PACKAGE_luci-app-ramfree=y               # 释放内存 LuCI 界面

#============================================================================
# Utilities (Basic Essentials - Optimized)
#============================================================================
CONFIG_PACKAGE_htop=y                           # 进程查看器
CONFIG_PACKAGE_nano=y                           # 轻量级文本编辑器
CONFIG_PACKAGE_usbutils=y                       # USB 工具 (lsusb)

#============================================================================
# Build Options for Size Optimization
#============================================================================
CONFIG_STRIP_KERNEL_EXPORTS=y                   # 精简内核导出符号
CONFIG_USE_SSTRIP=y                             # 使用 sstrip 精简可执行文件和库
# CONFIG_PACKAGE_kmod-ikconfig is not set         # 移除内核配置导出模块
CONFIG_KERNEL_DEBUG_INFO=n                      # 禁用内核调试信息以减小体积

#============================================================================
# Final Safeguards - Explicitly disable known conflicting defaults
#============================================================================
# CONFIG_DEFAULT_kmod-mt7603e is not set        # 覆盖可能的闭源驱动默认值
# CONFIG_DEFAULT_kmod-mt76x2e is not set        # 覆盖可能的闭源驱动默认值
# CONFIG_DEFAULT_luci-app-mtwifi is not set     # 覆盖可能的闭源驱动 LuCI 默认值
# CONFIG_DEFAULT_firewall is not set            # 确保不默认使用旧 firewall
#============================================================================

# End of Configuration
