# ==================================================
# 目标系统配置 (Target System)
# 平台: MediaTek Ralink MIPS (ramips)
# 子目标: MT7621 based boards
# 设备型号: Newifi D2 (newifi3)
# ==================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ==================================================
# 目标镜像格式 (Target Images)
# 确保生成 SquashFS 格式的 sysupgrade 镜像
# ==================================================
CONFIG_TARGET_IMAGES_SQUASHFS=y   # 启用 SquashFS 文件系统格式 (用于 sysupgrade)
# CONFIG_TARGET_IMAGES_GZIP is not set # 使用默认压缩
# CONFIG_TARGET_IMAGES_INITRAMFS=n # 不需要 initramfs

# ==================================================
# 基本系统组件 (Base System)
# 核心运行库、驱动和基础工具
# ==================================================
CONFIG_PACKAGE_block-mount=y           # 块设备挂载 (挂载点管理)
CONFIG_PACKAGE_ca-certificates=y       # SSL 证书 (HTTPS 连接所需)
CONFIG_PACKAGE_coreutils=y             # 核心 GNU 工具集
CONFIG_PACKAGE_coreutils-nohup=y       # nohup 命令 (OpenClash 需要)
CONFIG_PACKAGE_dropbear=y              # SSH 服务器
CONFIG_PACKAGE_firewall4=y             # nftables 防火墙 (OpenWrt 22.03+)
CONFIG_PACKAGE_fstools=y               # 文件系统工具 (含 blkid)
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y # GPIO 按键支持
CONFIG_PACKAGE_kmod-leds-gpio=y        # GPIO LED 支持
CONFIG_PACKAGE_kmod-mt7603=y           # 2.4GHz WiFi 驱动
CONFIG_PACKAGE_kmod-mt76x2=y           # 5GHz WiFi 驱动
# CONFIG_PACKAGE_logd is not set       # 使用 BusyBox 内建日志，省空间
CONFIG_PACKAGE_mtd=y                   # Flash 读写工具
CONFIG_PACKAGE_netifd=y                # 网络接口管理守护进程
CONFIG_PACKAGE_odhcp6c=y               # IPv6 客户端 (DHCPv6/SLAAC)
CONFIG_PACKAGE_odhcpd-ipv6only=y       # IPv6 RA/DHCPv6 服务器 (内网 IPv6)
CONFIG_PACKAGE_opkg=y                  # OpenWrt 包管理器
CONFIG_PACKAGE_ppp=y                   # PPPoE 基础
CONFIG_PACKAGE_kmod-ppp=y              # PPPoE 内核模块
CONFIG_PACKAGE_ppp-mod-pppoe=y         # PPPoE 协议支持
CONFIG_PACKAGE_rpcd=y                  # LuCI RPC 后端
CONFIG_PACKAGE_rpcd-mod-file=y         # RPC 文件模块
CONFIG_PACKAGE_rpcd-mod-iwinfo=y       # RPC 无线模块
CONFIG_PACKAGE_rpcd-mod-luci=y         # RPC LuCI 模块
CONFIG_PACKAGE_rpcd-mod-rrdns=y        # RPC RRDNS 模块 (状态图)
CONFIG_PACKAGE_rpcd-mod-ucode=y        # RPC ucode 模块
CONFIG_PACKAGE_ucode=y                 # ucode 解释器 (新 LuCI 基础)
CONFIG_PACKAGE_ucode-mod-fs=y          # ucode 文件系统模块
CONFIG_PACKAGE_ucode-mod-html=y        # ucode HTML 模块
CONFIG_PACKAGE_ucode-mod-http=y        # ucode HTTP 模块
CONFIG_PACKAGE_ucode-mod-math=y        # ucode 数学模块
CONFIG_PACKAGE_ucode-mod-process=y     # ucode 进程模块
CONFIG_PACKAGE_ucode-mod-uci=y         # ucode UCI 配置模块
CONFIG_PACKAGE_uci=y                   # UCI 命令行工具
CONFIG_PACKAGE_uclient-fetch=y         # 轻量 URL 下载工具
CONFIG_PACKAGE_urandom-seed=y          # 随机数种子
CONFIG_PACKAGE_urngd=y                 # 硬件随机数生成器

# ==================================================
# 无线网络安全 (Wireless Security)
# 平衡功能与体积
# ==================================================
CONFIG_PACKAGE_wpad-basic-mbedtls=y     # 使用 mbedtls 库的 wpad (体积适中)
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-mini is not set

# ==================================================
# DHCP 和 DNS 服务器
# **关键**: 确保选择 dnsmasq-full 并避免冲突
# ==================================================
# CONFIG_PACKAGE_dnsmasq is not set     # **禁用** 默认 dnsmasq/dnsmasq-base
# CONFIG_PACKAGE_dnsmasq-base is not set # **禁用** 默认 dnsmasq/dnsmasq-base (以防万一)
CONFIG_PACKAGE_dnsmasq-full=y         # **启用** 完整版 (OpenClash 需要)
CONFIG_PACKAGE_libnetfilter-conntrack=y # dnsmasq-full 依赖
CONFIG_PACKAGE_libnettle=y            # dnsmasq-full 依赖

# ==================================================
# LuCI Web 用户界面 (Web User Interface)
# 核心模块 + 请求的应用 + **中文支持**
# ==================================================
CONFIG_PACKAGE_luci=y                    # LuCI 元包
CONFIG_PACKAGE_luci-base=y               # LuCI 基础
CONFIG_PACKAGE_luci-compat=y             # LuCI 兼容层
# --- LuCI 核心模块 ---
CONFIG_PACKAGE_luci-mod-admin-full=y     # 完整管理菜单
CONFIG_PACKAGE_luci-mod-network=y        # 网络菜单
CONFIG_PACKAGE_luci-mod-status=y         # 状态菜单 (含**系统概览**)
CONFIG_PACKAGE_luci-mod-system=y         # 系统菜单 (含**挂载点**)
# --- LuCI 协议支持 ---
CONFIG_PACKAGE_luci-proto-ipv6=y         # IPv6 配置支持
CONFIG_PACKAGE_luci-proto-ppp=y          # PPPoE 配置支持
# --- LuCI 核心应用 ---
CONFIG_PACKAGE_luci-app-firewall=y       # **防火墙** LuCI 界面
CONFIG_PACKAGE_luci-app-opkg=y           # 软件包管理 LuCI 界面
# --- 用户指定的 LuCI 应用 ---
CONFIG_PACKAGE_luci-app-openclash=y      # **OpenClash** LuCI 界面
CONFIG_PACKAGE_luci-app-partexp=y        # **一键分区扩容挂载** LuCI 界面
CONFIG_PACKAGE_luci-app-p910nd=y         # **USB 打印服务器** LuCI 界面
CONFIG_PACKAGE_luci-app-shutdown=y       # **关机** LuCI 选项
CONFIG_PACKAGE_luci-app-turboacc=y       # **Turbo ACC 网络加速** LuCI 界面

# ==================================================
# LuCI 主题 (Theme)
# 默认主题
# ==================================================
CONFIG_PACKAGE_luci-theme-bootstrap=y    # **默认 Bootstrap 主题**

# ==================================================
# LuCI 国际化语言包 (Internationalization - i18n)
# **包含中文语言包 - 这会增加体积**
# ==================================================
CONFIG_LUCI_LANG_zh_Hans=y                # **启用简体中文支持 (元包)**
# --- 为所有已选的 LuCI 模块和应用添加中文翻译 ---
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y         # LuCI 基础中文包
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y     # 防火墙中文包
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y         # 软件包管理中文包
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y    # **OpenClash 中文包**
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y      # **Partexp 中文包**
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y       # **P910nd 中文包**
CONFIG_PACKAGE_luci-i18n-shutdown-zh-cn=y     # **Shutdown 中文包**
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y     # **TurboACC 中文包**
# CONFIG_LUCI_SRCDIET is not set            # 一般启用 i18n 时不建议用 diet, 可能冲突

# ==================================================
# 网络相关工具和库 (Networking Libraries & Utilities)
# OpenClash 和 TurboACC 的依赖
# ==================================================
CONFIG_PACKAGE_curl=y                 # **数据传输工具** (OpenClash 必须)
CONFIG_PACKAGE_ip-full=y              # **完整 'ip' 命令** (策略路由需要)
CONFIG_PACKAGE_ipset=y                # **IP sets 工具** (OpenClash 必须)
CONFIG_PACKAGE_iptables-nft=y         # **iptables 兼容层** (OpenClash 必须)
CONFIG_PACKAGE_libcurl=y              # curl 库
CONFIG_PACKAGE_libipset=y             # ipset 库
CONFIG_PACKAGE_libyaml=y              # **YAML 解析库** (OpenClash 必须)
CONFIG_PACKAGE_libnfnetlink=y         # netfilter netlink 库
CONFIG_PACKAGE_libnftnl=y             # nftables 库
CONFIG_PACKAGE_libnl-tiny=y           # netlink tiny 库
CONFIG_PACKAGE_libpcre=y              # 正则表达式库
CONFIG_PACKAGE_resolveip=y            # 主机名解析工具
CONFIG_PACKAGE_wget-ssl=y             # wget 带 SSL

# ==================================================
# 内核模块 (Kernel Modules)
# 驱动和核心功能
# ==================================================
# --- 网络核心支持 ---
CONFIG_PACKAGE_kmod-ifb=y             # QoS/TurboACC 可能需要
CONFIG_PACKAGE_kmod-ipt-core=y        # iptables 核心模块 (兼容层)
CONFIG_PACKAGE_kmod-ipt-ipset=y       # ipset 内核支持
CONFIG_PACKAGE_kmod-ipt-nat=y         # iptables NAT 模块 (兼容层)
CONFIG_PACKAGE_kmod-ipv6=y            # IPv6 内核支持
CONFIG_PACKAGE_kmod-nf-conntrack=y    # 连接跟踪
CONFIG_PACKAGE_kmod-nf-conntrack6=y   # IPv6 连接跟踪
CONFIG_PACKAGE_kmod-nf-flow=y         # **Flow Offloading 基础** (TurboACC)
CONFIG_PACKAGE_kmod-nf-nat=y          # 内核 NAT
CONFIG_PACKAGE_kmod-nf-reject=y       # 内核 REJECT (防火墙)
CONFIG_PACKAGE_kmod-nf-reject6=y      # IPv6 REJECT
CONFIG_PACKAGE_kmod-nfnetlink=y       # Netfilter Netlink
CONFIG_PACKAGE_kmod-nft-core=y        # nftables 核心
CONFIG_PACKAGE_kmod-nft-nat=y         # nftables NAT
CONFIG_PACKAGE_kmod-nft-offload=y     # **nftables 流量卸载** (TurboACC 硬件加速 for MT7621)
CONFIG_PACKAGE_kmod-sched-core=y      # 内核调度器核心 (QoS/TurboACC)
CONFIG_PACKAGE_kmod-tun=y             # **TUN/TAP 设备驱动** (OpenClash 必须)

# --- USB 支持 ---
CONFIG_PACKAGE_kmod-usb-core=y        # **核心 USB 支持**
CONFIG_PACKAGE_kmod-usb-ehci=y        # **USB 2.0 (EHCI)**
CONFIG_PACKAGE_kmod-usb-ohci=y        # USB 1.1 (OHCI) (兼容性)
CONFIG_PACKAGE_kmod-usb-printer=y     # **USB 打印机驱动**
CONFIG_PACKAGE_kmod-usb-storage=y     # **USB 存储驱动**
CONFIG_PACKAGE_kmod-usb-storage-uas=y # **UAS 协议** (提升性能)
CONFIG_PACKAGE_kmod-usb-uhci=y        # USB 1.1 (UHCI) (兼容性)
CONFIG_PACKAGE_kmod-usb2=y            # EHCI 别名
CONFIG_PACKAGE_kmod-usb3=y            # **USB 3.0 (xHCI)**

# --- 文件系统支持 ---
CONFIG_PACKAGE_kmod-fs-ext4=y         # **EXT4 文件系统**
CONFIG_PACKAGE_kmod-fs-vfat=y         # **VFAT (FAT32) 文件系统**
# CONFIG_PACKAGE_kmod-fs-exfat is not set # 默认不选 exFAT, 节省空间
# CONFIG_PACKAGE_kmod-fs-ntfs3 is not set # 默认不选 NTFS, 节省空间
# --- 文件系统字符集 ---
CONFIG_PACKAGE_kmod-nls-base=y        # NLS 基础
CONFIG_PACKAGE_kmod-nls-cp437=y       # NLS 代码页 437
CONFIG_PACKAGE_kmod-nls-iso8859-1=y   # NLS 代码页 ISO8859-1
CONFIG_PACKAGE_kmod-nls-utf8=y        # **NLS UTF-8** (推荐)

# ==================================================
# 必要的共享库 (Libraries)
# 多数为依赖项
# ==================================================
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libblkid=y              # 块设备 ID 库
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libext2fs=y             # EXT2/3/4 库
CONFIG_PACKAGE_libfdisk=y              # fdisk 库
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libgmp=y                # 大数运算库
CONFIG_PACKAGE_libiwinfo=y             # 无线信息库
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_libjson-c=y             # JSON 库
CONFIG_PACKAGE_liblua=y                # Lua 库
CONFIG_PACKAGE_liblucihttp=y           # LuCI HTTP 库
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_libmbedtls=y            # mbedTLS 库
CONFIG_PACKAGE_libmnl=y                # minimal netlink 库
CONFIG_PACKAGE_libncurses=y            # Ncurses 库
CONFIG_PACKAGE_libopenssl=y            # OpenSSL 库
CONFIG_PACKAGE_libparted=y             # parted 库
CONFIG_PACKAGE_libpthread=y            # Posix 线程库
CONFIG_PACKAGE_librt=y                 # Posix 实时库
CONFIG_PACKAGE_libsmartcols=y          # Smart columns 库
CONFIG_PACKAGE_libss=y                 # e2fsprogs 库
CONFIG_PACKAGE_libubox=y               # OpenWrt 基础库
CONFIG_PACKAGE_libubus=y               # OpenWrt IPC 库
CONFIG_PACKAGE_libuci=y                # OpenWrt 配置库
CONFIG_PACKAGE_libuclient=y            # uclient 库
CONFIG_PACKAGE_libucode=y
CONFIG_PACKAGE_libuuid=y               # UUID 库
CONFIG_PACKAGE_libz=y                  # zlib 库别名
CONFIG_PACKAGE_zlib=y                  # zlib 压缩库

# ==================================================
# 实用工具 (Utilities)
# 磁盘管理、打印等
# ==================================================
CONFIG_PACKAGE_e2fsprogs=y            # **EXT2/3/4 文件系统工具** (格式化/检查)
CONFIG_PACKAGE_fdisk=y                # **MBR 分区工具** (partexp 依赖)
# CONFIG_PACKAGE_htop=n               # 不选 htop 节省空间
CONFIG_PACKAGE_iputils-ping=y         # Ping (IPv4)
CONFIG_PACKAGE_iputils-ping6=y        # Ping (IPv6)
CONFIG_PACKAGE_lsblk=y                # **列出块设备** (磁盘管理)
# CONFIG_PACKAGE_nano=n               # 不选 nano 节省空间 (用 vi)
CONFIG_PACKAGE_parted=y               # **GPT/MBR 分区工具** (partexp 依赖)
CONFIG_PACKAGE_p910nd=y               # **打印服务器后台**
CONFIG_PACKAGE_usbutils=y             # **USB 工具 (lsusb)**

# ==================================================
# 构建与内核优化 (Build & Kernel Optimizations)
# 尽可能减小体积，关闭调试
# ==================================================
CONFIG_PACKAGE_kmod-ikconfig=n              # 不包含内核配置信息
CONFIG_STRIP_PACKAGES=y                   # 剥离调试符号
# --- 内核调试选项 (全部禁用) ---
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_DEBUG_INFO is not set       # **禁用内核调试信息，显著减小体积**
# CONFIG_KERNEL_DEBUG_KERNEL is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_PROFILING is not set
# CONFIG_KERNEL_SWAP is not set             # **禁用 Swap**
# CONFIG_PACKAGE_luci-app-ssr-plus is not set # 明确禁用可能引起问题的包 (如果 diy-part1.sh 未移除其 feed)
