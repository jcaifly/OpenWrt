# ==============================================================================
# OpenWrt .config 配置文件 (修正版)
# 适用于 Newifi 3 (D2) 路由器，基于 lede 分支
# 核心功能: OpenClash 和 关机功能 (poweroffdevice)
# 已解决 dnsmasq 和 dnsmasq-full 的冲突
# ==============================================================================

# 1. 基本目标和设备配置
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt721=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# 固件格式和压缩
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ==============================================================================
# 2. 基础网络配置
# ==============================================================================

# IPv6 支持
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# Firewall4 (nftables)
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-nft-fullcone=y

# DNS & DHCP (使用 dnsmasq-full 并禁用 dnsmasq)
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y # 为 dnsmasq-full 添加 IPv6 DHCP 支持
CONFIG_PACKAGE_dnsmasq_full_ipset=y # 为 dnsmasq-full 添加 ipset 支持，对 OpenClash 有益

# ==============================================================================
# 3. LuCI 网页界面
# ==============================================================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 中文语言包
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ==============================================================================
# 4. 添加的核心应用
# ==============================================================================

# 关机功能 (poweroffdevice)
CONFIG_PACKAGE_luci-app-poweroffdevice=y
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y

# OpenClash
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y

# OpenClash 的核心依赖项
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y

# ==============================================================================
# 5. 系统核心组件和驱动
# ==============================================================================

# Newifi 3 (D2) 无线驱动
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y

# USB 支持 (基础模块)
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb2=y
# CONFIG_PACKAGE_kmod-usb3=y

# ==============================================================================
# 最终说明
# ==============================================================================
