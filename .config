#
# 基本系统配置 (Base System Configuration)
#
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

#
# 固件格式 (Firmware Format)
#
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

#
# LuCI 界面与翻译 (LuCI Interface and Translations)
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y # 默认主题 (Default theme)
# CONFIG_PACKAGE_luci-theme-argon is not set # 确保未选择其他主题 (Ensure no other theme is selected)
# CONFIG_PACKAGE_luci-theme-material is not set
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # LuCI 基础中文翻译 (Base Chinese translation)
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y # opkg 中文翻译 (opkg Chinese translation)

#
# 网络相关 (Networking)
#
CONFIG_PACKAGE_firewall=y # 防火墙 (Firewall)
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_ip6tables=y # IPv6 防火墙支持 (IPv6 firewall support)
CONFIG_PACKAGE_ip6tables-mod-nat=y # IPv6 NAT 支持 (IPv6 NAT support)
CONFIG_PACKAGE_kmod-ipt-ipset=y # ipset 内核模块 (ipset kernel module for dnsmasq)
CONFIG_PACKAGE_ipset=y # ipset 工具 (ipset utility)
CONFIG_PACKAGE_ip-full=y # 完整版 iproute2 (Full iproute2)

#
# DNS 服务 (DNS Service) - 使用 Dnsmasq Full
#
# CONFIG_PACKAGE_dnsmasq is not set # 禁用基础版 dnsmasq (Disable base dnsmasq)
CONFIG_PACKAGE_dnsmasq-full=y # 启用完整版 dnsmasq (Enable full dnsmasq)
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
# CONFIG_PACKAGE_dnsmasq_full_tftp=y # TFTP 通常不需要，除非有特定需求 (TFTP usually not needed unless specifically required)

#
# IPv6 支持 (IPv6 Support)
#
CONFIG_KERNEL_IPV6=y
CONFIG_KERNEL_IPV6_MULTIPLE_TABLES=y
CONFIG_KERNEL_IPV6_SUBTREES=y
CONFIG_KERNEL_IPV6_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE_MULTIPLE_TABLES=y
CONFIG_KERNEL_IPV6_PIMSM_V2=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y # 用于获取 IPv6 地址和前缀 (For obtaining IPv6 address and prefix)
CONFIG_PACKAGE_odhcpd-ipv6only=y # 用于响应 RA 和 DHCPv6 请求 (For responding to RA and DHCPv6 requests)
CONFIG_PACKAGE_luci-proto-ipv6=y # LuCI IPv6 协议支持 (LuCI IPv6 protocol support)

#
# 无线驱动与配置 (Wireless Drivers and Configuration)
#
CONFIG_PACKAGE_kmod-mt7603e=y # 2.4 GHz 无线驱动 (2.4 GHz Wi-Fi driver)
CONFIG_PACKAGE_kmod-mt76x2e=y # 5 GHz 无线驱动 (5 GHz Wi-Fi driver)
# CONFIG_PACKAGE_wpad-basic-openssl is not set # 禁用基础 wpad (Disable basic wpad)
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
CONFIG_PACKAGE_wpad-openssl=y # 使用 OpenSSL 的完整 wpad (Use full wpad with OpenSSL for WPA3 etc.)
CONFIG_PACKAGE_hostapd-common=y # hostapd 依赖 (hostapd dependency)
CONFIG_PACKAGE_wireless-regdb=y # 无线区域数据库 (Wireless regulatory database)

#
# USB 支持 (USB Support)
#
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y # Newifi 3 有 USB 3.0 接口 (Newifi 3 has USB 3.0)
CONFIG_PACKAGE_kmod-usb-storage=y # USB 存储支持 (USB storage support)
CONFIG_PACKAGE_kmod-usb-storage-extras=y # 额外的 USB 存储驱动 (Extra USB storage drivers)
CONFIG_PACKAGE_kmod-usb-printer=y # USB 打印机支持 (USB printer support)
CONFIG_PACKAGE_block-mount=y # 挂载块设备 (Mount block devices)

#
# USB 打印服务器 (USB Print Server)
#
CONFIG_PACKAGE_p910nd=y # 打印服务器守护进程 (Print server daemon)
CONFIG_PACKAGE_luci-app-p910nd=y # LuCI 打印服务器界面 (LuCI print server interface)
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y # LuCI 打印服务器中文翻译 (LuCI print server Chinese translation)

#
# OpenClash 及其依赖 (OpenClash and its Dependencies)
#
CONFIG_PACKAGE_luci-app-openclash=y # OpenClash LuCI 界面 (OpenClash LuCI interface)
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y # OpenClash 中文翻译 (OpenClash Chinese translation)
CONFIG_PACKAGE_coreutils-nohup=y # OpenClash 依赖 (OpenClash dependency)
CONFIG_PACKAGE_bash=y # OpenClash 依赖 (OpenClash dependency)
CONFIG_PACKAGE_curl=y # OpenClash 依赖 (OpenClash dependency)
CONFIG_PACKAGE_ca-certificates=y # OpenClash 依赖 (OpenClash dependency)
CONFIG_PACKAGE_libcap=y # OpenClash 依赖 (OpenClash dependency)
CONFIG_PACKAGE_libcap-bin=y # OpenClash 依赖 (OpenClash dependency)
CONFIG_PACKAGE_ruby=y # OpenClash 依赖 (OpenClash dependency)
CONFIG_PACKAGE_kmod-tun=y # TUN/TAP 虚拟网络设备 (TUN/TAP virtual network device for OpenClash)
# tcpdump is useful for debugging but not strictly required
# CONFIG_PACKAGE_tcpdump=y

#
# 关机功能 (Shutdown Function)
#
CONFIG_PACKAGE_luci-app-poweroffdevice=y # 关机 LuCI 界面 (Shutdown LuCI interface)
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y # 关机功能中文翻译 (Shutdown function Chinese translation)
CONFIG_PACKAGE_coreutils-poweroff=y # 关机命令依赖 (Shutdown command dependency)

#
# Turbo ACC 网络加速 (Turbo ACC Network Acceleration)
#
CONFIG_PACKAGE_luci-app-turboacc=y # Turbo ACC LuCI 界面 (Turbo ACC LuCI interface)
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y # Turbo ACC 中文翻译 (Turbo ACC Chinese translation)
# luci-app-turboacc 会自动选择并依赖所需的内核模块 (e.g., kmod-ipt-offload, shortcut-fe, kmod-mtk-hnat)
# The luci-app-turboacc package will automatically select and depend on necessary kernel modules
CONFIG_PACKAGE_kmod-tcp-bbr=y # TCP BBR 拥塞控制算法 (TCP BBR congestion control algorithm)

#
# 常用工具与库 (Utilities and Libraries)
#
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_htop=y # 进程查看器 (Process viewer)
CONFIG_PACKAGE_ttyd=y # 网页终端 (Web terminal)
CONFIG_PACKAGE_luci-app-ttyd=y # LuCI ttyd 界面 (LuCI ttyd interface)
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y # LuCI ttyd 中文翻译 (LuCI ttyd Chinese translation)
CONFIG_PACKAGE_openssh-sftp-server=y # SFTP 服务器 (SFTP server)
CONFIG_PACKAGE_coreutils=y # 核心工具集 (Core utilities)
CONFIG_PACKAGE_zoneinfo-asia=y # 亚洲时区 (Asia timezone)
CONFIG_PACKAGE_libustream-openssl=y # 使用 OpenSSL 的 ustream 库 (ustream library with OpenSSL)
CONFIG_PACKAGE_liblucihttp=y # LuCI HTTP 库 (LuCI HTTP library)
CONFIG_PACKAGE_liblucihttp-ucode=y # LuCI HTTP ucode 绑定 (LuCI HTTP ucode binding)

#
# 编译优化与设置 (Build Optimizations and Settings)
#
CONFIG_STRIP_KERNEL_EXPORTS=y
# CONFIG_USE_MKLIBS is not set
CONFIG_SIGNATURE_CHECK=y

#
# 内核模块 -> 网络支持 (Kernel modules -> Network Support)
#
CONFIG_PACKAGE_kmod-nf-nat6=y # IPv6 NAT 内核支持 (IPv6 NAT kernel support)
# Flow Offloading 相关内核模块通常由 luci-app-turboacc 自动依赖选择
# Flow Offloading related kernel modules are usually selected automatically as dependencies by luci-app-turboacc

#
# 确保其他不必要的包未被选中 (Ensure other unnecessary packages are not selected)
# 例如，如果默认选中了其他主题或冲突包，可以在此显式禁用
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_dnsmasq is not set
