# OpenWrt 配置文件 - 适用于 D-Team Newifi D2 (newifi3)
# 目标平台: ramips/mt7621
# 软件源: kenzok8/openwrt-packages, kenzok8/small (已在 feeds.conf.default 中指定)
# 核心功能: 关机, 打印机, USB Overlay(Extroot/EXT4), 网络加速, 文件管理, OpenClash

# 重要提示: Newifi D2 闪存仅 32MB。此配置功能较多，可能接近或超过空间限制。
# 强烈建议首次刷机后立即配置 USB Extroot (Overlay 扩展)。

# ======================================================
# 目标系统选择 (必需)
# ======================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ======================================================
# 基础系统与 LuCI (必需)
# ======================================================
CONFIG_PACKAGE_luci=y                    # LuCI Web 界面元包
CONFIG_PACKAGE_luci-base=y               # LuCI 核心库
CONFIG_PACKAGE_luci-mod-admin-full=y     # 完整的 LuCI 管理界面功能
CONFIG_LUCI_LANG_zh_Hans=y               # LuCI 简体中文语言包
CONFIG_PACKAGE_luci-theme-bootstrap=y    # LuCI 默认主题 (可选其他主题如 luci-theme-argon)
CONFIG_PACKAGE_luci-app-opkg=y           # LuCI 在线软件包管理
CONFIG_PACKAGE_luci-app-firewall=y       # LuCI 防火墙界面
CONFIG_PACKAGE_dnsmasq-full=y            # DNS 缓存与 DHCP 服务器
CONFIG_PACKAGE_ipv6helper=y              # IPv6 相关支持
CONFIG_PACKAGE_luci-proto-ipv6=y         # LuCI IPv6 协议配置支持

# ======================================================
# 无线驱动 (必需)
# ======================================================
CONFIG_PACKAGE_kmod-mt7603=y             # 2.4GHz 无线驱动 (MT7603E)
CONFIG_PACKAGE_kmod-mt76x2e=y            # 5GHz 无线驱动 (通常为 MT7612E)

# ======================================================
# 功能 1: 系统关机支持
# ======================================================
CONFIG_PACKAGE_poweroff=y                # 提供 'poweroff' 命令
CONFIG_PACKAGE_luci-app-poweroff=y       # LuCI 关机/重启界面

# ======================================================
# 功能 2: USB 打印机支持
# ======================================================
CONFIG_PACKAGE_kmod-usb-printer=y        # USB 打印机内核模块
CONFIG_PACKAGE_p910nd=y                  # 轻量级网络打印服务器 (端口 9100)
CONFIG_PACKAGE_luci-app-usb-printer=y    # LuCI 打印服务器配置界面

# ======================================================
# 功能 3: 插 U盘扩展 Overlay (Extroot, U盘为 EXT4 格式)
# ======================================================
# --- USB 核心与存储驱动 ---
CONFIG_PACKAGE_kmod-usb-core=y           # USB 核心支持
CONFIG_PACKAGE_kmod-usb2=y               # USB 2.0 支持
CONFIG_PACKAGE_kmod-usb3=y               # USB 3.0 支持
CONFIG_PACKAGE_kmod-usb-storage=y        # USB 存储设备驱动
CONFIG_PACKAGE_kmod-usb-storage-uas=y    # UAS 驱动 (提高 USB 3.0 性能)
# --- 文件系统支持 (EXT4 必需) ---
CONFIG_PACKAGE_kmod-fs-ext4=y            # EXT4 文件系统内核模块
# --- 挂载与分区/格式化工具 ---
CONFIG_PACKAGE_block-mount=y             # OpenWrt 标准块设备挂载管理
CONFIG_PACKAGE_e2fsprogs=y               # EXT2/3/4 文件系统工具 (mkfs.ext4, fsck)
CONFIG_PACKAGE_fdisk=y                   # 磁盘分区工具 (建议包含)
CONFIG_PACKAGE_lsblk=y                   # 列出块设备信息
# --- 字符集支持 (推荐包含 UTF-8) ---
CONFIG_PACKAGE_kmod-nls-base=y           # 基础 NLS (字符集) 支持
CONFIG_PACKAGE_kmod-nls-utf8=y           # UTF-8 字符集支持

# ======================================================
# 功能 4: 网络加速 (使用 kenzok8 源的 TurboACC)
# ======================================================
CONFIG_PACKAGE_luci-app-turboacc=y       # TurboACC 网络加速 LuCI 界面及核心
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y # 包含 BBR 拥塞控制算法
CONFIG_PACKAGE_TURBOACC_INCLUDE_SHORTCUT_FE=y # 包含 Shortcut-FE (流分载/Fast Path)
# 硬件加速注意: MT7621 支持硬件 NAT。需确认 TurboACC 是否自动启用或需要额外配置内核模块(如 kmod-ipt-offload) 以利用硬件加速。
CONFIG_PACKAGE_TURBOACC_INCLUDE_DNSFORWARDER=y # 包含内置的 DNS 转发器/缓存 (注意可能与 OpenClash 的 DNS 设置交互)

# ======================================================
# 功能 5: 文件管理
# ======================================================
CONFIG_PACKAGE_luci-app-filetransfer=y   # LuCI 文件传输界面 (基础上传/下载)
# 如需更强大的网络共享 (如 Windows 共享)，可考虑添加 CONFIG_PACKAGE_luci-app-samba4=y，但会显著增加固件体积。

# ======================================================
# 功能 6: 科学上网 (使用 kenzok8 源的 OpenClash)
# ======================================================
CONFIG_PACKAGE_luci-app-openclash=y
# 注意: 此包会依赖并引入 Clash 核心 (如 clash-meta) 及 GeoIP/GeoSite 数据。
# OpenClash 功能复杂，会占用较多 CPU 和内存资源，并可能增加固件体积。
# 运行时请注意与 TurboACC (特别是 DNS 和流分载) 的配置协调。

# ======================================================
# 其他实用工具 (可选)
# ======================================================
# CONFIG_PACKAGE_htop=y                  # 交互式进程查看器
# CONFIG_PACKAGE_wget-ssl=y              # 带 SSL 支持的 wget
# CONFIG_PACKAGE_curl=y                  # 强大的数据传输工具

# ======================================================
# 配置文件结束
# ======================================================
