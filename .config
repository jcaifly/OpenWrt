# ==========================================================
# 1. 硬件目标 (Newifi 3 D2 / MT7621)
# ==========================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ==========================================================
# 2. 固件格式与空间优化
# ==========================================================
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
# 禁用 EXT4 格式 (Newifi D2 闪存只有 32M，节省空间)
# CONFIG_TARGET_ROOTFS_EXT4 is not set

# ==========================================================
# 3. 网络设置 (移除 IPv6，仅保留 IPv4)
# ==========================================================
# 禁用 IPv6
# CONFIG_IPV6 is not set
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set

# 基础协议支持
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ==========================================================
# 4. USB 基础支持 (保留挂载能力)
# ==========================================================
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y
# 移除 Samba 共享 (省空间，如需开启请去掉下面一行的注释)
# CONFIG_PACKAGE_luci-app-samba4=y

# ==========================================================
# 5. LuCI 界面与主题
# ==========================================================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
# 使用 Argon 主题
CONFIG_PACKAGE_luci-theme-argon=y
# 移除默认 Bootstrap 主题以节省空间
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

# ==========================================================
# 6. OpenClash 及其完整依赖 (关键配置)
# ==========================================================
CONFIG_PACKAGE_luci-app-openclash=y

# 核心依赖 (缺一不可，否则 OpenClash 无法启动内核)
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_kmod-inet-diag=y

# DNS 组件：使用 dnsmasq-full 替换默认 dnsmasq
# 这是 OpenClash 防泄漏和分流的关键
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y

# ==========================================================
# 7. 关机插件
# ==========================================================
CONFIG_PACKAGE_luci-app-poweroffdevice=y

# ==========================================================
# 8. 实用工具
# ==========================================================
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_bind-host=y
