# Target System Configuration
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y
CONFIG_TARGET_IMAGES_squashfs=y
CONFIG_TARGET_IMAGES_PAD=y # 通常需要，确保固件大小对齐

# Base system
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y # 建议启用 HTTPS 访问 LuCI
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-app-opkg=y # LuCI 包管理器
CONFIG_PACKAGE_bash=y # OpenClash 需要
CONFIG_PACKAGE_curl=y # OpenClash 等需要
CONFIG_PACKAGE_wget-ssl=y # 备用下载工具
CONFIG_PACKAGE_ca-bundle=y # SSL 证书
CONFIG_PACKAGE_ca-certificates=y # SSL 证书

# Default Theme & Language
CONFIG_PACKAGE_luci-theme-bootstrap=y # 默认主题
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # 基础中文翻译
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y # opkg 中文

# IPv6 Support (通常默认选中部分, 需确认)
CONFIG_IPV6=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y # IPv6 客户端
CONFIG_PACKAGE_odhcpd-ipv6only=y # IPv6 DHCP 服务器 & RA (确保与 dnsmasq-full 协作)

# Firewall (nftables based)
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y # NFTables Flow Offload Support
CONFIG_PACKAGE_iptables-nft=y # 提供 iptables 语法兼容, OpenClash 可能需要
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y # 防火墙中文

# DNSMasq Full Version
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set # 确保标准版 dnsmasq 未被选中

# Network Acceleration (TurboACC & Dependencies)
CONFIG_PACKAGE_luci-app-turboacc=y # 从 diy-part1.sh 添加的源安装
# Kernel Flow Offloading (确保在 Kernel Hacking 或 Networking Support 中启用)
CONFIG_KERNEL_FLOW_OFFLOADING=y
# CONFIG_KERNEL_FLOW_OFFLOADING_HW is not set # MT7621 的硬件 offload 支持有限且可能不稳定，优先用软件 offload
# CONFIG_SHORTCUT_FE is not set # 通常 TurboACC 源会自行处理 SFE/Fast Path 或依赖内核 Offload
# CONFIG_PACKAGE_kmod-fast-classifier=y # SFE 需要，如果 TurboACC 使用 SFE
# CONFIG_PACKAGE_kmod-shortcut-fe=y # SFE 需要，如果 TurboACC 使用 SFE
# CONFIG_PACKAGE_kmod-shortcut-fe-cm=y # SFE 需要，如果 TurboACC 使用 SFE
CONFIG_PACKAGE_kmod-sched-bbr=y # TCP BBR 拥塞控制算法 (TurboACC 可能需要)

# OpenClash & Dependencies
CONFIG_PACKAGE_luci-app-openclash=y # 从 diy-part1.sh 添加的源安装
CONFIG_PACKAGE_kmod-tun=y # TUN/TAP 驱动
CONFIG_PACKAGE_coreutils=y # 基础工具
CONFIG_PACKAGE_coreutils-base64=y # Base64 工具
# CONFIG_PACKAGE_ruby is not set # OpenClash 最新版可能不再强依赖 Ruby? 需要核实 vernesong 源的当前依赖
# CONFIG_PACKAGE_ruby-yaml is not set # 同上
CONFIG_PACKAGE_unzip=y # 解压工具
CONFIG_PACKAGE_geoip-utils=y # GeoIP 工具 (可选，如果 OpenClash 需要)
# CONFIG_PACKAGE_geosite-dat=y # Geosite 数据 (可选，OpenClash 按需下载或手动上传)
# CONFIG_PACKAGE_geoip-asn-dat=y # GeoIP ASN 数据 (可选)
CONFIG_PACKAGE_libcap=y # 库
CONFIG_PACKAGE_libcap-ng=y # 库
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y # OpenClash 中文 (需确认包名)

# UPnP & NAT-PMP
CONFIG_PACKAGE_miniupnpd-nftables=y # 使用 nftables 版本
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y # UPnP 中文

# USB Printer Support
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_kmod-usb-uhci=y # USB 1.1 (OHCI typically handles this better on some HW)
CONFIG_PACKAGE_kmod-usb-ohci=y # USB 1.1
CONFIG_PACKAGE_kmod-usb2=y     # USB 2.0 (EHCI)
CONFIG_PACKAGE_kmod-usb3=y     # USB 3.0 (XHCI) - Newifi 3 包含 USB 3.0 接口
CONFIG_PACKAGE_p910nd=y # 打印服务器守护进程
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y # 打印服务器中文

# Poweroff Function
CONFIG_PACKAGE_luci-app-poweroffdevice=y # 从 diy-part1.sh 添加的源安装
CONFIG_PACKAGE_poweroff=y # 底层关机命令
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y # 关机插件中文 (需确认包名)

# Full Cone NAT (nftables)
CONFIG_PACKAGE_kmod-nft-fullcone=y # 从 diy-part1.sh 添加的源安装
CONFIG_PACKAGE_kmod-nft-tproxy=y # kmod-nft-fullcone 的依赖

# Wireless Drivers (for Newifi 3 - MT7603E + MT7612E)
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt7615e=y # mt7615 driver handles mt7612e/mt7662e as well
CONFIG_PACKAGE_kmod-mt76_common=y
CONFIG_PACKAGE_hostapd-common=y
# Wireless Security (Choose one, mbedtls is usually smaller)
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
CONFIG_PACKAGE_wpad-basic-mbedtls=y
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-full is not set
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

# Utilities (Optional, but recommended)
CONFIG_PACKAGE_htop=y # 进程查看
CONFIG_PACKAGE_nano=y # 文本编辑器 (比 vi 易用)
# CONFIG_PACKAGE_vim-tiny is not set
CONFIG_PACKAGE_usbutils=y # lsusb 等 USB 调试工具
CONFIG_PACKAGE_ethtool=y # 网卡工具
CONFIG_PACKAGE_iperf3=y # 网络测速工具

# Filesystem support for USB drives (Optional, if you might mount storage)
# CONFIG_PACKAGE_kmod-fs-ext4=y
# CONFIG_PACKAGE_kmod-fs-vfat=y
# CONFIG_PACKAGE_kmod-nls-cp437=y
# CONFIG_PACKAGE_kmod-nls-iso8859-1=y
# CONFIG_PACKAGE_kmod-nls-utf8=y
# CONFIG_PACKAGE_block-mount=y

# Other LuCI Translations needed
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y # (需确认包名)
# Add other luci-i18n-* for any base apps included, like luci-i18n-firewall-zh-cn (already listed), etc.
