#
# Target Configuration
#
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y
CONFIG_TARGET_BOARD="ramips/mt7621"

#
# Target Images
#
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set # 确保不编译 ext4 格式固件
# CONFIG_TARGET_IMAGES_PAD is not set # 通常不需要特殊填充

#
# Global build settings
#
# CONFIG_SIGNED_PACKAGES is not set # 通常不需要签名包
# CONFIG_KERNEL_BUILD_DOMAIN="mydomain" # 可选：自定义内核域名
# CONFIG_KERNEL_BUILD_USER="builder" # 可选：自定义编译用户名

#
# Base system
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y # 增加兼容性
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_ucode=y # 现代OpenWrt基础
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_luci-lua-runtime=y

#
# LuCI Modules -> Applications
#
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y # 网络安全补充
CONFIG_PACKAGE_luci-app-nlbwmon=y # 实用工具
CONFIG_PACKAGE_luci-app-p910nd=y # USB 打印
CONFIG_PACKAGE_luci-app-turboacc=y # 来自 diy-part1.sh
CONFIG_PACKAGE_luci-app-openclash=y # 来自 diy-part1.sh
CONFIG_PACKAGE_luci-app-poweroffdevice=y # 来自 diy-part1.sh

#
# LuCI Modules -> Modules
#
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y

#
# LuCI Modules -> Protocols
#
CONFIG_PACKAGE_luci-proto-ppp=y # 基础协议
CONFIG_PACKAGE_luci-proto-ipv6=y

#
# LuCI Modules -> Themes
#
CONFIG_PACKAGE_luci-theme-bootstrap=y # 默认主题

#
# LuCI Modules -> Translations
#
CONFIG_LUCI_LANG_zh_Hans=y # 中文界面

#
# Network -> Firewall (Firewall4 / nftables)
#
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y # Flow Offloading 支持
CONFIG_PACKAGE_kmod-nft-nat6=y # IPv6 NAT
CONFIG_PACKAGE_iptables-nft=y # iptables 兼容层 (OpenClash 可能需要)
CONFIG_PACKAGE_ip6tables-nft=y # ip6tables 兼容层
# CONFIG_PACKAGE_iptables is not set # 不编译旧 iptables
# CONFIG_PACKAGE_ip6tables is not set # 不编译旧 ip6tables
# CONFIG_PACKAGE_kmod-nft-fullcone=y # 来自 diy-part1.sh (注意兼容性)

#
# Network -> IP Addresses and Names -> dnsmasq (full version)
#
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y # OpenClash 需要
# CONFIG_PACKAGE_dnsmasq is not set # 禁用基础版本
# CONFIG_PACKAGE_dnsmasq_full_dnssec is not set # 通常不需要 DNSSEC
# CONFIG_PACKAGE_dnsmasq_full_tftp is not set # 通常不需要 TFTP

#
# Network -> IPv6
#
CONFIG_IPV6=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y # Client
CONFIG_PACKAGE_odhcpd-ipv6only=y # Server/Relay

#
# Network -> UPnP & NAT-PMP
#
CONFIG_PACKAGE_miniupnpd-nft=y # 使用 nftables 版本
# CONFIG_PACKAGE_miniupnpd is not set

#
# Network -> WirelessAPD (选择一个 wpad 变种)
#
# CONFIG_PACKAGE_wpad-basic-wolfssl=y # 基础版，占用小
# CONFIG_PACKAGE_wpad-wolfssl=y # 功能更全的 wolfssl 版
CONFIG_PACKAGE_wpad-openssl=y # 功能更全的 openssl 版 (openssl 通常被更多包依赖)
# CONFIG_PACKAGE_wpad-basic-openssl=y
# CONFIG_PACKAGE_hostapd-common=y # wpad 会自动选择

#
# Kernel modules -> Network Devices
#
CONFIG_PACKAGE_kmod-mt7603e=y # Newifi3 2.4G
CONFIG_PACKAGE_kmod-mt76x2e=y # Newifi3 5G
CONFIG_PACKAGE_kmod-mt76-core=y # MTK 无线核心
CONFIG_PACKAGE_kmod-mt76-connac=y # 一些 MTK 驱动可能需要
CONFIG_PACKAGE_kmod-tun=y # OpenClash TUN 模式需要

#
# Kernel modules -> Network Support
#
CONFIG_PACKAGE_kmod-ipt-core=y # iptables 内核核心 (iptables-nft 需要)
CONFIG_PACKAGE_kmod-ipt-ipset=y # ipset 支持 (OpenClash 需要)
CONFIG_PACKAGE_kmod-ipt-tproxy=y # 透明代理 TPROXY 支持 (OpenClash 可能需要)
CONFIG_PACKAGE_kmod-nfnetlink=y # nftables 需要
CONFIG_PACKAGE_kmod-ip6tables-core=y # ip6tables 内核核心 (ip6tables-nft 需要)
CONFIG_PACKAGE_kmod-nf-reject=y # 防火墙 REJECT
CONFIG_PACKAGE_kmod-nf-reject6=y # IPv6 防火墙 REJECT
CONFIG_PACKAGE_kmod-nf-log=y # 防火墙日志
CONFIG_PACKAGE_kmod-nf-log6=y # IPv6 防火墙日志
CONFIG_PACKAGE_kmod-nf-conntrack=y # 连接跟踪
CONFIG_PACKAGE_kmod-nf-conntrack6=y # IPv6 连接跟踪
CONFIG_PACKAGE_kmod-nf-flow=y # Flow Offloading 基础
CONFIG_PACKAGE_kmod-tcp-bbr=y # TurboACC BBR
CONFIG_PACKAGE_kmod-sched-core=y # 流量调度核心
CONFIG_PACKAGE_kmod-sched-cake=y # CAKE 队列管理 (TurboACC 可能用到)
CONFIG_PACKAGE_kmod-sched-fq_codel=y # FQ_CoDel 队列管理 (默认)
# CONFIG_PACKAGE_kmod-fast-classifier=y # Software Flow Offloading 需要
# CONFIG_PACKAGE_kmod-shortcut-fe=y # Shortcut-FE (可选, 如果 TurboACC 配置了且需要)
# CONFIG_PACKAGE_kmod-shortcut-fe-cm=y # Shortcut-FE 连接管理器 (如果选了 Shortcut-FE)

#
# Kernel modules -> USB Support
#
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-printer=y # USB 打印机
CONFIG_PACKAGE_kmod-usb2=y # EHCI
CONFIG_PACKAGE_kmod-usb3=y # XHCI

#
# Kernel modules -> Filesystems
#
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
# CONFIG_PACKAGE_kmod-fs-ntfs=y # 旧版 NTFS
CONFIG_PACKAGE_kmod-fs-ntfs3=y # 较新的 NTFS (如果内核支持)
# 如果内核不支持 ntfs3, 则取消上面一行，并启用下面两行:
# CONFIG_PACKAGE_kmod-fs-ntfs=y
# CONFIG_PACKAGE_ntfs-3g=y

#
# Kernel modules -> Hardware Monitoring support
#
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-thermal=y # 温度监控

#
# Libraries
#
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libopenssl=y # 选择 openssl 作为基础 SSL 库
# CONFIG_PACKAGE_libwolfssl is not set
# CONFIG_PACKAGE_libmbedtls is not set
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libyaml=y # OpenClash 可能需要 (代替了 Ruby-yaml)
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libbz2=y
CONFIG_PACKAGE_libcap=y # OpenClash 需要
CONFIG_PACKAGE_libcap-ng=y
CONFIG_PACKAGE_libipset=y # OpenClash 需要
CONFIG_PACKAGE_libnl-tiny=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_libubus-lua=y
CONFIG_PACKAGE_libustream-openssl=y # 与基础 SSL 库保持一致
CONFIG_PACKAGE_zlib=y

#
# Utilities
#
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y # OpenClash 需要
CONFIG_PACKAGE_bash=y # OpenClash 需要
CONFIG_PACKAGE_curl=y # OpenClash 需要
CONFIG_PACKAGE_ca-certificates=y # OpenClash 需要
CONFIG_PACKAGE_ca-bundle=y # 替代 ca-certificates，通常更推荐
CONFIG_PACKAGE_ipset=y # OpenClash 需要
CONFIG_PACKAGE_ip-full=y # OpenClash 需要 (提供更完整的 ip 命令)
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y # 调试工具
CONFIG_PACKAGE_wget-ssl=y # 或使用 curl
CONFIG_PACKAGE_nano=y # 文本编辑器
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_block-mount=y # 挂载文件系统
CONFIG_PACKAGE_p910nd=y # USB 打印服务
CONFIG_PACKAGE_ddns-scripts=y # DDNS 基础脚本
CONFIG_PACKAGE_ddns-scripts-cloudflare=y # 示例：Cloudflare (按需修改或添加其他)
# CONFIG_PACKAGE_ddns-scripts-aliyun=y
# CONFIG_PACKAGE_ddns-scripts-dnspod=y

#
# 以下是一些可能不需要的包，确保它们没有被意外选中
#
# CONFIG_PACKAGE_firewall is not set # 旧版防火墙
# CONFIG_PACKAGE_ruby is not set # OpenClash 不再需要
# CONFIG_PACKAGE_pdnsd-alt is not set # TurboACC 可选依赖，默认不选
