#
# Target System Configuration
#
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y # Newifi D2 就是 Newifi 3

#
# Target Images
#
CONFIG_TARGET_IMAGES_SQUASHFS=y              # 构建 SquashFS 格式的镜像
# CONFIG_TARGET_IMAGES_INITRAMFS is not set # 通常不需要 initramfs 镜像
CONFIG_TARGET_ROOTFS_SQUASHFS=y              # Rootfs 使用 SquashFS
# 确保其他不需要的镜像格式被取消选择 (e.g., EXT4)
# CONFIG_TARGET_IMAGES_EXT4 is not set

#
# Base system
#
CONFIG_PACKAGE_bash=y                      # OpenClash 脚本可能需要 bash
CONFIG_PACKAGE_coreutils=y                 # 提供更完整的 coreutils
CONFIG_PACKAGE_coreutils-basename=y
CONFIG_PACKAGE_curl=y                      # 提供 curl 工具，OpenClash 等可能需要
# CONFIG_PACKAGE_wget is not set             # 通常用 uclient-fetch 或 curl 替代
CONFIG_PACKAGE_dnsmasq-full=y              # 使用 Dnsmasq Full 版本
# CONFIG_PACKAGE_dnsmasq is not set          # 取消选择 Dnsmasq 基础版，避免冲突
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set # 不使用 wpad-basic
CONFIG_PACKAGE_wpad-openssl=y              # 使用 wpad-openssl 提供完整的 WPA/WPA2/WPA3 支持
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-wolfssl is not set
CONFIG_PACKAGE_ipv6helper=y                # IPv6 辅助工具
CONFIG_PACKAGE_kmod-ipv6=y                 # IPv6 内核支持 (通常默认选中)
CONFIG_PACKAGE_odhcp6c=y                   # IPv6 客户端 (DHCPv6/RA)
CONFIG_PACKAGE_odhcpd-ipv6only=y           # IPv6 服务器 (RA & DHCPv6)

#
# Kernel modules
#
# Filesystems
CONFIG_PACKAGE_kmod-fs-ext4=y              # 支持 ext4 文件系统 (用于挂载 U 盘等)
CONFIG_PACKAGE_kmod-fs-vfat=y              # 支持 FAT/VFAT 文件系统
CONFIG_PACKAGE_kmod-nls-cp437=y            # FAT codepage
CONFIG_PACKAGE_kmod-nls-iso8859-1=y        # FAT codepage
CONFIG_PACKAGE_kmod-nls-utf8=y             # UTF8 support for filesystems

# USB Support
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y                 # EHCI USB 2.0
CONFIG_PACKAGE_kmod-usb3=y                 # XHCI USB 3.0 (Newifi3 有 USB3.0)
CONFIG_PACKAGE_kmod-usb-printer=y          # USB 打印机内核支持
CONFIG_PACKAGE_kmod-usb-storage=y          # USB 存储设备支持
CONFIG_PACKAGE_usbutils=y                  # 包含 lsusb 等工具

# Wireless Drivers (MT76 for Newifi 3)
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt7603=y               # 2.4 GHz radio (MT7603EN)
CONFIG_PACKAGE_kmod-mt76x2=y               # 5 GHz radio (MT7612EN)
# CONFIG_PACKAGE_kmod-mt76x2u is not set      # 这个是 USB 无线网卡驱动，不需要
# CONFIG_PACKAGE_kmod-mt76x0e is not set     # 根据实际硬件精确选择，Newifi3 用 7603+76x2(7612)
# CONFIG_PACKAGE_kmod-mt76x2e is not set    # 通常 mt76x2 包含了 7612e，确认下 driver 对 variant 的支持
# CONFIG_PACKAGE_kmod-mt7615e is not set
# CONFIG_PACKAGE_kmod-mt7663e is not set

# Network -- Offloading / Acceleration
CONFIG_PACKAGE_kmod-nft-offload=y          # Flow Offloading (nftables/firewall4)
# CONFIG_PACKAGE_kmod-ipt-offload is not set # 如果是基于 iptables 的老版本或特殊包才需要
CONFIG_KERNEL_HW_FLOW_OFFLOAD=y            # 内核配置：启用硬件 Flow Offloading
CONFIG_KERNEL_SW_FLOW_OFFLOAD=y            # 内核配置：启用软件 Flow Offloading

# Network -- NFTables FullCone NAT
CONFIG_PACKAGE_kmod-nft-fullcone=y         # 选择来自 diy-part1.sh 添加的包

#
# LuCI -- Interface Configuration Utility
#
CONFIG_PACKAGE_luci=y                      # 包含核心 LuCI
CONFIG_PACKAGE_luci-base=y                 # 基础 LuCI
CONFIG_PACKAGE_luci-mod-admin-full=y       # 完整的管理界面
CONFIG_PACKAGE_luci-mod-network=y          # 网络配置界面
CONFIG_PACKAGE_luci-mod-status=y           # 状态页面
CONFIG_PACKAGE_luci-mod-system=y           # 系统配置界面

# LuCI -- Applications
CONFIG_PACKAGE_luci-app-firewall=y         # 防火墙 (Firewall4) 界面
CONFIG_PACKAGE_luci-app-opkg=y             # 软件包管理界面
CONFIG_PACKAGE_luci-app-openclash=y        # OpenClash (来自 diy-part1.sh 添加的包)
CONFIG_PACKAGE_luci-app-p910nd=y           # 打印服务器界面 (假设从官方 feed 获取)
CONFIG_PACKAGE_luci-app-poweroffdevice=y   # 关机功能 (来自 diy-part1.sh 添加的包)
CONFIG_PACKAGE_luci-app-turboacc=y         # Turbo ACC 加速界面 (来自 diy-part1.sh 添加的包)
CONFIG_PACKAGE_luci-app-upnp=y             # UPnP/NAT-PMP 界面

# LuCI -- Protocols
CONFIG_PACKAGE_luci-proto-ipv6=y           # IPv6 (6in4, 6to4, 6rd, etc.) 协议支持
CONFIG_PACKAGE_luci-proto-ppp=y            # PPPoE, PPTP 等 PPP 协议支持 (常用)

# LuCI -- Themes
CONFIG_PACKAGE_luci-theme-bootstrap=y      # 默认的 Bootstrap 主题
# CONFIG_PACKAGE_luci-theme-argon is not set # 取消其他主题，除非特别需要

# LuCI -- Translations
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y      # LuCI 基础中文翻译
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y  # 防火墙中文翻译
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y      # opkg 中文翻译
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y      # UPnP 中文翻译
# 注意：来自自定义源的 App (OpenClash, TurboACC, Poweroff) 的中文翻译通常集成在各自的包里，
# 或需要单独的 i18n 包 (如果其开发者提供的话)。确保 OpenClash 包的 Makefile 包含语言文件。
# 如果编译后发现这些自定义 App 没有中文，需要检查其源码包结构或寻找对应的 i18n 包源。
# 示例: 可能需要类似 luci-i18n-openclash-zh-cn 的包，但这取决于vernonsong如何打包。

#
# Network
#
# Firewall
CONFIG_PACKAGE_firewall4=y                 # 使用 firewall4 (基于 nftables)
# CONFIG_PACKAGE_firewall is not set       # 不使用旧的 firewall (iptables)
CONFIG_PACKAGE_nftables-utils=y            # nftables 用户空间工具
# CONFIG_PACKAGE_iptables-nft is not set     # 通常 firewall4 会处理兼容性

# Printing
CONFIG_PACKAGE_p910nd=y                    # p910nd 打印服务器守护进程

# UPnP / NAT-PMP
CONFIG_PACKAGE_miniupnpd=y                 # miniupnpd 服务，提供 UPnP 和 NAT-PMP

# Libraries
CONFIG_PACKAGE_libopenssl=y                # 使用 OpenSSL 库
# CONFIG_PACKAGE_libwolfssl is not set
# CONFIG_PACKAGE_libmbedtls is not set
CONFIG_PACKAGE_libcap=y                    # libcap 库 (OpenClash 可能需要)
CONFIG_PACKAGE_libcap-ng=y                 # libcap-ng 库 (OpenClash 可能需要)
CONFIG_PACKAGE_libcurl=y                   # Curl 库
CONFIG_PACKAGE_libustream-openssl=y        # ustream SSL 支持 for openssl (luci 等需要)
# CONFIG_PACKAGE_libustream-wolfssl is not set

# Utilities
# 可根据需要添加更多工具，如 htop, nano, etc.
# CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_nano=y

# Enable MULTILIB for specific libraries if needed, but generally not required for this setup.

# Ensure build related settings are optimized, e.g., compiler optimizations (usually defaults are fine)
CONFIG_STRIP_KERNEL_EXPORTS=y              # 减小内核大小
# CONFIG_USE_MKLIBS is not set             # 通常不需要

# Default network settings for Newifi3 (usually handled by target profile)
# LAN IP address etc., will be set on first boot or configured via LuCI
