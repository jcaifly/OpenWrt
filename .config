# ==================================================
# 目标系统配置 (Target System): Newifi D2 (MT7621)
# ==================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ==================================================
# 目标镜像格式 (Target Image Format): SquashFS Sysupgrade
# ==================================================
CONFIG_TARGET_IMAGES_SQUASHFS=y
# CONFIG_TARGET_IMAGES_GZIP is not set
CONFIG_TARGET_IMAGES_INITRAMFS=n

# ==================================================
# 基本系统组件 (Base System): 核心组件、驱动、基础支持
# ==================================================
CONFIG_PACKAGE_blkid=y                 # **独立 blkid 命令行工具**
CONFIG_PACKAGE_block-mount=y           # **挂载点管理 (核心)**
CONFIG_PACKAGE_blockd=y                # **块设备事件守护进程**
CONFIG_PACKAGE_ca-certificates=y       # **HTTPS 证书**
CONFIG_PACKAGE_coreutils=y             # **基础命令行工具 (ls, cp, mv...)**
CONFIG_PACKAGE_coreutils-nohup=y       # **nohup 工具 (OpenClash 依赖)**
# CONFIG_PACKAGE_diskman is not set # 由 luci-app-diskman 拉取
CONFIG_PACKAGE_dropbear=y              # **SSH 服务器**
CONFIG_PACKAGE_firewall4=y             # **防火墙 (nftables)**
CONFIG_PACKAGE_fstools=y               # **文件系统工具 (含 libblkid)**
CONFIG_PACKAGE_getopt=y                # **命令行参数解析**
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y # **GPIO 按键热插拔**
CONFIG_PACKAGE_kmod-leds-gpio=y        # **GPIO LED 控制**
# --- Wireless Drivers (Moved to Wireless Section) --- # 无线驱动已移至无线网络章节
# CONFIG_PACKAGE_logd is not set       # **使用内核日志**
# CONFIG_PACKAGE_mkfstool is not set   # **通常由 fstools 或其他工具处理**
CONFIG_PACKAGE_mtd=y                   # **Flash 操作工具**
CONFIG_PACKAGE_netifd=y                # **网络接口管理守护进程**
CONFIG_PACKAGE_odhcp6c=y               # **IPv6 DHCP 客户端**
CONFIG_PACKAGE_odhcpd-ipv6only=y       # **IPv6 DHCP 服务器/RA 服务 (禁用 v4)**
CONFIG_PACKAGE_opkg=y                  # **软件包管理器**
CONFIG_PACKAGE_ppp=y                   # **PPP 协议支持**
CONFIG_PACKAGE_kmod-ppp=y              # **PPP 内核模块**
CONFIG_PACKAGE_ppp-mod-pppoe=y         # **PPPoE 模块**
CONFIG_PACKAGE_rpcd=y                  # **RPC 守护进程 (LuCI 依赖)**
CONFIG_PACKAGE_rpcd-mod-file=y         # **RPC 文件访问模块**
# CONFIG_PACKAGE_rpcd-mod-iwinfo=y # 已移至无线网络章节
CONFIG_PACKAGE_rpcd-mod-luci=y         # **RPC LuCI 核心模块**
# CONFIG_PACKAGE_rpcd-mod-rrdns=y      # 按需，如果 LuCI 状态图需要
CONFIG_PACKAGE_rpcd-mod-ucode=y        # **RPC ucode 模块**
CONFIG_PACKAGE_ucode=y                 # **ucode 解释器**
CONFIG_PACKAGE_ucode-mod-fs=y          # **ucode 文件系统模块**
CONFIG_PACKAGE_ucode-mod-html=y        # **ucode HTML 模块**
CONFIG_PACKAGE_ucode-mod-http=y        # **ucode HTTP 模块**
CONFIG_PACKAGE_ucode-mod-math=y        # **ucode 数学模块**
CONFIG_PACKAGE_ucode-mod-process=y     # **ucode 进程模块**
CONFIG_PACKAGE_ucode-mod-uci=y         # **ucode UCI 模块**
CONFIG_PACKAGE_uci=y                   # **统一配置接口**
CONFIG_PACKAGE_uclient-fetch=y         # **基础下载客户端**
CONFIG_PACKAGE_urandom-seed=y          # **随机数种子**
CONFIG_PACKAGE_urngd=y                 # **随机数生成守护进程**

# ==================================================
# 存储与分区工具 (Storage & Partitioning) - 已加固
# ==================================================
CONFIG_PACKAGE_fdisk=y                 # **MBR 分区工具 (Util-linux)**
CONFIG_PACKAGE_lsblk=y                 # **列出块设备 (Util-linux)**
CONFIG_PACKAGE_parted=y                # **GPT/MBR 分区工具**
CONFIG_PACKAGE_sfdisk=y                # **脚本化分区 (Util-linux)**
CONFIG_PACKAGE_util-linux=y            # **包含 fdisk, lsblk, sfdisk 等**
CONFIG_PACKAGE_e2fsprogs=y             # **EXT2/3/4 文件系统工具**
CONFIG_PACKAGE_exfatprogs=y            # **exFAT 文件系统工具 (推荐)**
CONFIG_PACKAGE_hdparm=y                # **硬盘参数工具**

# ==================================================
# 无线网络驱动、管理与安全 (Wireless Drivers, Management & Security) - 完整配置
# ==================================================
# --- 核心无线内核模块 ---
CONFIG_PACKAGE_kmod-cfg80211=y          # 无线配置 API
CONFIG_PACKAGE_kmod-mac80211=y          # 无线 Software MAC 层
CONFIG_PACKAGE_kmod-mt76-core=y         # MT76 系列无线驱动核心
# --- 特定设备无线驱动 (Newifi D2) ---
CONFIG_PACKAGE_kmod-mt7603=y            # MT7603 (2.4GHz) 驱动
# CONFIG_PACKAGE_kmod-mt7603e is not set  # 确认替代驱动已禁用
CONFIG_PACKAGE_kmod-mt76x2=y            # MT7612/MT76x2 (5GHz) 驱动
# --- 无线用户空间工具 ---
CONFIG_PACKAGE_hostapd-common=y         # Hostapd/WPA Supplicant 通用文件
CONFIG_PACKAGE_iw=y                     # 无线命令行工具
CONFIG_PACKAGE_iwinfo=y                 # 无线信息库 (二进制程序)
CONFIG_PACKAGE_wireless-regdb=y         # 无线区域数据库
# --- 无线安全 (WPA Supplicant & Hostapd) - 选用 wolfSSL 以支持 WPA3 ---
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set # 禁用基础版
CONFIG_PACKAGE_wpad-wolfssl=y           # 全功能 WPA Supplicant/Hostapd (通过 wolfSSL 支持 WPA3)
# 可选：如果需要 WPS 功能 (通常为安全起见不选)
# CONFIG_PACKAGE_wpad-wolfssl_WPS_SUPPORT=y
# --- 无线相关库 & LuCI 集成 ---
CONFIG_PACKAGE_libiwinfo=y              # Iwinfo C 库
CONFIG_PACKAGE_libiwinfo-data=y         # Iwinfo 数据文件
CONFIG_PACKAGE_libiwinfo-lua=y          # Iwinfo Lua 绑定 (供 LuCI 使用)
CONFIG_PACKAGE_rpcd-mod-iwinfo=y        # RPC 无线信息模块 (供 LuCI 使用)

# ==================================================
# DHCP 和 DNS 服务器 (DHCP & DNS Server)
# ==================================================
# CONFIG_PACKAGE_dnsmasq is not set         # **禁用标准版，避免冲突**
# CONFIG_PACKAGE_dnsmasq-base is not set    # **禁用基础版，避免冲突**
CONFIG_PACKAGE_dnsmasq-full=y               # **启用全功能版 (含 IPset, DNSSEC, DHCPv6)**
CONFIG_PACKAGE_libnetfilter-conntrack=y     # dnsmasq-full 依赖
CONFIG_PACKAGE_libnettle=y                  # dnsmasq-full 依赖 (加密库)

# ==================================================
# LuCI Web 用户界面 (Web User Interface)
# ==================================================
CONFIG_PACKAGE_luci=y                      # **LuCI 元数据包**
CONFIG_PACKAGE_luci-base=y                 # **LuCI 核心库和资源**
CONFIG_PACKAGE_luci-compat=y               # **LuCI 兼容层 (对旧模块)**
CONFIG_PACKAGE_luci-mod-admin-full=y       # **LuCI 完整管理菜单**
CONFIG_PACKAGE_luci-mod-network=y          # **LuCI 网络设置 (包含无线设置页面)**
CONFIG_PACKAGE_luci-mod-status=y           # **LuCI 状态概览**
CONFIG_PACKAGE_luci-mod-system=y           # **LuCI 系统设置 (含启动项, 挂载点)**
CONFIG_PACKAGE_luci-proto-ipv6=y           # **LuCI IPv6 协议支持**
CONFIG_PACKAGE_luci-proto-ppp=y            # **LuCI PPP/PPPoE 协议支持**
CONFIG_PACKAGE_luci-app-firewall=y         # **LuCI 防火墙设置**
CONFIG_PACKAGE_luci-app-opkg=y             # **LuCI 软件包管理**
CONFIG_PACKAGE_luci-app-upnp=y             # **LuCI UPnP/NAT-PMP 设置**
# --- 从外部源添加的 LuCI 应用 (通过 diy-part1.sh 克隆) ---
CONFIG_PACKAGE_luci-app-openclash=y        # **LuCI OpenClash**
CONFIG_PACKAGE_luci-app-partexp=y          # **LuCI 分区扩容助手**
CONFIG_PACKAGE_luci-app-diskman=y          # **LuCI 图形化磁盘管理**
CONFIG_PACKAGE_luci-app-p910nd=y           # **LuCI USB 打印服务器设置**
CONFIG_PACKAGE_luci-app-poweroffdevice=y   # **LuCI 关机/重启**
CONFIG_PACKAGE_luci-app-turboacc=y         # **LuCI Turbo ACC 网络加速**

# ==================================================
# LuCI 主题 (Theme)
# ==================================================
CONFIG_PACKAGE_luci-theme-bootstrap=y    # **默认主题**

# ==================================================
# LuCI 语言支持 (Language Support): 中文
# ==================================================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
# --- 外部 App 汉化包 (确认包名与源一致) ---
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y # 需要确认此汉化包兼容当前turboacc版本
# --- 确保这个未设置 ---
# CONFIG_LUCI_SRCDIET is not set # 不精简 LuCI 源文件

# ==================================================
# 网络相关工具和库 (Networking)
# ==================================================
CONFIG_PACKAGE_curl=y                  # **强大的文件传输工具 (OpenClash 依赖)**
CONFIG_PACKAGE_ip-full=y               # **完整的 iproute2 工具**
CONFIG_PACKAGE_ipset=y                 # **IP Set 工具 (防火墙/OpenClash 依赖)**
CONFIG_PACKAGE_iptables-nft=y          # **iptables nftables 兼容层**
CONFIG_PACKAGE_libcurl=y               # **curl 库**
CONFIG_PACKAGE_libipset=y              # **ipset 库**
CONFIG_PACKAGE_libyaml=y               # **YAML 解析库 (OpenClash 依赖)**
CONFIG_PACKAGE_libcap-ng=y             # **Capabilities 库 (OpenClash 可能依赖)**
CONFIG_PACKAGE_libnfnetlink=y          # **Netfilter Netlink 库**
CONFIG_PACKAGE_libnftnl=y              # **Nftables Netlink 库 (firewall4/miniupnpd 依赖)**
CONFIG_PACKAGE_libnl-tiny=y            # **精简版 Netlink 库**
CONFIG_PACKAGE_libpcre=y               # **Perl 兼容正则表达式库**
CONFIG_PACKAGE_resolveip=y             # **域名解析工具 (OpenClash 依赖)**
CONFIG_PACKAGE_wget-ssl=y              # **wget 下载工具 (支持 SSL)**
CONFIG_PACKAGE_miniupnpd-nft=y         # **UPnP 和 NAT-PMP 服务 (nftables 版本)**
CONFIG_PACKAGE_shortcut-fe=y           # **内核快速转发引擎 (TurboACC 可能用到)**

# ==================================================
# 内核模块 (Kernel Modules) - 不包含已在无线章节定义的模块
# ==================================================
# --- 网络 (非无线部分) ---
CONFIG_PACKAGE_kmod-ifb=y              # **中介功能块设备 (流量整形可能用)**
CONFIG_PACKAGE_kmod-ipt-core=y         # **iptables 核心模块 (兼容层依赖)**
CONFIG_PACKAGE_kmod-ipt-ipset=y        # **iptables ipset 模块 (兼容层)**
CONFIG_PACKAGE_kmod-ipt-nat=y          # **iptables NAT 模块 (兼容层)**
CONFIG_PACKAGE_kmod-ipv6=y             # **IPv6 协议支持**
CONFIG_PACKAGE_kmod-nf-conntrack=y     # **Netfilter 连接跟踪**
CONFIG_PACKAGE_kmod-nf-conntrack6=y    # **Netfilter IPv6 连接跟踪**
CONFIG_PACKAGE_kmod-nf-flow=y          # **Netfilter 流表**
CONFIG_PACKAGE_kmod-nf-nat=y           # **Netfilter NAT**
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y # **Netfilter NAT 辅助模块 (如 FTP, SIP)**
CONFIG_PACKAGE_kmod-nf-reject=y        # **Netfilter Reject 目标**
CONFIG_PACKAGE_kmod-nf-reject6=y       # **Netfilter IPv6 Reject 目标**
CONFIG_PACKAGE_kmod-nfnetlink=y        # **Netfilter Netlink 支持**
CONFIG_PACKAGE_kmod-nft-core=y         # **nftables 核心**
CONFIG_PACKAGE_kmod-nft-nat=y          # **nftables NAT 支持**
CONFIG_PACKAGE_kmod-nft-offload=y      # **nftables 硬件卸载支持**
CONFIG_PACKAGE_kmod-nft-fullcone=y     # *** 新增：TurboACC 的依赖 ***
CONFIG_PACKAGE_kmod-sched-core=y       # **内核流量调度核心**
CONFIG_PACKAGE_kmod-tun=y              # **TUN/TAP 虚拟网络设备 (OpenClash/VPN 依赖)**
# --- USB ---
CONFIG_PACKAGE_kmod-usb-core=y         # **USB 核心**
CONFIG_PACKAGE_kmod-usb-ehci=y         # **USB 2.0 EHCI 控制器**
CONFIG_PACKAGE_kmod-usb-ohci=y         # **USB 1.1 OHCI 控制器 (兼容性)**
CONFIG_PACKAGE_kmod-usb-uhci=y         # **USB 1.1 UHCI 控制器 (兼容性)**
CONFIG_PACKAGE_kmod-usb2=y             # **USB 2.0 (通常是元包或别名)**
CONFIG_PACKAGE_kmod-usb3=y             # **USB 3.0 XHCI 控制器**
CONFIG_PACKAGE_kmod-usb-printer=y      # **USB 打印机驱动**
CONFIG_PACKAGE_kmod-usb-storage=y      # **USB 存储 (BOT 模式)**
CONFIG_PACKAGE_kmod-usb-storage-uas=y  # **USB 存储 (UAS 模式 - 推荐)**
# --- SCSI & 存储底层 ---
CONFIG_PACKAGE_kmod-scsi-core=y        # **SCSI 核心支持 (USB 存储依赖)**
CONFIG_PACKAGE_kmod-lib-crc-itu-t=y    # **SCSI 依赖的 CRC 库**
# --- 分区表支持 ---
CONFIG_PACKAGE_kmod-part-msdos=y       # **MBR 分区表支持**
CONFIG_PACKAGE_kmod-part-gpt=y         # **GPT 分区表支持**
# --- 文件系统 ---
CONFIG_PACKAGE_kmod-fs-ext4=y          # **EXT4 文件系统支持**
CONFIG_PACKAGE_kmod-fs-vfat=y          # **VFAT (FAT32) 文件系统支持**
CONFIG_PACKAGE_kmod-fs-exfat=y         # **exFAT 文件系统支持**
# --- NLS (文件系统字符集支持) ---
CONFIG_PACKAGE_kmod-nls-base=y         # **NLS 基础**
CONFIG_PACKAGE_kmod-nls-cp437=y        # **NLS Codepage 437 (常用)**
CONFIG_PACKAGE_kmod-nls-iso8859-1=y    # **NLS ISO8859-1 (常用)**
CONFIG_PACKAGE_kmod-nls-utf8=y         # **NLS UTF-8 (必须)**
# --- 基础加密 ---
CONFIG_PACKAGE_kmod-crypto-hash=y      # **内核加密哈希**
CONFIG_PACKAGE_kmod-crypto-authenc=y   # **内核认证加密**
CONFIG_PACKAGE_kmod-crypto-aead=y      # **内核 AEAD 加密**
# --- WPA3/wolfssl 所需的附加内核加密模块 ---
CONFIG_PACKAGE_kmod-crypto-kpp=y           # WPA3 SAE 需要
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y # WPA3 SAE 需要 (wolfssl 后端)
CONFIG_PACKAGE_kmod-crypto-lib-sha256=y    # WPA3 可能需要

# ==================================================
# 必要的共享库 (Libraries)
# ==================================================
CONFIG_PACKAGE_libatomic=y             # **原子操作库**
CONFIG_PACKAGE_libblkid=y              # **blockd/fstools/util-linux 依赖**
CONFIG_PACKAGE_libc=y                  # **标准 C 库 (自动)**
CONFIG_PACKAGE_libelf=y                # **ELF 文件处理库**
CONFIG_PACKAGE_libext2fs=y             # **e2fsprogs 依赖**
CONFIG_PACKAGE_libfdisk=y              # **util-linux/fdisk 依赖**
CONFIG_PACKAGE_libgcc=y                # **GCC 运行时库 (自动)**
CONFIG_PACKAGE_libgmp=y                # **多精度算术库**
# libiwinfo* 已在无线章节定义
CONFIG_PACKAGE_libjson-c=y             # **JSON-C 库**
CONFIG_PACKAGE_liblua=y                # **Lua 解释器库**
CONFIG_PACKAGE_liblucihttp=y           # **LuCI HTTP 库**
CONFIG_PACKAGE_liblucihttp-ucode=y     # **LuCI HTTP ucode 绑定**
# CONFIG_PACKAGE_libmbedtls is not set # 已被 wolfssl/openssl 取代
CONFIG_PACKAGE_libmnl=y                # **迷你 Netlink 库**
CONFIG_PACKAGE_libncurses=y            # **终端控制库 (parted 等工具依赖)**
CONFIG_PACKAGE_libnl-genl=y            # **Netlink Generic 库**
CONFIG_PACKAGE_libnl-route=y           # **Netlink Route 库**
CONFIG_PACKAGE_libopenssl=y            # **OpenSSL 加密库 (常用, 与 wolfssl 共存)**
CONFIG_PACKAGE_libparted=y             # **parted 库**
CONFIG_PACKAGE_libpthread=y            # **POSIX 线程库 (自动)**
CONFIG_PACKAGE_librt=y                 # **POSIX 实时扩展库 (自动)**
CONFIG_PACKAGE_libsmartcols=y          # **util-linux/lsblk 依赖**
CONFIG_PACKAGE_libss=y                 # **e2fsprogs 依赖**
CONFIG_PACKAGE_libubox=y               # **OpenWrt 基础库 (ubox)**
CONFIG_PACKAGE_libubus=y               # **OpenWrt 基础库 (ubus)**
CONFIG_PACKAGE_libuci=y                # **OpenWrt 基础库 (uci)**
CONFIG_PACKAGE_libuclient=y            # **uclient-fetch 库**
CONFIG_PACKAGE_libucode=y              # **ucode 库**
CONFIG_PACKAGE_libuuid=y               # **UUID 生成库 (util-linux 依赖)**
CONFIG_PACKAGE_libwolfssl=y            # **wolfSSL 库 (wpad-wolfssl 依赖)**
CONFIG_PACKAGE_libz=y                  # **zlib 压缩库 (旧名)**
CONFIG_PACKAGE_zlib=y                  # **zlib 压缩库 (新名)**

# ==================================================
# 实用工具 (Utilities)
# ==================================================
CONFIG_PACKAGE_iputils-ping=y          # **IPv4 ping**
CONFIG_PACKAGE_iputils-ping6=y         # **IPv6 ping**
CONFIG_PACKAGE_p910nd=y                # **打印服务器守护进程**
CONFIG_PACKAGE_usbutils=y              # **lsusb 等 USB 工具**

# ==================================================
# 构建与内核优化 (Build & Kernel Optimizations): 减小体积
# ==================================================
# CONFIG_PACKAGE_kmod-ikconfig is not set # **不编译内核配置文件进内核**
CONFIG_STRIP_PACKAGES=y                # **剥离软件包中的符号信息**
CONFIG_USE_STRIP=y                     # **使用 strip 工具**
CONFIG_KERNEL_DEBUG_INFO=n             # **不编译内核调试信息**
CONFIG_KERNEL_DEBUG_KERNEL=n           # **不编译内核调试功能**
# CONFIG_KERNEL_MAGIC_SYSRQ is not set # **禁用 SysRq 魔术键**
CONFIG_KERNEL_SWAP=n                   # **不支持 SWAP 分区/文件**
