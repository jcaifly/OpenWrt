#
# Target System Configuration
#
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

#
# Target Images
#
CONFIG_TARGET_IMAGES_SQUASHFS=y       # 构建 SquashFS 文件系统镜像
# CONFIG_TARGET_IMAGES_EXT4 is not set  # 不构建 EXT4 镜像
CONFIG_TARGET_IMAGES_GZIP=y           # 压缩镜像文件

#
# Base system
#
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_busybox=y
CONFIG_BUSYBOX_CONFIG_POWEROFF=y      # 确保 busybox 包含 poweroff 命令
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_ca-bundle=y            # 包含 SSL 证书，用于 HTTPS 连接
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_procd-seccomp=y        # 增强进程安全性
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_kmodloader=y
CONFIG_PACKAGE_resolveip=y            # DNS 解析工具
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_urngd=y                # 熵 HWRNG 守护进程

#
# Administration
#
CONFIG_PACKAGE_luci=y                 # LuCI Web 界面
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y  # 完整的管理界面模块
CONFIG_PACKAGE_luci-theme-bootstrap=y # 默认 Bootstrap 主题
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y

#
# Languages ---> Chinese
#
CONFIG_LUCI_LANG_zh_Hans=y            # LuCI 简体中文支持 (meta-package)
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # LuCI 基础中文翻译

#
# Network Configuration (Core)
#
CONFIG_PACKAGE_ip-full=y              # 完整版 ip 命令，便于调试
CONFIG_PACKAGE_kmod-inet-core=y       # IPv4/IPv6 核心网络模块
CONFIG_PACKAGE_kmod-nft-core=y        # Netfilter (nftables) 核心模块
CONFIG_PACKAGE_nftables=y             # nftables 用户空间工具
CONFIG_PACKAGE_kmod-nfnetlink=y       # Netfilter Netlink 模块
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_firewall4=y            # 使用 firewall4 (基于 nftables)
CONFIG_PACKAGE_kmod-nft-offload=y     # Netfilter 硬件卸载 (配合 TurboACC)
CONFIG_PACKAGE_iptables-nft=y         # iptables -> nftables 兼容层 (OpenClash 可能需要)
CONFIG_PACKAGE_ip6tables-nft=y        # ip6tables -> nftables 兼容层
CONFIG_PACKAGE_ipset=y                # ipset 工具 (OpenClash 常用)
CONFIG_PACKAGE_kmod-ipt-ipset=y       # ipset 内核模块支持 (虽然用 nftables，但 openclash 可能依赖此符号)
CONFIG_PACKAGE_kmod-nft-compat=y      # Nftables 兼容性模块
CONFIG_PACKAGE_odhcpd-ipv6only=y      # IPv6 DHCP 服务器/RA
CONFIG_PACKAGE_odhcp6c=y              # IPv6 DHCP 客户端
CONFIG_PACKAGE_ipv6helper=y           # IPv6 辅助工具
CONFIG_PACKAGE_kmod-ipv6=y            # IPv6 内核支持
CONFIG_PACKAGE_kmod-ip6tables=y       # 旧式 IP6Tables 内核模块（保险起见包含，iptables-nft 可能用到）

#
# Network ---> DHCP and DNS
#
# CONFIG_PACKAGE_dnsmasq is not set   # 禁用默认的 dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y         # 启用功能更全的 dnsmasq-full

#
# Network ---> Firewall
#
CONFIG_PACKAGE_luci-app-firewall=y    # 防火墙 LuCI 配置界面

#
# Network ---> WirelessAPD
#
CONFIG_PACKAGE_wpad-basic-mbedtls=y   # WiFi 认证后台 (WPA/WPA2/WPA3-PSK, 使用 mbedTLS)
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-openssl is not set

#
# Kernel modules ---> Network Devices
#
CONFIG_PACKAGE_kmod-mt7603=y          # Newifi3 2.4GHz WiFi 驱动
CONFIG_PACKAGE_kmod-mt76x2=y          # Newifi3 5GHz WiFi 驱动
CONFIG_PACKAGE_kmod-mt76-core=y       # Mediatek WiFi 核心模块
CONFIG_PACKAGE_kmod-mt76x02-common=y  # WiFi Common 模块

#
# Kernel modules ---> Network Support
#
CONFIG_PACKAGE_kmod-nf-flow=y         # Flow Offloading (TurboACC 依赖)
CONFIG_PACKAGE_kmod-nf-reject=y
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nf-log=y
CONFIG_PACKAGE_kmod-nf-log6=y
CONFIG_PACKAGE_kmod-nf-nat=y          # NAT 内核支持
CONFIG_PACKAGE_kmod-tcp-bbr=y         # TCP BBR 拥塞控制 (TurboACC 推荐)
CONFIG_PACKAGE_kmod-tun=y             # TUN/TAP 虚拟网络设备 (OpenClash TUN 模式)
CONFIG_PACKAGE_kmod-inet-diag=y       # INET Socket Monitoring (OpenClash 依赖)
CONFIG_PACKAGE_kmod-nft-tproxy=y      # Nftables TPROXY 支持 (OpenClash 透明代理)
CONFIG_PACKAGE_kmod-ipt-tproxy=y      # Iptables TPROXY 支持 (保险起见，虽然主要用nft)

#
# Kernel modules ---> Shortcut Forwarding Engine
#
CONFIG_PACKAGE_kmod-shortcut-fe=y     # Shortcut FE (TurboACC 依赖)
CONFIG_PACKAGE_kmod-shortcut-fe-cm=y  # Shortcut FE Connection Manager (推荐)

#
# Kernel modules ---> USB Support
#
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y        # USB 1.1 OHCI Controller
CONFIG_PACKAGE_kmod-usb-uhci=y        # USB 1.1 UHCI Controller
CONFIG_PACKAGE_kmod-usb2=y            # USB 2.0 EHCI Controller
CONFIG_PACKAGE_kmod-usb3=y            # USB 3.0 XHCI Controller (Newifi3 有 USB3.0)
CONFIG_PACKAGE_kmod-usb-printer=y     # USB 打印机内核模块
CONFIG_PACKAGE_libusb-1.0=y           # Userspace USB library
CONFIG_PACKAGE_usbutils=y             # lsusb 等 USB 工具

#
# LuCI ---> Applications
#
CONFIG_PACKAGE_luci-app-openclash=y         # OpenClash LuCI 界面
CONFIG_PACKAGE_luci-app-turboacc=y          # TurboACC LuCI 界面
CONFIG_PACKAGE_luci-app-upnp=y              # UPnP / NAT-PMP LuCI 界面
CONFIG_PACKAGE_luci-app-usb-printer=y       # USB 打印服务器 LuCI 界面
CONFIG_PACKAGE_luci-app-poweroffdevice=y    # 关机 LuCI 界面

#
# Network ---> Printing
#
CONFIG_PACKAGE_p910nd=y               # p910nd 打印服务器守护程序

#
# Network ---> UPnP
#
CONFIG_PACKAGE_miniupnpd=y            # UPnP 和 NAT-PMP 守护进程

#
# Network ---> Web Server/Proxy
#
CONFIG_PACKAGE_uhttpd=y               # LuCI 依赖的 Web 服务器
CONFIG_PACKAGE_uhttpd-mod-ubus=y      # LuCI 依赖的 ubus 模块

#
# Required by OpenClash
#
CONFIG_PACKAGE_coreutils=y            # 包含如 base64 等常用工具
CONFIG_PACKAGE_coreutils-base64=y     # 明确包含 base64
CONFIG_PACKAGE_bash=y                 # Bash shell (OpenClash 脚本常用)
CONFIG_PACKAGE_curl=y                 # 网络请求工具 (下载配置等)
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libcap-ng=y            # libcap-ng 权限管理库
CONFIG_PACKAGE_ruby=y                 # Ruby 解释器 (Clash 核心或其管理脚本可能需要)
CONFIG_PACKAGE_ruby-yaml=y            # Ruby YAML 支持
CONFIG_PACKAGE_ruby-psych=y           # Ruby 的另一个 YAML 解析器

#
# Utilities ---> Editors
#
CONFIG_PACKAGE_nano=y                 # Nano 编辑器 (可选，比 vi 易用)

#
# Utilities ---> Terminal
#
CONFIG_PACKAGE_htop=y                 # htop 进程查看器 (可选，便于监控)

#
# Other settings
#
CONFIG_PACKAGE_zlib=y                 # 基础压缩库
CONFIG_PACKAGE_libpthread=y           # POSIX 线程库

#
# Security
#
CONFIG_PACKAGE_dropbear=y             # SSH 服务器
CONFIG_PACKAGE_acl=y                  # 文件访问控制列表
CONFIG_PACKAGE_libacl=y

# Ensure default packages for network/system are present (often selected by default)
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-proto-ppp=y       # PPPoE 支持
CONFIG_PACKAGE_luci-proto-ipv6=y      # IPv6 LuCI 协议支持

#
# Final Checks - Remove unnecessary default packages if needed
# e.g., if dnsmasq was selected by default, we've unset it above.
#
