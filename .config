#
# OpenWrt Configuration for Newifi 3 (D2) - Official Source Build
# Optimized for Size and Essential Features with USB Overlay
#

# Target System (目标系统)
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_newifi_d2=y # 官方 OpenWrt 通常使用下划线 _

# Global build settings (全局构建设置)
CONFIG_MODULES=y         # 启用内核模块支持
CONFIG_IPV6=y            # 启用 IPv6 支持 (用户空间)
CONFIG_KERNEL_IPV6=y     # 启用 IPv6 支持 (内核)
# CONFIG_SIGNED_PACKAGES is not set # 禁用软件包签名检查 (可选，可略微减小体积，但降低安全性)
# CONFIG_SIGNATURE_CHECK is not set # 同上

# Target Images (目标镜像)
CONFIG_TARGET_IMAGES_GZIP=y # 压缩固件为 .gz 格式 (方便下载/传输)
CONFIG_TARGET_ROOTFS_PARTSIZE=100 # 设定根分区大小(MB)，为 Overlay 留出空间，确保基础系统能写入 Flash

# Base system (基础系统 - 精简)
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_dropbear=y           # SSH 服务器
CONFIG_PACKAGE_firewall4=y          # 防火墙 (nftables 后端)
CONFIG_PACKAGE_fstools=y            # 文件系统工具 (含分区挂载)
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y # GPIO 按键支持
CONFIG_PACKAGE_kmod-leds-gpio=y     # GPIO LED 支持
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
# CONFIG_PACKAGE_libstdcpp is not set # 移除 C++ 标准库，除非有包明确需要它 (Samba4 可能需要，会自动依赖)
CONFIG_PACKAGE_logd=y               # 日志服务
CONFIG_PACKAGE_mtd=y                # MTD 工具
CONFIG_PACKAGE_netifd=y             # 网络接口管理
CONFIG_PACKAGE_odhcp6c=y            # IPv6 DHCP 客户端
# CONFIG_PACKAGE_odhcpd-ipv6only is not set # 默认不作为 IPv6 服务器
CONFIG_PACKAGE_opkg=y               # 包管理器
CONFIG_PACKAGE_procd=y              # 进程管理器
CONFIG_PACKAGE_procd-seccomp=y      # 增强 procd 安全性
CONFIG_PACKAGE_procd-ujail=y        # 增强 procd 安全性
CONFIG_PACKAGE_uci=y                # 统一配置接口
CONFIG_PACKAGE_uclient-fetch=y      # URL 下载客户端
CONFIG_PACKAGE_urandom-seed=y       # 随机数种子
CONFIG_PACKAGE_urngd=y              # 随机数生成器守护进程

# LuCI (Web 界面 - 核心模块)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y # 完整的管理界面模块 (包含系统概览)
CONFIG_PACKAGE_luci-proto-ipv6=y     # LuCI IPv6 协议支持
CONFIG_PACKAGE_luci-proto-ppp=y      # LuCI PPP 协议支持 (PPPoE 等需要)
CONFIG_PACKAGE_luci-theme-bootstrap=y # 默认主题
CONFIG_LUCI_LANG_zh_Hans=y           # LuCI 中文语言包
CONFIG_PACKAGE_luci-app-firewall=y   # LuCI 防火墙界面
CONFIG_PACKAGE_luci-app-opkg=y       # LuCI 软件包管理器界面
CONFIG_PACKAGE_luci-ssl-openssl=y    # LuCI HTTPS 支持 (依赖 OpenSSL)

# 1. Shutdown (关机功能)
CONFIG_PACKAGE_luci-app-shutdown=y

# 2. Printer (打印机支持)
CONFIG_PACKAGE_kmod-usb-printer=y # USB 打印机内核模块
CONFIG_PACKAGE_p910nd=y           # 打印服务器后台
CONFIG_PACKAGE_luci-app-p910nd=y  # p910nd 的 LuCI 界面

# 3. USB Overlay (ext4) & Disk Management (U盘 Overlay 扩展及磁盘管理)
#    核心 USB 支持 (EHCI/XHCI for MT7621)
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y     # EHCI 控制器
CONFIG_PACKAGE_kmod-usb3=y     # XHCI 控制器
#    USB 存储驱动
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y # UAS 驱动，提高性能
#    文件系统支持
CONFIG_PACKAGE_kmod-fs-ext4=y # EXT4 文件系统内核模块
CONFIG_PACKAGE_e2fsprogs=y    # EXT4 文件系统用户空间工具 (mkfs.ext4, fsck.ext4)
#    块设备管理与 Overlay 基础
CONFIG_PACKAGE_block-mount=y # OpenWrt 块设备挂载管理工具 (Overlay 必需)
#    分区扩容与磁盘管理 LuCI 界面
CONFIG_PACKAGE_luci-app-partexp=y # 一键分区扩容挂载工具 (LuCI)
CONFIG_PACKAGE_luci-app-diskman=y # 磁盘管理界面 (LuCI)
CONFIG_PACKAGE_parted=y           # parted 分区工具 (依赖)
CONFIG_PACKAGE_lsblk=y            # 查看块设备工具 (依赖)
# CONFIG_PACKAGE_fdisk is not set # fdisk 通常不是必须的，parted 更常用

# 4. Network Acceleration (网络加速)
#    使用基于 Nftables 的硬件流卸载 (适用于官方 OpenWrt 21.02+)
CONFIG_PACKAGE_kmod-nft-offload=y
#    Flow Offload 配置界面 (官方推荐)
CONFIG_PACKAGE_luci-app-flowoffload=y
#    【冲突规避】确保未选择 SQM 或其他可能冲突的 QoS 包

# 5. File Management (文件管理 - 使用 Samba)
#    【大小优化】Samba4 较大，推荐在配置 Overlay 后通过 opkg 安装
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_samba4-server is not set
#    如果确实想内置，取消上面两行的注释，但会显著增大固件体积

# 6. Scientific Internet Access (科学上网 - OpenClash - 来自 kenzo/small 源)
CONFIG_PACKAGE_luci-app-openclash=y
#    OpenClash 核心依赖 (体积较大的 Clash 内核等应在 Overlay 后下载)
CONFIG_PACKAGE_coreutils=y # 基础工具集 (必须)
# CONFIG_PACKAGE_coreutils-nohup is not set # nohup 通常 busybox 自带或不必须
# CONFIG_PACKAGE_bash is not set # 尝试不依赖 bash，使用 ash
CONFIG_PACKAGE_curl=y # 或 wget-ssl (上面已选)
CONFIG_PACKAGE_dnsmasq-full=y #【冲突解决】明确选择 dnsmasq-full
# CONFIG_PACKAGE_dnsmasq is not set #【冲突解决】确保标准版未选
CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y # 兼容 iptables 命令操作 nftables
CONFIG_PACKAGE_kmod-tun=y # OpenClash TUN 模式需要
CONFIG_PACKAGE_libopenssl=y # OpenSSL 库 (很多包依赖)
#    (可选 TPROXY 模式依赖，如果需要)
# CONFIG_PACKAGE_kmod-ipt-tproxy=y
# CONFIG_PACKAGE_kmod-nft-tproxy=y

# 7. IPv6 Support Kernel Modules (其他 IPv6 内核模块)
CONFIG_PACKAGE_kmod-nf-conntrack6=y
# CONFIG_PACKAGE_kmod-nf-nat6 is not set # 默认不启用 IPv6 NAT，除非明确需要

# Wireless Drivers (无线驱动 - 使用官方开源 mt76)
CONFIG_PACKAGE_kmod-mt76=y # mt76 系列开源驱动元包
CONFIG_PACKAGE_wpad-openssl=y # 使用 OpenSSL 的 WPA Supplicant/Hostapd (包含 WPA3 支持)
# CONFIG_PACKAGE_wpad-basic-openssl is not set # 避免选择 basic 版本
# CONFIG_PACKAGE_wpad-mini is not set
#    【冲突解决】确保禁用冲突的驱动模块
# CONFIG_PACKAGE_kmod-mt7603e is not set
# CONFIG_PACKAGE_kmod-mt76x2e is not set
# CONFIG_PACKAGE_mt_wifi is not set
# CONFIG_PACKAGE_luci-app-mtwifi is not set

# Utilities (常用工具 - 精简)
# CONFIG_PACKAGE_htop is not set # htop 较大，可在需要时 opkg 安装
CONFIG_PACKAGE_nano=y # 编辑器
CONFIG_PACKAGE_usbutils=y # lsusb
