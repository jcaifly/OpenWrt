# OpenWrt Configuration (Optimized for Newifi D2 - Official Source + Custom Feeds)
# Build Date: 2025-04-09 (Example) - REMINDER: USB Overlay is MANDATORY!

#============================================================================
# Target System (目标系统)
#============================================================================
CONFIG_TARGET_ramips=y                          # 目标架构: ramips
CONFIG_TARGET_ramips_mt7621=y                   # 子目标 SoC: mt7621
CONFIG_TARGET_ramips_mt7621_DEVICE_newifi_d2=y  # 【关键】设备 Profile: Newifi D2 (官方名通常用下划线, 请在 menuconfig 中核对!)

#============================================================================
# Base System & Essential Tools (基础系统与必要工具)
#============================================================================
CONFIG_PACKAGE_base-files=y                     # 基础文件系统结构和脚本
CONFIG_PACKAGE_busybox=y                        # 核心 Linux 工具集 (已包含常用工具)
CONFIG_PACKAGE_ca-bundle=y                      # SSL 证书包
CONFIG_PACKAGE_ca-certificates=y                # 证书管理工具
CONFIG_PACKAGE_dropbear=y                       # 轻量级 SSH 服务器
CONFIG_PACKAGE_firewall4=y                      # 防火墙后端 (Nftables - OpenWrt 22.03+)
CONFIG_PACKAGE_fstools=y                        # 文件系统挂载/管理工具
CONFIG_PACKAGE_fwtool=y                         # 固件处理工具
CONFIG_PACKAGE_getrandom=y                      # getrandom 系统调用接口
CONFIG_PACKAGE_iptables-nft=y                   # iptables 命令兼容层 (重要依赖)
CONFIG_PACKAGE_ipset=y                          # IP 地址集合管理 (重要依赖)
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y       # GPIO 按键热插拔内核模块
CONFIG_PACKAGE_kmod-leds-gpio=y                 # GPIO 控制 LED 内核模块
CONFIG_PACKAGE_kmod-nft-core=y                  # Nftables 核心内核模块 (Firewall4 基础)
CONFIG_PACKAGE_kmod-nf-reject=y                 # Nftables REJECT 目标 (IPv4)
CONFIG_PACKAGE_kmod-nf-reject6=y                # Nftables REJECT 目标 (IPv6)
CONFIG_PACKAGE_libc=y                           # 标准 C 库
CONFIG_PACKAGE_libgcc=y                         # GCC 运行时库
CONFIG_PACKAGE_libpthread=y                     # POSIX 线程库
CONFIG_PACKAGE_librt=y                          # 实时库
CONFIG_PACKAGE_libstdcpp=y                      # 标准 C++ 库
CONFIG_PACKAGE_libopenssl=y                     # OpenSSL 核心库
CONFIG_PACKAGE_libustream-openssl=y             # ustream SSL/TLS 库 (使用 OpenSSL)
CONFIG_PACKAGE_libyaml=y                        # YAML 解析库 (OpenClash 依赖)
CONFIG_PACKAGE_logd=y                           # 系统日志守护进程
CONFIG_PACKAGE_mtd=y                            # MTD (闪存设备) 工具
CONFIG_PACKAGE_netifd=y                         # 网络接口守护进程
CONFIG_PACKAGE_opkg=y                           # 包管理器
CONFIG_PACKAGE_procd=y                          # 进程管理守护进程
CONFIG_PACKAGE_procd-ujail=y                    # Procd 沙箱支持
CONFIG_PACKAGE_uci=y                            # 统一配置接口
CONFIG_PACKAGE_ubus=y                           # 微型总线系统
CONFIG_PACKAGE_ubusd=y                          # ubus 守护进程
CONFIG_PACKAGE_uclient-fetch=y                  # URL 传输客户端 (wget/curl 替代品)
CONFIG_PACKAGE_urandom-seed=y                   # 随机数种子管理
CONFIG_PACKAGE_usign=y                          # 签名验证工具
CONFIG_PACKAGE_libcap=y                         # libcap 库 (OpenClash 依赖)
CONFIG_PACKAGE_libcap-bin=y                     # libcap 工具 (可选, 但方便调试)
CONFIG_PACKAGE_ruby=y                           # Ruby 解释器 (OpenClash 依赖)
CONFIG_PACKAGE_ruby-yaml=y                      # Ruby YAML 库 (OpenClash 依赖)

#============================================================================
# LuCI (Web 界面 - 默认主题 & 基础模块)
#============================================================================
CONFIG_PACKAGE_luci=y                           # LuCI 元包
CONFIG_PACKAGE_luci-base=y                      # LuCI 基础文件
CONFIG_PACKAGE_luci-mod-admin-full=y            # LuCI 完整管理界面 (含系统概览, 挂载点, 系统控制等)
CONFIG_PACKAGE_luci-theme-bootstrap=y           # LuCI 默认 Bootstrap 主题
CONFIG_LUCI_LANG_zh_Hans=y                      # LuCI 简体中文语言包
CONFIG_PACKAGE_luci-compat=y                    # LuCI 兼容包

#============================================================================
# Requested Functionality Packages (按需功能包)
#============================================================================

# 1. Shutdown/Reboot (关机/重启 - LuCI)
CONFIG_PACKAGE_luci-app-shutdown=y

# 2. USB Printer (USB 打印机 - 使用轻量级 p910nd)
CONFIG_PACKAGE_kmod-usb-core=y                  # USB 核心支持
CONFIG_PACKAGE_kmod-usb2=y                      # EHCI 控制器 (MT7621)
CONFIG_PACKAGE_kmod-usb3=y                      # XHCI 控制器 (MT7621)
CONFIG_PACKAGE_kmod-usb-printer=y               # USB 打印机内核模块
CONFIG_PACKAGE_p910nd=y                         # p910nd 打印服务器后台
CONFIG_PACKAGE_luci-app-p910nd=y                # p910nd 的 LuCI 界面

# 3. USB Overlay (ext4), Partition Expansion & Disk Management (U盘 Overlay, 分区扩容与磁盘管理)
CONFIG_PACKAGE_block-mount=y                    # 块设备挂载管理 (Overlay 必需)
CONFIG_PACKAGE_kmod-usb-storage=y               # USB 存储驱动
CONFIG_PACKAGE_kmod-usb-storage-uas=y           # UAS 协议驱动 (提高性能)
CONFIG_PACKAGE_kmod-fs-ext4=y                   # EXT4 文件系统内核模块
CONFIG_PACKAGE_e2fsprogs=y                      # EXT4 文件系统用户空间工具 (含 mkfs, fsck, resize2fs)
CONFIG_PACKAGE_parted=y                         # 分区工具 (partexp/diskman 依赖)
CONFIG_PACKAGE_lsblk=y                          # 列出块设备工具
CONFIG_PACKAGE_luci-app-partexp=y               # 【用户要求】一键分区扩容挂载工具 LuCI 界面
CONFIG_PACKAGE_luci-app-diskman=y               # 【用户要求】通用磁盘管理 LuCI 界面

# 4. Network Acceleration (网络加速 - 使用 Flow Offloading)
CONFIG_PACKAGE_luci-app-turboacc=y              # TurboACC LuCI 配置界面
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y # 明确选择 Offloading 集成
CONFIG_PACKAGE_kmod-nft-offload=y               # Nftables Flow Offloading 内核模块 (硬件加速)
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set # 禁用冲突的 Shortcut-FE

# 5. File Management (文件管理器 - LuCI & Samba 4)
CONFIG_PACKAGE_luci-app-filetransfer=y          # 简单的 LuCI 文件上传/下载界面
CONFIG_PACKAGE_luci-app-samba4=y                # Samba 4.x LuCI 界面 (网络文件共享)
CONFIG_PACKAGE_samba4-server=y                  # Samba 4.x 服务器核心包

# 6. Scientific Internet Access (科学上网 - OpenClash)
CONFIG_PACKAGE_luci-app-openclash=y             # OpenClash LuCI 界面 (来自 kenzo/small)
#    OpenClash 核心依赖
CONFIG_PACKAGE_coreutils-nohup=y                # nohup 命令
CONFIG_PACKAGE_bash=y                           # Bash shell
CONFIG_PACKAGE_curl=y                           # 网络传输工具
CONFIG_PACKAGE_dnsmasq-full=y                   # 完整版 dnsmasq (推荐)
# CONFIG_PACKAGE_dnsmasq is not set               #【补充】明确禁用基础版 dnsmasq
#    以下依赖通常已包含或会自动选择，但确保存在
#   CONFIG_PACKAGE_coreutils=y (已包含)
#   CONFIG_PACKAGE_libyaml=y (已包含)
#   CONFIG_PACKAGE_ipset=y (已包含)
#   CONFIG_PACKAGE_iptables-nft=y (已包含)
#   CONFIG_PACKAGE_libcap=y (已包含)
#   CONFIG_PACKAGE_libcap-bin=y (已包含)
#   CONFIG_PACKAGE_ruby=y (已包含)
#   CONFIG_PACKAGE_ruby-yaml=y (已包含)
#    (可选) 根据 OpenClash 使用模式可能需要
# CONFIG_PACKAGE_kmod-tun=y # TUN 模式需要
# CONFIG_PACKAGE_kmod-ipt-tproxy=y # TPROXY 模式需要

# 7. IPv6 Support (开启 IPv6)
CONFIG_IPV6=y                                   # 启用 IPv6 支持
CONFIG_KERNEL_IPV6=y                            # 启用内核 IPv6 支持
CONFIG_PACKAGE_odhcp6c=y                        # IPv6 DHCP 客户端
CONFIG_PACKAGE_ipv6helper=y                     # IPv6 辅助工具
CONFIG_PACKAGE_kmod-nf-conntrack6=y             # IPv6 连接跟踪内核模块
CONFIG_PACKAGE_kmod-nft-nat6=y                  # IPv6 NAT (Nftables) 内核模块
CONFIG_PACKAGE_dnsmasq-full_dhcpv6=y            # 启用 Dnsmasq-full 的 DHCPv6 功能

#============================================================================
# Wireless Drivers (无线驱动 - 使用官方开源 mt76)
#============================================================================
CONFIG_PACKAGE_kmod-mt76=y                      # mt76 开源驱动元包 (会自动选择 mt7603, mt76x2)
#   【关键】确保禁用冲突的驱动模块 (覆盖可能存在的默认值)
# CONFIG_PACKAGE_kmod-mt7603e is not set
# CONFIG_PACKAGE_kmod-mt76x2e is not set
# CONFIG_PACKAGE_mt_wifi is not set
# CONFIG_PACKAGE_luci-app-mtwifi is not set

#============================================================================
# Other Required LuCI Applications (其他必需的 LuCI 应用)
#============================================================================
CONFIG_PACKAGE_luci-app-firewall=y              # 防火墙 LuCI 界面 (Firewall4)
CONFIG_PACKAGE_luci-app-opkg=y                  # 软件包管理 LuCI 界面
CONFIG_PACKAGE_luci-app-upnp=y                  # UPnP LuCI 界面
CONFIG_PACKAGE_miniupnpd=y                      # UPnP 后台服务
CONFIG_PACKAGE_luci-app-ramfree=y               # 释放内存 LuCI 界面

#============================================================================
# Utilities (常用工具 - 保留基础)
#============================================================================
CONFIG_PACKAGE_htop=y                           # 进程查看器
CONFIG_PACKAGE_nano=y                           # 文本编辑器
CONFIG_PACKAGE_usbutils=y                       # USB 工具 (lsusb)

#============================================================================
# Build Options for Size Optimization (为减小体积进行的构建优化)
#============================================================================
CONFIG_STRIP_KERNEL_EXPORTS=y                   # 精简内核导出符号
CONFIG_USE_SSTRIP=y                             # 使用 sstrip 精简可执行文件和库
# CONFIG_PACKAGE_kmod-ikconfig is not set         # 移除内核配置导出模块
CONFIG_KERNEL_DEBUG_INFO=n                      # 禁用内核调试信息

#============================================================================
# Final Checks - Ensure known conflicting defaults are unset (保险措施)
#============================================================================
# CONFIG_DEFAULT_kmod-mt7603e is not set        # 覆盖可能的闭源驱动默认值
# CONFIG_DEFAULT_kmod-mt76x2e is not set        # 覆盖可能的闭源驱动默认值
# CONFIG_DEFAULT_luci-app-mtwifi is not set     # 覆盖可能的闭源驱动 LuCI 默认值
# CONFIG_DEFAULT_firewall is not set            # 确保不默认使用旧 firewall
#============================================================================

# End of Configuration
