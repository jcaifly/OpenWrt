# ========================================
# Target System Configuration
# ========================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ========================================
# Build Options - SquashFS Output
# ========================================
CONFIG_TARGET_IMAGES_squashfs=y                 # Build SquashFS images
CONFIG_TARGET_ROOTFS_SQUASHFS=y                # Use SquashFS for root filesystem
# CONFIG_TARGET_ROOTFS_TARGZ is not set        # Do not build tar.gz rootfs
CONFIG_TARGET_IMAGES_PAD=y                       # Pad images for flash alignment
CONFIG_TARGET_ROOTFS_PARTSIZE=128              # Rootfs partition size (MB) - 可根据需要调整为 256 或更大 (若空间允许)
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256          # SquashFS block size (256k from reference)

# ========================================
# Base system Packages
# ========================================
CONFIG_PACKAGE_base-files=y                   # Essential base system files
CONFIG_PACKAGE_busybox=y                      # Core utilities
CONFIG_PACKAGE_ca-bundle=y                    # Certificate Authority bundle (for HTTPS)
CONFIG_PACKAGE_ca-certificates=y              # CA certificates helper (often pulled by ca-bundle)
# --- DNS & DHCP ---
# CONFIG_PACKAGE_dnsmasq is not set             # *** CRITICAL: Disable standard dnsmasq ***
CONFIG_PACKAGE_dnsmasq-full=y                 # Enable dnsmasq-full for advanced features
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y          # Enable DHCPv6 support in dnsmasq-full
CONFIG_PACKAGE_dnsmasq_full_auth=y            # Enable DNS Auth support in dnsmasq-full (if needed)
CONFIG_PACKAGE_dnsmasq_full_dnssec=y          # Enable DNSSEC support in dnsmasq-full
CONFIG_PACKAGE_dnsmasq_full_conntrack=y       # Enable conntrack support in dnsmasq-full
# --- Firewall & Networking Core ---
CONFIG_PACKAGE_firewall4=y                    # Use Firewall4 (nftables based)
CONFIG_PACKAGE_iptables-nft=y                 # *** CRITICAL: iptables compatibility layer for nftables ***
CONFIG_PACKAGE_ipset=y                        # IP set utility (OpenClash dependency)
# --- Other Base essentials ---
CONFIG_PACKAGE_dropbear=y                     # SSH Server
CONFIG_PACKAGE_fstools=y                      # Filesystem utilities
CONFIG_PACKAGE_opkg=y                         # Package manager
CONFIG_PACKAGE_uci=y                          # Unified Configuration Interface
CONFIG_PACKAGE_rpcd=y                         # RPC daemon for LuCI
CONFIG_PACKAGE_ucode=y                        # ucode interpreter
CONFIG_PACKAGE_ucode-mod-fs=y                 # ucode filesystem module
CONFIG_PACKAGE_ucode-mod-ubus=y               # ucode ubus module
CONFIG_PACKAGE_ucode-mod-uloop=y              # ucode uloop module
CONFIG_PACKAGE_logd=y                         # System logger
CONFIG_PACKAGE_jsonfilter=y                   # JSON filter utility (LuCI dependency)

# ========================================
# IPv6 Support Configuration
# ========================================
CONFIG_IPV6=y                                 # Enable IPv6 in Kernel (usually default 'y')
CONFIG_PACKAGE_ipv6helper=y                   # IPv6 transition helper utilities
CONFIG_PACKAGE_odhcp6c=y                      # IPv6 client (for WAN)
CONFIG_PACKAGE_odhcpd-ipv6only=y              # IPv6 server/RA daemon (for LAN)
# Kernel modules for IPv6 with firewall4 (nftables)
CONFIG_PACKAGE_kmod-nf-conntrack6=y           # IPv6 connection tracking
CONFIG_PACKAGE_kmod-nf-nat6=y                 # IPv6 NAT (for nftables NAT6)
# Remove legacy ip6tables unless absolutely necessary for a specific package not covered by iptables-nft
# CONFIG_PACKAGE_ip6tables is not set
# CONFIG_PACKAGE_ip6tables-mod-nat is not set

# ========================================
# LuCI (Web Interface) Configuration
# ========================================
CONFIG_PACKAGE_luci=y                         # Build LuCI meta-package
CONFIG_PACKAGE_luci-base=y                    # LuCI core libraries
CONFIG_LUCI_LANG_zh_Hans=y                    # *** CRITICAL: Enable Chinese (Simplified) translation ***
# Themes
CONFIG_PACKAGE_luci-theme-bootstrap=y         # Default Bootstrap theme
# Core LuCI Applications
CONFIG_PACKAGE_luci-app-firewall=y            # LuCI for Firewall4
CONFIG_PACKAGE_luci-app-opkg=y                # LuCI Package Manager interface
# Requested LuCI Applications
CONFIG_PACKAGE_luci-app-openclash=y           # LuCI for OpenClash (from DIY script)
CONFIG_PACKAGE_luci-app-turboacc=y            # LuCI for Turbo ACC (from DIY script)
CONFIG_PACKAGE_luci-app-p910nd=y              # LuCI for USB Print Server (from DIY script)
CONFIG_PACKAGE_luci-app-poweroffdevice=y      # LuCI for Shutdown (from DIY script)
CONFIG_PACKAGE_luci-app-upnp=y                # LuCI for UPnP/NAT-PMP
# Additional Useful LuCI Applications (inspired by reference config)
CONFIG_PACKAGE_luci-app-ddns=y                # LuCI for Dynamic DNS (common requirement)
# CONFIG_PACKAGE_luci-app-ttyd=y              # Optional: Web Terminal access
# CONFIG_PACKAGE_luci-app-nlbwmon=y           # Optional: Network Bandwidth Monitor
# CONFIG_PACKAGE_luci-app-statistics=y        # Optional: System Statistics Visualization
# CONFIG_PACKAGE_luci-app-wol=y               # Optional: Wake-on-LAN

# ========================================
# Kernel Modules
# ========================================
# --- Filesystems ---
CONFIG_PACKAGE_kmod-fs-squashfs=y             # SquashFS filesystem support (needed for rootfs)
CONFIG_PACKAGE_block-mount=y                  # Automount block devices (for USB storage)
# --- Netfilter Core & Modules (nftables focus with iptables compat) ---
CONFIG_PACKAGE_kmod-nft-core=y                # nftables core
CONFIG_PACKAGE_kmod-nft-nat=y                 # nftables NAT support
CONFIG_PACKAGE_kmod-nft-offload=y             # nftables Hardware Flow Offload (TurboACC)
CONFIG_PACKAGE_kmod-nft-fullcone=y            # nftables FullCone NAT module (from DIY script)
CONFIG_PACKAGE_kmod-nf-conntrack=y            # IPv4 connection tracking
CONFIG_PACKAGE_kmod-nf-flow=y                 # Software Flow Offload base
# --- Netfilter iptables compatibility & necessary modules ---
CONFIG_PACKAGE_kmod-ipt-core=y                # iptables core API
CONFIG_PACKAGE_kmod-ipt-nat=y                 # iptables NAT module (needed by some tools/OpenClash)
CONFIG_PACKAGE_kmod-ipt-ipset=y               # iptables ipset support (OpenClash dependency)
CONFIG_PACKAGE_kmod-ipt-offload=y             # iptables Hardware Flow Offload (TurboACC)
CONFIG_PACKAGE_kmod-ipt-tproxy=y              # iptables TPROXY module (OpenClash transparent proxy dependency)
# --- UPnP / NAT Helpers ---
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y      # Extra NAT helpers (includes H.323, IRC, FTP, TFTP, Amanda, PPTP, SCTP, SIP, etc.)
# --- Networking ---
CONFIG_PACKAGE_kmod-tcp-bbr=y                 # TCP BBR congestion control
CONFIG_PACKAGE_kmod-tun=y                     # TUN/TAP device support (OpenClash)
# --- USB Support ---
CONFIG_PACKAGE_kmod-usb-core=y                # USB Core
CONFIG_PACKAGE_kmod-usb-ohci=y                # USB 1.1 OHCI
CONFIG_PACKAGE_kmod-usb-uhci=y                # USB 1.1 UHCI
CONFIG_PACKAGE_kmod-usb2=y                    # USB 2.0 EHCI
CONFIG_PACKAGE_kmod-usb3=y                    # USB 3.0 XHCI (Newifi D2 has USB3)
CONFIG_PACKAGE_kmod-usb-printer=y             # USB Printer driver
CONFIG_PACKAGE_kmod-usb-storage=y             # USB Storage support (enables using USB drives)
CONFIG_PACKAGE_kmod-usb-storage-extras=y      # Extra USB storage drivers (e.g., for card readers, UAS)
# --- Wireless Drivers (Newifi D2: MT7603E + MT7612E/MT76x2E) ---
CONFIG_PACKAGE_kmod-mt76-core=y               # Mediatek WiFi common core driver
CONFIG_PACKAGE_kmod-mt7603=y                  # Driver for MT7603 (2.4GHz)
CONFIG_PACKAGE_kmod-mt76x2=y                  # Driver for MT7612/MT76x2 (5GHz)
# Remove specific E versions if present, the main ones cover them
# CONFIG_PACKAGE_kmod-mt7603e is not set
# CONFIG_PACKAGE_kmod-mt76x2e is not set

# ========================================
# Libraries
# ========================================
CONFIG_PACKAGE_libopenssl=y                   # OpenSSL crypto library (can use wpad-openssl, dropbear uses this)
# CONFIG_PACKAGE_libmbedtls is not set         # Choose one crypto backend usually
CONFIG_PACKAGE_libpthread=y                   # POSIX Threads
CONFIG_PACKAGE_libyaml=y                      # YAML parser (OpenClash)
CONFIG_PACKAGE_libcap=y                       # POSIX Capabilities
CONFIG_PACKAGE_libmnl=y                       # Minimalistic Netlink library
CONFIG_PACKAGE_libnetsnmp=y                   # SNMP library (often pulled by monitoring tools)
CONFIG_PACKAGE_libpcre=y                      # Perl Compatible Regular Expressions library

# ========================================
# Network Utilities & Applications
# ========================================
CONFIG_PACKAGE_curl=y                         # URL transfer utility (OpenClash, DDNS need this)
CONFIG_PACKAGE_wget=y                         # URL transfer utility (alternative/fallback)
# CONFIG_PACKAGE_wget-ssl is not set          # Usually covered by wget + openssl/mbedtls build flag
CONFIG_PACKAGE_p910nd=y                       # USB Printer Daemon
CONFIG_PACKAGE_miniupnpd-nftables=y           # UPnP daemon using nftables backend (Dependency of luci-app-upnp with firewall4)
# Note: selecting luci-app-upnp usually correctly selects miniupnpd -> miniupnpd-nftables with firewall4. Explicitly adding this is fine.
CONFIG_PACKAGE_wireless-tools=y               # Basic wireless command-line tools (iwconfig, etc.)
CONFIG_PACKAGE_wpad-openssl=y                 # Full WPA Supplicant/Hostapd (using OpenSSL backend for better compat/performance)
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set # Ensure full version is selected

# ========================================
# Utilities
# ========================================
CONFIG_PACKAGE_bash=y                         # Bourne-Again SHell (OpenClash dependency)
CONFIG_PACKAGE_coreutils=y                    # GNU Core Utilities (full versions: ls, cp, etc.)
CONFIG_PACKAGE_coreutils-nohup=y              # nohup utility (OpenClash specific requirement)
CONFIG_PACKAGE_htop=y                         # Interactive process viewer
CONFIG_PACKAGE_iperf3=y                       # Network performance testing tool
CONFIG_PACKAGE_nano=y                         # Simple text editor (alternative to vi)
CONFIG_PACKAGE_ruby=y                         # Ruby interpreter (safer to include for OpenClash)
CONFIG_PACKAGE_tar=y                          # Tar archiving utility
CONFIG_PACKAGE_unzip=y                        # Unzip utility (OpenClash core updates etc)

# ========================================
# Ensure common base dependencies are included
# ========================================
CONFIG_LIBC_SUPPORT=y
CONFIG_LIBC_OPTIMIZATIONS=y

# ========================================
# Final Overrides & Disabled Packages
# ========================================
# Disable legacy firewall
# CONFIG_PACKAGE_firewall is not set
# Disable specific large apps not requested
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-unblockmusic is not set
# Disable potentially unwanted USB network drivers
# CONFIG_PACKAGE_kmod-usb-net is not set
# CONFIG_PACKAGE_kmod-usb-net-asix is not set
# CONFIG_PACKAGE_kmod-usb-net-rtl8152 is not set
