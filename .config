#=================================================
# Target Configuration
#=================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# Target Images
CONFIG_TARGET_SQUASHFS=y
CONFIG_TARGET_IMAGES_PAD=y

#=================================================
# Base system
#=================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y # 建议启用 HTTPS 访问 LuCI
CONFIG_PACKAGE_luci-app-firewall=y # Firewall4 的 LuCI 界面
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # LuCI 基础中文翻译

#=================================================
# Network
#=================================================
# Firewall (nftables)
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-fullcone=y # FullCone NAT for nftables

# IPv6 Support (通常默认选中部分, 确保完整)
CONFIG_IPV6=y
CONFIG_PACKAGE_kmod-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y # 通常与 odhcp6c 一起

# DNS (使用 dnsmasq-full 替换 dnsmasq)
CONFIG_PACKAGE_dnsmasq_full=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y # 启用 DHCPv6 支持
CONFIG_PACKAGE_dnsmasq_full_dnssec=y # 可选: 启用 DNSSEC 支持
# CONFIG_PACKAGE_dnsmasq is not set # 禁用标准版 dnsmasq

# UPnP / NAT-PMP (使用 nftables 版本)
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y # UPnP 服务 (nftables 版本)
# CONFIG_PACKAGE_miniupnpd is not set # 禁用 iptables 版本的 miniupnpd
CONFIG_PACKAGE_natpmpc=y # NAT-PMP 客户端库 (通常由 miniupnpd 依赖)

# Network Acceleration (TurboACC)
CONFIG_PACKAGE_luci-app-turboacc=y
# TurboACC 依赖内核 Flow Offloading
CONFIG_PACKAGE_kmod-nft-offload=y # 启用 Nftables Flow Offloading
# 可选: Shortcut FE (如果 TurboACC 仍然需要旧版加速或用于特定模式)
# CONFIG_PACKAGE_shortcut-fe=y
# CONFIG_PACKAGE_shortcut-fe-cm=y
# 根据 TurboACC 的具体实现和你的网络需求选择合适的加速模块

#=================================================
# Wireless Drivers (MT76 for Newifi D2)
#=================================================
# 这些通常由 Target Profile 自动选择，确认即可
CONFIG_PACKAGE_kmod-mt7603e=y
CONFIG_PACKAGE_kmod-mt76x2e=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y # 或 wpad-openssl / wpad-full，根据需求选择 WPA Supplicant
# CONFIG_PACKAGE_wpad-basic-openssl=y
# CONFIG_PACKAGE_wpad is not set

#=================================================
# USB Support
#=================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y # 检查 Newifi D2 是否需要 OHCI (通常是 USB 1.1)
CONFIG_PACKAGE_kmod-usb-uhci=y # 检查 Newifi D2 是否需要 UHCI (通常是 USB 1.1)
CONFIG_PACKAGE_kmod-usb2=y     # USB 2.0 支持
CONFIG_PACKAGE_kmod-usb3=y     # USB 3.0 支持 (Newifi D2 有 USB 3.0 接口)

# USB Printer Support
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y # Printer server daemon
CONFIG_PACKAGE_luci-app-p910nd=y # LuCI interface for p910nd

# (可选但推荐) USB Storage Support - 方便扩展或日志
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y # UAS 驱动提供更高性能
CONFIG_PACKAGE_kmod-fs-ext4=y # EXT4 文件系统支持
CONFIG_PACKAGE_kmod-fs-vfat=y # FAT32 文件系统支持
CONFIG_PACKAGE_kmod-fs-exfat=y # exFAT 文件系统支持 (可能需要额外包)
CONFIG_PACKAGE_block-mount=y # 自动挂载工具

#=================================================
# Custom Applications from diy-part1.sh
#=================================================
CONFIG_PACKAGE_luci-app-openclash=y
# OpenClash 依赖项 (部分可能需要手动确认选中, 但通常会被自动依赖选中)
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y # nftables 模式下的 iptables 兼容层
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_UnblockNeteaseMusic-Go=y # OpenClash 可能需要这个作为内置功能依赖
# GeoIP/GeoSite 数据 (OpenClash 运行时下载，但有时编译期加入可加速首次启动)
CONFIG_PACKAGE_geoip-database=y
CONFIG_PACKAGE_geosite-database=y

CONFIG_PACKAGE_luci-app-poweroffdevice=y

#=================================================
# LuCI Application Translations (确保选中应用的中文翻译)
#=================================================
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

#=================================================
# Utilities (推荐)
#=================================================
CONFIG_PACKAGE_htop=y   # 进程查看器
CONFIG_PACKAGE_nano=y   # 简单文本编辑器 (或者 `vim-fuller`)
# CONFIG_PACKAGE_vim-fuller=y

#=================================================
# Security Considerations (默认值通常是合理的起点)
#=================================================
# 确保 Dropbear (SSH Server) 是选中的 (默认)
CONFIG_PACKAGE_dropbear=y
# 考虑禁用或限制从 WAN 口访问 SSH 和 LuCI (在运行时配置)

#=================================================
# Final Checks
#=================================================
# 确保没有同时选中 CONFIG_PACKAGE_dnsmasq 和 CONFIG_PACKAGE_dnsmasq_full
# 确保没有同时选中 CONFIG_PACKAGE_miniupnpd 和 CONFIG_PACKAGE_miniupnpd-nftables
# 确保所有选择的 LuCI App 都有对应的 i18n 包被选中 (如果需要中文界面)
