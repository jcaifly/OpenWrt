# ==============================================================================
# OpenWrt .config 配置文件 (极简版)
# 适用于 Newifi 3 (D2) 路由器，基于 lede 分支
# 核心功能: OpenClash 和 关机功能 (poweroffdevice)
# ==============================================================================

# 1. 基本目标和设备配置
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# 固件格式和压缩
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ==============================================================================
# 2. 基础网络配置 (保持系统可用的最低要求)
# ==============================================================================

# IPv6 支持
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# Firewall4 (现代 OpenWrt 默认的 nftables 防火墙)
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_iptables-nft=y # iptables 兼容层，OpenClash 可能需要
CONFIG_PACKAGE_kmod-nft-fullcone=y

# DNS & DHCP (使用默认的 dnsmasq)
CONFIG_PACKAGE_dnsmasq=y

# ==============================================================================
# 3. LuCI 网页界面 (管理路由器的基础)
# ==============================================================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-proto-ppp=y      # PPPoE 拨号支持
CONFIG_PACKAGE_luci-proto-ipv6=y     # LuCI 的 IPv6 支持
CONFIG_PACKAGE_luci-app-firewall=y   # Firewall4 的 LuCI 界面
CONFIG_PACKAGE_luci-theme-bootstrap=y # 默认主题

# 中文语言包
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ==============================================================================
# 4. 添加的核心应用
# ==============================================================================

# 关机功能 (使用 poweroffdevice)
CONFIG_PACKAGE_luci-app-poweroffdevice=y
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y

# OpenClash
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y

# OpenClash 的核心依赖项
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y

# ==============================================================================
# 5. 系统核心组件和驱动
# ==============================================================================

# Newifi 3 (D2) 无线驱动
CONFIG_PACKAGE_kmod-mt7603=y # 2.4G Wi-Fi
CONFIG_PACKAGE_kmod-mt76x2=y  # 5G Wi-Fi

# USB 支持 (基础模块，用于外接U盘等)
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb2=y
# CONFIG_PACKAGE_kmod-usb3=y # 如果你的 D2 USB 3.0 工作正常，可以启用

# ==============================================================================
# 最终说明
#
# 1. 此配置文件非常精简，仅包含能让路由器和 OpenClash 正常运行的最小组件。
# 2. 将此文件命名为 .config 并放置在 OpenWrt 源码根目录。
# 3. 运行 `make defconfig` 来自动检查依赖并补全配置。
# 4. 运行 `make menuconfig` 进行二次确认或微调。
# 5. 最后执行 `make -j$(nproc) download && make -j$(nproc) V=s` 开始编译。
# ==============================================================================
