# ==================================================
# 目标系统配置 (Target System)
# ==================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ==================================================
# 目标镜像格式 (Target Images)
# ==================================================
CONFIG_TARGET_IMAGES_SQUASHFS=y   # 启用 SquashFS sysupgrade 格式
# CONFIG_TARGET_IMAGES_GZIP is not set # 使用默认压缩
# CONFIG_TARGET_IMAGES_INITRAMFS=n # 不需要 initramfs

# ==================================================
# 基本系统组件 (Base System)
# ==================================================
CONFIG_PACKAGE_block-mount=y           # 挂载点管理
CONFIG_PACKAGE_ca-certificates=y       # SSL 证书
CONFIG_PACKAGE_coreutils=y             # 核心工具集
CONFIG_PACKAGE_coreutils-nohup=y       # nohup 命令 (OpenClash)
CONFIG_PACKAGE_dropbear=y              # SSH 服务器
CONFIG_PACKAGE_firewall4=y             # nftables 防火墙
CONFIG_PACKAGE_fstools=y               # 文件系统工具 (含 blkid)
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y # GPIO 按键
CONFIG_PACKAGE_kmod-leds-gpio=y        # GPIO LED
CONFIG_PACKAGE_kmod-mt7603=y           # 2.4GHz WiFi 驱动 (关键)
# CONFIG_PACKAGE_kmod-mt7603e is not set # **显式禁用冲突包**
CONFIG_PACKAGE_kmod-mt76x2=y           # 5GHz WiFi 驱动
# CONFIG_PACKAGE_logd is not set       # 使用 BusyBox 内建日志
CONFIG_PACKAGE_mtd=y                   # Flash 读写
CONFIG_PACKAGE_netifd=y                # 网络接口管理
CONFIG_PACKAGE_odhcp6c=y               # IPv6 客户端
CONFIG_PACKAGE_odhcpd-ipv6only=y       # IPv6 服务器
CONFIG_PACKAGE_opkg=y                  # 包管理器
CONFIG_PACKAGE_ppp=y                   # PPPoE 基础
CONFIG_PACKAGE_kmod-ppp=y              # PPPoE 内核模块
CONFIG_PACKAGE_ppp-mod-pppoe=y         # PPPoE 协议
CONFIG_PACKAGE_rpcd=y                  # LuCI RPC
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode=y                 # ucode 解释器
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-http=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-process=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_uci=y                   # UCI 工具
CONFIG_PACKAGE_uclient-fetch=y         # 下载工具
CONFIG_PACKAGE_urandom-seed=y          # 随机数种子
CONFIG_PACKAGE_urngd=y                 # 随机数生成器

# ==================================================
# 无线网络安全 (Wireless Security)
# ==================================================
CONFIG_PACKAGE_wpad-basic-mbedtls=y     # wpad (mbedtls)
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-mini is not set

# ==================================================
# DHCP 和 DNS 服务器
# ==================================================
# CONFIG_PACKAGE_dnsmasq is not set     # **禁用基础版**
# CONFIG_PACKAGE_dnsmasq-base is not set # **禁用基础版**
CONFIG_PACKAGE_dnsmasq-full=y         # **启用完整版** (OpenClash)
CONFIG_PACKAGE_libnetfilter-conntrack=y # 依赖
CONFIG_PACKAGE_libnettle=y            # 依赖

# ==================================================
# LuCI Web 用户界面 (Web User Interface)
# ==================================================
CONFIG_PACKAGE_luci=y                    # LuCI 元包
CONFIG_PACKAGE_luci-base=y               # LuCI 基础
CONFIG_PACKAGE_luci-compat=y             # LuCI 兼容层
# --- 核心模块 ---
CONFIG_PACKAGE_luci-mod-admin-full=y     # 管理菜单
CONFIG_PACKAGE_luci-mod-network=y        # 网络菜单
CONFIG_PACKAGE_luci-mod-status=y         # 状态菜单 (含系统概览)
CONFIG_PACKAGE_luci-mod-system=y         # 系统菜单 (含挂载点)
# --- 协议支持 ---
CONFIG_PACKAGE_luci-proto-ipv6=y         # IPv6
CONFIG_PACKAGE_luci-proto-ppp=y          # PPPoE
# --- 核心应用 ---
CONFIG_PACKAGE_luci-app-firewall=y       # 防火墙界面
CONFIG_PACKAGE_luci-app-opkg=y           # 包管理界面
# --- 用户指定应用 ---
CONFIG_PACKAGE_luci-app-openclash=y      # OpenClash
CONFIG_PACKAGE_luci-app-partexp=y        # 一键分区扩容
CONFIG_PACKAGE_luci-app-p910nd=y         # USB 打印服务器
CONFIG_PACKAGE_luci-app-shutdown=y       # 关机
CONFIG_PACKAGE_luci-app-turboacc=y       # Turbo ACC

# ==================================================
# LuCI 主题 (Theme)
# ==================================================
CONFIG_PACKAGE_luci-theme-bootstrap=y    # 默认主题

# ==================================================
# LuCI 国际化语言包 (Internationalization - i18n)
# ==================================================
CONFIG_LUCI_LANG_zh_Hans=y                # 启用简体中文 (元包)
# --- 各模块中文包 ---
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-shutdown-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
# CONFIG_LUCI_SRCDIET is not set # 启用 i18n 时通常不开启 diet

# ==================================================
# 网络相关工具和库 (Networking)
# ==================================================
CONFIG_PACKAGE_curl=y                 # OpenClash 需要
CONFIG_PACKAGE_ip-full=y              # OpenClash/策略路由 需要
CONFIG_PACKAGE_ipset=y                # OpenClash 需要
CONFIG_PACKAGE_iptables-nft=y         # OpenClash 需要 (iptables 兼容层)
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_libyaml=y              # OpenClash 需要 (YAML 解析)
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_libnl-tiny=y
CONFIG_PACKAGE_libpcre=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_wget-ssl=y

# ==================================================
# 内核模块 (Kernel Modules)
# ==================================================
# --- 网络 ---
CONFIG_PACKAGE_kmod-ifb=y             # QoS/TurboACC
CONFIG_PACKAGE_kmod-ipt-core=y        # iptables 兼容
CONFIG_PACKAGE_kmod-ipt-ipset=y       # ipset 内核
CONFIG_PACKAGE_kmod-ipt-nat=y         # iptables NAT 兼容
CONFIG_PACKAGE_kmod-ipv6=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y
CONFIG_PACKAGE_kmod-nf-flow=y         # TurboACC (Flow Offload)
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-reject=y
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y     # TurboACC (nftables HW Offload)
CONFIG_PACKAGE_kmod-sched-core=y      # QoS/TurboACC
CONFIG_PACKAGE_kmod-tun=y             # OpenClash (TUN 模式)
# --- USB ---
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ehci=y        # USB 2.0
CONFIG_PACKAGE_kmod-usb-ohci=y        # USB 1.1
CONFIG_PACKAGE_kmod-usb-printer=y     # USB 打印
CONFIG_PACKAGE_kmod-usb-storage=y     # USB 存储
CONFIG_PACKAGE_kmod-usb-storage-uas=y # UAS 加速
CONFIG_PACKAGE_kmod-usb-uhci=y        # USB 1.1
CONFIG_PACKAGE_kmod-usb2=y            # 别名
CONFIG_PACKAGE_kmod-usb3=y            # USB 3.0
# --- 文件系统 ---
CONFIG_PACKAGE_kmod-fs-ext4=y         # EXT4
CONFIG_PACKAGE_kmod-fs-vfat=y         # FAT32
# CONFIG_PACKAGE_kmod-fs-exfat is not set
# CONFIG_PACKAGE_kmod-fs-ntfs3 is not set
# --- NLS ---
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y        # UTF-8

# ==================================================
# 必要的共享库 (Libraries)
# ==================================================
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libblkid=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libext2fs=y
CONFIG_PACKAGE_libfdisk=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libgmp=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libparted=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libsmartcols=y
CONFIG_PACKAGE_libss=y
CONFIG_PACKAGE_libubox=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_libuclient=y
CONFIG_PACKAGE_libucode=y
CONFIG_PACKAGE_libuuid=y
CONFIG_PACKAGE_libz=y
CONFIG_PACKAGE_zlib=y

# ==================================================
# 实用工具 (Utilities)
# ==================================================
CONFIG_PACKAGE_e2fsprogs=y            # EXT4 工具 (mkfs, fsck)
CONFIG_PACKAGE_fdisk=y                # MBR 分区 (partexp)
# CONFIG_PACKAGE_htop=n               # 不选 htop
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-ping6=y
CONFIG_PACKAGE_lsblk=y                # 列出块设备
# CONFIG_PACKAGE_nano=n               # 不选 nano
CONFIG_PACKAGE_parted=y               # GPT/MBR 分区 (partexp)
CONFIG_PACKAGE_p910nd=y               # 打印服务器
CONFIG_PACKAGE_usbutils=y             # lsusb

# ==================================================
# 构建与内核优化 (Build & Kernel Optimizations)
# ==================================================
CONFIG_PACKAGE_kmod-ikconfig=n              # 不含内核配置
CONFIG_STRIP_PACKAGES=y                   # 剥离符号
# --- 内核调试 (禁用) ---
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_DEBUG_INFO is not set       # **禁用调试信息**
# CONFIG_KERNEL_DEBUG_KERNEL is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_PROFILING is not set
# CONFIG_KERNEL_SWAP is not set             # **禁用 Swap**
