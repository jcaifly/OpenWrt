# 架构
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_newifi-d2=y

# 基本系统
CONFIG_BASE_SYSTEM=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-mt7603=y # 如果 Newifi 3 使用 MT7603 无线
CONFIG_PACKAGE_kmod-mt7615e=y # 如果 Newifi 3 使用 MT7615e 无线
CONFIG_PACKAGE_kmod-mt7621-pci=y
CONFIG_PACKAGE_kmod-mt7915e=y # 如果 Newifi 3 使用 MT7915e 无线
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_uci-default-network=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

# LuCI 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # 中文界面
CONFIG_PACKAGE_luci-theme-bootstrap=y # 默认主题

# LuCI 应用 - 核心功能
CONFIG_PACKAGE_luci-app-firewall4=y # 防火墙
CONFIG_PACKAGE_luci-app-opkg=y # 软件包管理
CONFIG_PACKAGE_luci-app-status=y # 实时信息 (状态总览)
CONFIG_PACKAGE_luci-app-system=y # 系统管理
CONFIG_PACKAGE_luci-app-advanced-reboot=y # 关机/重启
CONFIG_PACKAGE_luci-app-upnp=y # UPnP
CONFIG_PACKAGE_miniupnpd=y # UPnP 服务端

# LuCI 应用 - USB 和存储
CONFIG_PACKAGE_block-mount=y # 挂载点支持
CONFIG_PACKAGE_luci-app-mountd=y # 挂载点 LuCI 管理界面
CONFIG_PACKAGE_luci-app-diskman=y # 磁盘管理 (来自 small 软件源)
CONFIG_PACKAGE_kmod-usb-storage=y # USB 存储核心支持
CONFIG_PACKAGE_kmod-usb-storage-uas=y # USB Attached SCSI (UAS) 支持 (高性能 USB 存储)
CONFIG_PACKAGE_kmod-fs-ext4=y # EXT4 文件系统支持 (常用 Linux 文件系统)
CONFIG_PACKAGE_kmod-fs-vfat=y # FAT32 文件系统支持 (Windows 常用文件系统)
CONFIG_PACKAGE_kmod-fs-ntfs=y # NTFS 文件系统支持 (Windows 常用文件系统)
CONFIG_PACKAGE_ntfs-3g=y  # NTFS 用户空间工具，提供读写支持

# LuCI 应用 - USB 打印服务器
CONFIG_PACKAGE_luci-app-p9100d=y # 打印服务器 LuCI 管理界面
CONFIG_PACKAGE_p9100d=y # 打印服务器核心

# LuCI 应用 - 网络加速
CONFIG_PACKAGE_luci-app-turboacc=y # Turbo ACC LuCI 管理界面 (来自 kenzo 软件源)
CONFIG_PACKAGE_kmod-turboacc=y # Turbo ACC 内核模块 (来自 kenzo 软件源)
CONFIG_PACKAGE_kmod-fast-classifier=y # Turbo ACC 依赖
CONFIG_PACKAGE_kmod-natflow=y # Turbo ACC 依赖
CONFIG_PACKAGE_kmod-shortcut-fe=y # Turbo ACC 依赖

# LuCI 应用 - 文件管理器
CONFIG_PACKAGE_luci-app-filetransfer=y # 文件管理器

# LuCI 应用 - OpenClash
CONFIG_PACKAGE_luci-app-openclash=y # OpenClash LuCI 管理界面 (来自 kenzo 软件源)
CONFIG_PACKAGE_openclash=y # OpenClash 核心 (来自 kenzo 软件源，如果需要，通常 luci-app 会自动依赖)

# IPv6 支持
CONFIG_PACKAGE_kmod-ipv6=y
CONFIG_PACKAGE_ip6tables-nft=y # IPv6 防火墙 (nftables 版本，推荐)
CONFIG_PACKAGE_luci-proto-ipv6=y # LuCI IPv6 协议支持
CONFIG_PACKAGE_odhcp6c=y # DHCPv6 客户端
CONFIG_PACKAGE_radvd=y # Router Advertisement Daemon (路由通告守护进程)

# 工具
CONFIG_PACKAGE_bash=y # 命令行工具 (可选，如果需要更强大的 shell)
CONFIG_PACKAGE_vim=y  # 文本编辑器 (可选，如果习惯使用 vim)
CONFIG_PACKAGE_wget=y # 下载工具

# 去掉 IPv6 默认防火墙规则 (如果需要 IPv6 完全开放，请谨慎操作)
# CONFIG_PACKAGE_firewall4-nftables-extra-rules=n

# SSL 支持 (某些 LuCI 应用可能需要)
CONFIG_PACKAGE_libustream-openssl=y # 推荐使用 openssl

# 额外内核模块 (可选，根据实际需求添加)
# CONFIG_PACKAGE_kmod-usb-serial=y # USB 串口支持 (如果需要 USB 转串口功能)
# CONFIG_PACKAGE_kmod-usb-serial-cp210x=y # CP210x USB 串口芯片驱动
# CONFIG_PACKAGE_kmod-usb-serial-ftdi=y # FTDI USB 串口芯片驱动
# CONFIG_PACKAGE_kmod-usb-serial-ch341=y # CH341 USB 串口芯片驱动
