# Target System
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# Target Images
CONFIG_TARGET_IMAGES_SQUASHFS=y   # Ensure SquashFS is selected for sysupgrade.bin
# CONFIG_TARGET_IMAGES_GZIP is not set # SquashFS is usually default compression
# CONFIG_TARGET_IMAGES_INITRAMFS is not set # Not needed for standard installs

# Global build settings - Defaults are usually fine
# CONFIG_STRIP_KERNEL_EXPORTS is not set # Keep exports for module compatibility
# CONFIG_USE_MKLIBS is not set          # Don't build mklias trampoline by default

# Base system
CONFIG_PACKAGE_bash=n # Use ash (default from busybox), save space
CONFIG_PACKAGE_block-mount=y # Essential for Mount Points / Disk Management
# CONFIG_PACKAGE_ca-bundle is not set # Let dependencies (like curl) pull ca-certificates if needed
CONFIG_PACKAGE_ca-certificates=y # Needed by curl/wget-ssl, OpenClash connection
CONFIG_PACKAGE_coreutils=y # Required by OpenClash and other scripts
CONFIG_PACKAGE_coreutils-nohup=y # Required by OpenClash
CONFIG_PACKAGE_dropbear=y # SSH Server
CONFIG_PACKAGE_firewall4=y # nftables-based firewall (OpenWrt 22.03+)
CONFIG_PACKAGE_fstools=y # Filesystem utilities (includes blkid)
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y # Support for physical buttons
CONFIG_PACKAGE_kmod-leds-gpio=y # Support for GPIO controlled LEDs
CONFIG_PACKAGE_kmod-mt7603=y # 2.4GHz WiFi Driver for MT7621
CONFIG_PACKAGE_kmod-mt76x2=y # 5GHz WiFi Driver for MT7621
# CONFIG_PACKAGE_logd is not set # Use default busybox logging, save space
CONFIG_PACKAGE_mtd=y # Flash memory utility
CONFIG_PACKAGE_netifd=y # Network interface daemon
CONFIG_PACKAGE_odhcp6c=y # IPv6 client (DHCPv6/RA)
CONFIG_PACKAGE_odhcpd-ipv6only=y # Lightweight IPv6 RA/DHCPv6 server
CONFIG_PACKAGE_opkg=y # Package manager
CONFIG_PACKAGE_ppp=y # Base package for PPP protocols
CONFIG_PACKAGE_kmod-ppp=y # Kernel module for PPP
CONFIG_PACKAGE_ppp-mod-pppoe=y # PPPoE support (Common WAN type)
CONFIG_PACKAGE_rpcd=y # LuCI backend dependency
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode=y           # ucode interpreter (LuCI dependency)
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-http=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-process=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_uci=y # Unified Configuration Interface
CONFIG_PACKAGE_uclient-fetch=y # Lightweight download utility (wget/curl alternative)
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y # Random number generator daemon

# Wireless security - Using mbedtls variant for smaller size
# CONFIG_PACKAGE_wpad-basic is not set # Old wpad variant
# CONFIG_PACKAGE_wpad-mini is not set # Too minimal for some cases
CONFIG_PACKAGE_wpad-basic-mbedtls=y
# CONFIG_PACKAGE_wpad-openssl is not set # Larger variant
# CONFIG_PACKAGE_wpad is not set        # Full variant, largest

# LuCI - Core & Modules
CONFIG_PACKAGE_luci=y # Enable LuCI Meta package
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y # For compatibility with older LuCI apps if needed
CONFIG_PACKAGE_luci-mod-admin-full=y # Full admin pages
CONFIG_PACKAGE_luci-mod-network=y   # Network config pages
CONFIG_PACKAGE_luci-mod-status=y    # Status pages (includes System Overview)
CONFIG_PACKAGE_luci-mod-system=y    # System config pages (includes Startup, Mount Points)
CONFIG_PACKAGE_luci-app-firewall=y # LuCI interface for firewall4
CONFIG_PACKAGE_luci-app-opkg=y # LuCI interface for package management
CONFIG_PACKAGE_luci-proto-ipv6=y # LuCI support for IPv6 configuration
CONFIG_PACKAGE_luci-proto-ppp=y # LuCI support for PPP configurations (PPPoE)

# LuCI - Theme (Default)
CONFIG_PACKAGE_luci-theme-bootstrap=y # Default OpenWrt theme
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set # Old theme
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set

# LuCI - Applications (Requested Features)
CONFIG_PACKAGE_luci-app-openclash=y   # OpenClash App (will pull many dependencies)
CONFIG_PACKAGE_luci-app-partexp=y     # Partition Expand Tool (will pull parted, fdisk)
CONFIG_PACKAGE_luci-app-p910nd=y      # USB Printer Server App (will pull p910nd)
CONFIG_PACKAGE_luci-app-shutdown=y    # LuCI Shutdown menu item
CONFIG_PACKAGE_luci-app-turboacc=y    # Turbo ACC Acceleration (check dependencies, usually pulls kmod-nft-offload)

# DHCP / DNS (Crucial: Use dnsmasq-full, avoid conflicts)
# CONFIG_PACKAGE_dnsmasq is not set # Explicitly disable standard dnsmasq (often default in base)
CONFIG_PACKAGE_dnsmasq-full=y     # Select the full version (needed for OpenClash features like custom upstream)
# CONFIG_PACKAGE_dnsmasq-base is not set # Explicitly disable base version (name used in some newer versions)

# Networking Libraries and Utilities
CONFIG_PACKAGE_curl=y               # Required by OpenClash
CONFIG_PACKAGE_ip-full=y            # Full `ip` command, OpenClash may need it
CONFIG_PACKAGE_ipset=y              # Required by OpenClash
CONFIG_PACKAGE_iptables-nft=y       # Provides iptables command compatibility layer using nftables backend (Needed by OpenClash even with firewall4)
CONFIG_PACKAGE_libcurl=y            # Curl library
CONFIG_PACKAGE_libipset=y           # ipset library
CONFIG_PACKAGE_libyaml=y            # Required by OpenClash for config parsing
CONFIG_PACKAGE_libnetfilter-conntrack=y # Dependency for dnsmasq-full/ipset
CONFIG_PACKAGE_libnfnetlink=y       # Dependency for dnsmasq-full/ipset
CONFIG_PACKAGE_libnftnl=y           # nftables library used by firewall4 and others
CONFIG_PACKAGE_libnl-tiny=y         # Minimal netlink library
CONFIG_PACKAGE_libpcre=y            # Perl Compatible Regular Expressions (dependency for some packages)

# Kernel Modules - Networking Support
CONFIG_PACKAGE_kmod-ifb=y           # Required by some QoS/TurboACC modes
CONFIG_PACKAGE_kmod-ipt-core=y      # Core iptables kernel modules (needed for iptables-nft compatibility)
CONFIG_PACKAGE_kmod-ipt-ipset=y     # Kernel support for ipset (OpenClash)
CONFIG_PACKAGE_kmod-ipt-nat=y       # NAT kernel modules for iptables (needed by OpenClash/iptables-nft)
CONFIG_PACKAGE_kmod-ipv6=y          # IPv6 Support
CONFIG_PACKAGE_kmod-nf-conntrack=y  # Netfilter connection tracking (base for NAT/Firewall)
CONFIG_PACKAGE_kmod-nf-conntrack6=y # IPv6 connection tracking
CONFIG_PACKAGE_kmod-nf-flow=y       # Kernel Flow Offloading base
CONFIG_PACKAGE_kmod-nf-nat=y        # Netfilter NAT helpers (needed for firewall/NAT)
CONFIG_PACKAGE_kmod-nf-reject=y     # Packet rejection (firewall)
CONFIG_PACKAGE_kmod-nf-reject6=y    # IPv6 Packet rejection
CONFIG_PACKAGE_kmod-nfnetlink=y     # Netfilter Netlink interface
CONFIG_PACKAGE_kmod-nft-core=y      # nftables core support
CONFIG_PACKAGE_kmod-nft-nat=y       # nftables NAT support
CONFIG_PACKAGE_kmod-nft-offload=y   # nftables hardware/software offload (for TurboACC HW acceleration on MT7621)
CONFIG_PACKAGE_kmod-sched-core=y    # Kernel scheduler core (QoS/TurboACC)
CONFIG_PACKAGE_kmod-tcp-bbr=y       # Optional: TCP BBR congestion control (can improve throughput)
CONFIG_PACKAGE_kmod-tun=y           # TUN/TAP device support (Required by OpenClash)

# Kernel Modules - USB Support (Printer and Storage)
CONFIG_PACKAGE_kmod-usb-core=y      # Core USB support
CONFIG_PACKAGE_kmod-usb-ehci=y      # USB 2.0 Controller Support
CONFIG_PACKAGE_kmod-usb-ohci=y      # USB 1.1 OHCI Controller Support (for compatibility)
CONFIG_PACKAGE_kmod-usb-printer=y   # USB Printer class support
CONFIG_PACKAGE_kmod-usb-storage=y   # USB Storage class support
CONFIG_PACKAGE_kmod-usb-storage-uas=y # USB Attached SCSI Protocol support (often faster)
CONFIG_PACKAGE_kmod-usb-uhci=y      # USB 1.1 UHCI Controller Support (for compatibility)
CONFIG_PACKAGE_kmod-usb2=y          # Alias for kmod-usb-ehci
CONFIG_PACKAGE_kmod-usb3=y          # USB 3.0 XHCI Controller Support (Newifi D2 has USB3)

# Kernel Modules - Filesystems (For USB Storage)
CONFIG_PACKAGE_kmod-fs-ext4=y       # EXT4 filesystem support (Common Linux FS)
CONFIG_PACKAGE_kmod-fs-vfat=y       # FAT/FAT32 filesystem support (Common for USB drives)
# CONFIG_PACKAGE_kmod-fs-exfat is not set # Keep size down, add if needed
# CONFIG_PACKAGE_kmod-fs-ntfs3 is not set # Modern NTFS driver, larger, add if needed
CONFIG_PACKAGE_kmod-nls-base=y      # Native Language Support base
CONFIG_PACKAGE_kmod-nls-cp437=y     # NLS Codepage 437 (Common for FAT)
CONFIG_PACKAGE_kmod-nls-iso8859-1=y # NLS ISO8859-1 Latin 1
CONFIG_PACKAGE_kmod-nls-utf8=y      # NLS UTF8 (Recommended for modern use)

# Libraries
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libblkid=y           # For block device identification (fstools dep)
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libelf=y             # BPF dep potentially
CONFIG_PACKAGE_libext2fs=y          # For e2fsprogs
CONFIG_PACKAGE_libfdisk=y           # For fdisk util
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libgmp=y             # Dependency for nettle/OpenSSL
CONFIG_PACKAGE_libiwinfo=y          # Wireless info library
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_libmbedtls=y         # Crypto library used by wpad-basic-mbedtls
CONFIG_PACKAGE_libmnl=y             # Minimal Netlink library (dep for ipset)
CONFIG_PACKAGE_libncurses=y         # For terminal apps like htop (if added)
CONFIG_PACKAGE_libnettle=y          # Crypto library (dnsmasq-full dep)
CONFIG_PACKAGE_libopenssl=y         # Needed by various packages including curl sometimes
CONFIG_PACKAGE_libparted=y          # For parted util
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libsmartcols=y       # For utils like lsblk
CONFIG_PACKAGE_libss=y              # For e2fsprogs
CONFIG_PACKAGE_libubox=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_libuclient=y
CONFIG_PACKAGE_libucode=y
CONFIG_PACKAGE_libuuid=y            # For block utils
CONFIG_PACKAGE_libz=y
CONFIG_PACKAGE_zlib=y               # Compression library

# Utilities
CONFIG_PACKAGE_e2fsprogs=y          # EXT2/3/4 filesystem utilities (mkfs.ext4, fsck.ext4)
CONFIG_PACKAGE_fdisk=y              # Partition editor (partexp dep)
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-ping6=y
CONFIG_PACKAGE_kmod-bpf-resolve-offload=n # Disable BPF offload unless specifically needed
CONFIG_PACKAGE_lsblk=y              # List block devices (useful for disk mgmt)
# CONFIG_PACKAGE_nano is not set        # Text editor, adds size, use vi from busybox if needed
CONFIG_PACKAGE_parted=y             # Partition editor (partexp dep)
CONFIG_PACKAGE_p910nd=y             # Printer daemon (luci-app-p910nd dep)
CONFIG_PACKAGE_resolveip=y          # Utility to resolve hostnames (often included in busybox now)
CONFIG_PACKAGE_usbutils=y           # USB utilities (lsusb)
CONFIG_PACKAGE_wget-ssl=y           # Alternative downloader, useful for some scripts

# Size Optimizations / Kernel Debugging
CONFIG_PACKAGE_kmod-ikconfig=n            # Expose kernel config via /proc/config.gz (Save space)
CONFIG_KERNEL_BUILD_LOG_LEVEL=3           # Default log level
# CONFIG_KERNEL_DEBUG_INFO is not set     # Disable kernel debug symbols
# CONFIG_KERNEL_DEBUG_KERNEL is not set   # Disable verbose kernel debugging
# CONFIG_KERNEL_MAGIC_SYSRQ is not set    # Disable Magic SysRq Key
# CONFIG_KERNEL_SWAP is not set           # Disable Swap support

# Remove LuCI Translation Files (Significant Space Savings)
# CONFIG_LUCI_LANG_zh_Hans is not set
# CONFIG_PACKAGE_luci-i18n-base-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-firewall-zh-cn is not set
# ... and similarly disable all other luci-i18n-* packages if they appear selected
# This assumes the build system respects these 'not set' flags, otherwise,
# you might need to manually deselect them in make menuconfig once based on this .config,
# or add explicit `< package >/* / <*> /luci-i18n-*` removal commands in your action workflow.
CONFIG_LUCI_SRCDIET=y # Optional: Might reduce LuCI file size slightly
