# ==================================================
# 目标系统配置 (Target System): Newifi D2 (MT7621) - 适用于 OpenWrt 23.05 (Kernel 5.15) - 最终优化 + Watchdog & Logd (含冲突排除)
# ==================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ==================================================
# 目标镜像格式 (Target Image Format): SquashFS Sysupgrade
# ==================================================
CONFIG_TARGET_IMAGES_SQUASHFS=y
CONFIG_TARGET_IMAGES_INITRAMFS=n

# ==================================================
# 基本系统组件 (Base System): 核心组件、驱动、基础支持 - 适配 OpenWrt 23.05
# ==================================================
CONFIG_PACKAGE_blkid=y                   # **独立 blkid 命令行工具 (查询块设备信息, 保留以防blockd等依赖)**
CONFIG_PACKAGE_block-mount=y             # **挂载点管理 (核心, 底层支持自动挂载/热插拔事件)**
CONFIG_PACKAGE_blockd=y                  # **块设备事件守护进程 (处理热插拔等)**
CONFIG_PACKAGE_ca-certificates=y         # **HTTPS 证书包 (用于 SSL/TLS 验证)**
CONFIG_PACKAGE_coreutils=y               # **GNU 核心工具集 (ls, cp, mv, dd 等增强版)**
CONFIG_PACKAGE_coreutils-nohup=y         # **nohup 工具 (允许后台运行, OpenClash 等可能需要)**
CONFIG_PACKAGE_dropbear=y                # **轻量级 SSH 服务器 (用于远程登录)**
CONFIG_PACKAGE_firewall4=y               # **基于 nftables 的防火墙 V4 (23.05 默认)**
# CONFIG_PACKAGE_firewall is not set       # **确保旧版 iptables 防火墙 firewall3 未被选择**
CONFIG_PACKAGE_fstools=y                 # **文件系统工具 (保留基础功能, 含Flash管理等)**
CONFIG_PACKAGE_getopt=y                  # **命令行参数解析工具**
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y # **GPIO 按键热插拔内核模块 (适配 Kernel 5.15)**
CONFIG_PACKAGE_kmod-leds-gpio=y          # **GPIO LED 控制内核模块 (适配 Kernel 5.15)**
CONFIG_PACKAGE_logd=y                    # *** 恢复独立日志守护进程 logd ***
# CONFIG_PACKAGE_mkfstool is not set     # 通常由 fstools 提供或不必要
CONFIG_PACKAGE_mtd=y                     # **Flash (闪存) 操作工具 (固件升级等)**
CONFIG_PACKAGE_netifd=y                  # **网络接口管理守护进程 (核心网络管理)**
CONFIG_PACKAGE_odhcp6c=y                 # **IPv6 DHCP 客户端**
CONFIG_PACKAGE_odhcpd-ipv6only=y         # **IPv6 DHCP/RA 服务器 (仅 IPv6, 节省资源)**
CONFIG_PACKAGE_opkg=y                    # **软件包管理器 (安装/卸载 ipk)**
CONFIG_PACKAGE_ppp=y                     # **PPP 协议支持 (拨号上网基础)**
CONFIG_PACKAGE_kmod-ppp=y                # **PPP 内核模块 (适配 Kernel 5.15)**
CONFIG_PACKAGE_ppp-mod-pppoe=y           # **PPPoE 模块 (ADSL/光纤拨号)**
CONFIG_PACKAGE_rpcd=y                    # **RPC 守护进程 (LuCI 后端依赖)**
CONFIG_PACKAGE_rpcd-mod-file=y           # **RPC 文件访问模块 (LuCI 文件操作)**
CONFIG_PACKAGE_rpcd-mod-luci=y           # **RPC LuCI 核心模块**
CONFIG_PACKAGE_rpcd-mod-ucode=y          # **RPC ucode 调用模块**
CONFIG_PACKAGE_ucode=y                   # **ucode 解释器 (LuCI 依赖)**
CONFIG_PACKAGE_ucode-mod-fs=y            # **ucode 文件系统模块**
CONFIG_PACKAGE_ucode-mod-html=y          # **ucode HTML 解析模块**
CONFIG_PACKAGE_ucode-mod-http=y          # **ucode HTTP 客户端/服务端模块**
CONFIG_PACKAGE_ucode-mod-math=y          # **ucode 数学运算模块**
CONFIG_PACKAGE_ucode-mod-process=y       # **ucode 进程管理模块**
CONFIG_PACKAGE_ucode-mod-uci=y           # **ucode UCI 配置接口模块**
CONFIG_PACKAGE_uci=y                     # **统一配置接口 (命令行配置管理)**
CONFIG_PACKAGE_uclient-fetch=y           # **基础下载客户端 (wget/curl 的简化版)**
CONFIG_PACKAGE_urandom-seed=y            # **系统启动时生成随机数种子**
CONFIG_PACKAGE_urngd=y                   # **用户空间随机数生成守护进程**
CONFIG_PACKAGE_util-linux=y              # **基础 Linux 实用工具集 (保留核心)**
CONFIG_PACKAGE_watchdog=y                # *** 新增: 看门狗守护进程工具 (wdctl) ***

# ==================================================
# 存储与分区工具 (Storage & Partitioning) - !!! 大幅精简 !!! - 适配 OpenWrt 23.05
# ==================================================
# CONFIG_PACKAGE_fdisk is not set
# CONFIG_PACKAGE_lsblk is not set
# CONFIG_PACKAGE_parted is not set
# CONFIG_PACKAGE_sfdisk is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_exfatprogs is not set
# CONFIG_PACKAGE_hdparm is not set

# ==================================================
# 无线网络驱动、管理与安全 (Wireless Drivers, Management & Security) - 适配 OpenWrt 23.05 (内核 5.15)
# ==================================================
# --- 核心无线内核模块 (适配内核 5.15) ---
CONFIG_PACKAGE_kmod-cfg80211=y           # **无线配置 API (内核基础)**
CONFIG_PACKAGE_kmod-mac80211=y           # **无线 Software MAC 层 (内核基础)**
CONFIG_PACKAGE_kmod-mt76-core=y          # **MT76 系列无线驱动核心 (适配 5.15)**
# --- 特定设备无线驱动 (Newifi D2) ---
CONFIG_PACKAGE_kmod-mt7603=y             # **MT7603 (2.4GHz) 驱动 (适配 5.15)**
# CONFIG_PACKAGE_kmod-mt7603e is not set # *** 明确禁用冲突驱动 ***
CONFIG_PACKAGE_kmod-mt76x2=y             # **MT7612/MT76x2 (5GHz) 驱动 (适配 5.15)**
# --- 无线用户空间工具 ---
CONFIG_PACKAGE_hostapd-common=y          # **Hostapd/WPA Supplicant 通用文件**
CONFIG_PACKAGE_iw=y                      # **无线命令行管理工具**
CONFIG_PACKAGE_iwinfo=y                  # **无线信息库 (二进制程序)**
CONFIG_PACKAGE_wireless-regdb=y          # **无线区域数据库 (国家码规定)**
# --- 无线安全 (选用 wpad-wolfssl 以支持 WPA3) ---
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set # *** 明确禁用基础版 mbedtls ***
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set # *** 明确禁用基础版 wolfssl ***
# CONFIG_PACKAGE_wpad-openssl is not set   # *** 明确禁用 OpenSSL 版本 (如果存在) ***
CONFIG_PACKAGE_wpad-wolfssl=y            # **全功能 WPA Supplicant/Hostapd (含 WPA3, 使用 wolfssl 后端)**
# --- 无线相关库 & LuCI 集成 ---
CONFIG_PACKAGE_libiwinfo=y               # **Iwinfo C 库 (底层信息获取)**
CONFIG_PACKAGE_libiwinfo-data=y          # **Iwinfo 数据文件**
CONFIG_PACKAGE_libiwinfo-lua=y           # **Iwinfo Lua 绑定 (LuCI 显示无线信息)**
CONFIG_PACKAGE_rpcd-mod-iwinfo=y         # **RPC 无线信息模块 (LuCI 调用 iwinfo)**

# ==================================================
# DHCP 和 DNS 服务器 (DHCP & DNS Server) - 适配 OpenWrt 23.05
# ==================================================
# CONFIG_PACKAGE_dnsmasq is not set          # *** 明确禁用标准版 Dnsmasq ***
# CONFIG_PACKAGE_dnsmasq-base is not set     # *** 明确禁用基础版 Dnsmasq ***
CONFIG_PACKAGE_dnsmasq-full=y                # **启用全功能 Dnsmasq (推荐, 含 IPset, DNSSEC, DHCPv6 等)**
CONFIG_PACKAGE_libnetfilter-conntrack=y      # **dnsmasq-full (以及防火墙) 依赖的连接跟踪库**
CONFIG_PACKAGE_libnettle=y                   # **dnsmasq-full (用于 DNSSEC) 依赖的加密库**

# ==================================================
# LuCI Web 用户界面 (Web User Interface) - 适配 OpenWrt 23.05
# ==================================================
CONFIG_PACKAGE_luci=y                      # **LuCI 元数据包 (总开关)**
CONFIG_PACKAGE_luci-base=y                 # **LuCI 核心库和资源**
CONFIG_PACKAGE_luci-compat=y               # **LuCI 兼容层 (支持旧版 LuCI 应用)**
CONFIG_PACKAGE_luci-mod-admin-full=y       # **LuCI 完整管理菜单 (系统、网络等)**
CONFIG_PACKAGE_luci-mod-network=y          # **LuCI 网络设置页面 (含接口、无线等)**
CONFIG_PACKAGE_luci-mod-status=y           # **LuCI 状态概览页面**
CONFIG_PACKAGE_luci-mod-system=y           # **LuCI 系统设置页面 (含启动项,时区,备份,重启等)**
CONFIG_PACKAGE_luci-proto-ipv6=y           # **LuCI IPv6 协议支持 (网络接口设置)**
CONFIG_PACKAGE_luci-proto-ppp=y            # **LuCI PPP/PPPoE 协议支持 (拨号设置)**
CONFIG_PACKAGE_luci-app-firewall=y         # **LuCI 防火墙设置页面**
CONFIG_PACKAGE_luci-app-opkg=y             # **LuCI 软件包管理页面**
CONFIG_PACKAGE_luci-app-upnp=y             # **LuCI UPnP/NAT-PMP 设置页面 (来自官方 feeds)**
# --- 从外部源添加的 LuCI 应用 (!!! 必须确认与官方 23.05 兼容 !!!) ---
CONFIG_PACKAGE_luci-app-openclash=y      # **LuCI OpenClash (!!! 必须兼容 23.05, 检查 vernesong 仓库 !!!)**
# CONFIG_PACKAGE_luci-app-partexp is not set # **已移除 LuCI 分区扩容助手**
# CONFIG_PACKAGE_luci-app-diskman is not set # **已移除 LuCI 图形化磁盘管理**
CONFIG_PACKAGE_luci-app-p910nd=y         # **LuCI USB 打印服务器设置界面 (假设来自官方 feeds)**
CONFIG_PACKAGE_luci-app-poweroffdevice=y # **LuCI 关机/重启 (!!! 必须兼容 23.05, 检查 sirpdboy 仓库 !!!)**
CONFIG_PACKAGE_luci-app-turboacc=y       # **LuCI Turbo ACC (!!! 必须兼容 23.05, 检查 immortalwrt-collections 仓库 !!!)**

# ==================================================
# LuCI 主题 (Theme)
# ==================================================
CONFIG_PACKAGE_luci-theme-bootstrap=y    # **Bootstrap (官方 23.05 默认主题)**
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-material is not set

# ==================================================
# LuCI 语言支持 (Language Support): 中文 - 适配 OpenWrt 23.05
# ==================================================
CONFIG_LUCI_LANG_zh_Hans=y               # **启用简体中文支持**
# CONFIG_LUCI_LANG_en is not set
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y    # **基础界面中文包**
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y# **防火墙中文包**
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y    # **软件包管理中文包**
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y    # **UPnP 中文包 (来自官方 feeds)**
# --- 外部 App 汉化包 (!!! 必须确认与主 App 版本及 23.05 兼容 !!!) ---
# CONFIG_PACKAGE_luci-i18n-diskman-zh-cn is not set
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y    # **OpenClash 中文包 (来自对应外部源)**
# CONFIG_PACKAGE_luci-i18n-partexp-zh-cn is not set
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y       # **p910nd 中文包 (假设来自官方 feeds)**
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y # **PoweroffDevice 中文包 (来自对应外部源)**
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y     # **TurboACC 中文包 (来自对应外部源)**

# ==================================================
# 网络相关工具和库 (Networking) - 适配 OpenWrt 23.05
# ==================================================
CONFIG_PACKAGE_curl=y                    # **强大的文件传输工具 (OpenClash 等需要)**
CONFIG_PACKAGE_ip-full=y                 # **完整的 iproute2 工具集 (ip 命令)**
CONFIG_PACKAGE_ipset=y                   # **IP Set 工具 (OpenClash, 防火墙需要)**
CONFIG_PACKAGE_iptables-nft=y            # **iptables-nftables 兼容层 (保留以确保兼容性)**
CONFIG_PACKAGE_libcurl=y                 # **curl 功能库**
CONFIG_PACKAGE_libipset=y                # **ipset 功能库**
CONFIG_PACKAGE_libyaml=y                 # **YAML 解析库 (OpenClash 配置文件)**
CONFIG_PACKAGE_libcap-ng=y               # **Capabilities 库 (权限管理, 部分应用可能需要)**
CONFIG_PACKAGE_libnfnetlink=y            # **Netfilter Netlink 库 (底层网络库)**
CONFIG_PACKAGE_libnftnl=y                # **Nftables Netlink 库 (firewall4, miniupnpd-nft 依赖)**
CONFIG_PACKAGE_libnl-tiny=y              # **精简版 Netlink 库 (无线、网络工具依赖)**
CONFIG_PACKAGE_libpcre=y                 # **Perl 兼容正则表达式库 (某些工具匹配规则需要)**
CONFIG_PACKAGE_resolveip=y               # **域名解析工具 (dnsmasq-full 或其他脚本可能需要)**
CONFIG_PACKAGE_miniupnpd-nft=y           # **UPnP 和 NAT-PMP 服务守护进程 (nftables 版本)**
# CONFIG_PACKAGE_miniupnpd is not set      # *** 明确禁用旧版 miniupnpd (iptables) ***
CONFIG_PACKAGE_shortcut-fe=y             # **内核快速转发引擎的辅助工具 (TurboACC 可能用到)**
# CONFIG_PACKAGE_wget-ssl is not set

# ==================================================
# 内核模块 (Kernel Modules) - 适配 OpenWrt 23.05 (内核 5.15) - 含 Watchdog
# ==================================================
# --- 网络 (非无线部分, 适配内核 5.15) ---
CONFIG_PACKAGE_kmod-ipt-core=y           # **iptables 核心模块 (iptables-nft 兼容层需要)**
CONFIG_PACKAGE_kmod-ipt-ipset=y          # **iptables ipset 模块 (兼容层需要)**
CONFIG_PACKAGE_kmod-ipt-nat=y            # **iptables NAT 模块 (兼容层需要)**
CONFIG_PACKAGE_kmod-ipv6=y               # **IPv6 协议支持内核模块**
CONFIG_PACKAGE_kmod-nf-conntrack=y       # **Netfilter 连接跟踪 (Kernel 5.15)**
CONFIG_PACKAGE_kmod-nf-conntrack6=y      # **Netfilter IPv6 连接跟踪 (Kernel 5.15)**
CONFIG_PACKAGE_kmod-nf-flow=y            # **Netfilter 流表支持 (硬件/软件流量分载) (Kernel 5.15)**
CONFIG_PACKAGE_kmod-nf-nat=y             # **Netfilter NAT (网络地址转换) (Kernel 5.15)**
# CONFIG_PACKAGE_kmod-nf-nathelper-extra is not set # 移除 NAT 辅助模块
CONFIG_PACKAGE_kmod-nf-reject=y          # **Netfilter Reject 目标 (Kernel 5.15)**
CONFIG_PACKAGE_kmod-nf-reject6=y         # **Netfilter IPv6 Reject 目标 (Kernel 5.15)**
CONFIG_PACKAGE_kmod-nfnetlink=y          # **Netfilter Netlink 支持 (Kernel 5.15)**
CONFIG_PACKAGE_kmod-nft-core=y           # **nftables 核心模块 (Kernel 5.15)**
CONFIG_PACKAGE_kmod-nft-nat=y            # **nftables NAT 支持 (Kernel 5.15)**
CONFIG_PACKAGE_kmod-nft-offload=y        # **nftables 硬件卸载支持 (Kernel 5.15)**
CONFIG_PACKAGE_kmod-nft-fullcone=y       # **!!! NFT FullCone NAT 内核模块 (外部源, 必须兼容 Kernel 5.15! 编译失败风险!) !!!**
CONFIG_PACKAGE_kmod-sched-core=y         # **内核流量调度核心 (QoS 基础) (Kernel 5.15)**
CONFIG_PACKAGE_kmod-tcp-bbr=y            # **TCP BBR 拥塞控制算法模块 (Kernel 5.15)**
CONFIG_PACKAGE_kmod-tun=y                # **TUN/TAP 虚拟网络设备 (VPN/OpenClash) (Kernel 5.15)**
# --- USB (适配内核 5.15 - 仅支持打印机) ---
CONFIG_PACKAGE_kmod-usb-core=y           # **USB 核心支持**
CONFIG_PACKAGE_kmod-usb-ehci=y           # **USB 2.0 EHCI 控制器**
CONFIG_PACKAGE_kmod-usb-ohci=y           # **USB 1.1 OHCI 控制器 (兼容旧设备)**
CONFIG_PACKAGE_kmod-usb-uhci=y           # **USB 1.1 UHCI 控制器 (兼容旧设备)**
CONFIG_PACKAGE_kmod-usb2=y               # **USB 2.0 (通常是元包或别名)**
CONFIG_PACKAGE_kmod-usb3=y               # **USB 3.0 XHCI 控制器**
CONFIG_PACKAGE_kmod-usb-printer=y        # **USB 打印机内核驱动**
# --- NLS (仅保留基础和 UTF-8) ---
CONFIG_PACKAGE_kmod-nls-base=y           # **NLS (Native Language Support) 基础**
# CONFIG_PACKAGE_kmod-nls-cp437 is not set
# CONFIG_PACKAGE_kmod-nls-iso8859-1 is not set
CONFIG_PACKAGE_kmod-nls-utf8=y           # **NLS UTF-8 (Unicode, 必须)**
# --- 基础加密 (适配内核 5.15) ---
CONFIG_PACKAGE_kmod-crypto-hash=y        # **内核加密: 哈希算法**
CONFIG_PACKAGE_kmod-crypto-authenc=y     # **内核加密: 认证加密**
CONFIG_PACKAGE_kmod-crypto-aead=y        # **内核加密: AEAD 模式**
# --- WPA3/wolfssl 所需的附加内核加密模块 ---
CONFIG_PACKAGE_kmod-crypto-kpp=y              # **内核加密: 密钥对协议 (WPA3 SAE 需要)**
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y   # **内核加密: Curve25519 库 (WPA3 SAE / wolfssl 可能需要)**
CONFIG_PACKAGE_kmod-crypto-lib-sha256=y       # **内核加密: SHA256 库 (WPA3 可能需要)**
# --- 系统稳定性增强 ---
CONFIG_PACKAGE_kmod-hw_watchdog=y        # *** 新增: 硬件看门狗内核驱动 (系统稳定性) ***
# CONFIG_PACKAGE_kmod-softdog is not set

# ==================================================
# 必要的共享库 (Libraries) - 适配 OpenWrt 23.05 - 精简版
# ==================================================
CONFIG_PACKAGE_libatomic=y               # **原子操作库**
CONFIG_PACKAGE_libblkid=y                # **blkid 库 (保留)**
CONFIG_PACKAGE_libc=y                    # **标准 C 库 (自动选择)**
CONFIG_PACKAGE_libelf=y                  # **ELF 文件处理库 (用于读取内核模块等)**
CONFIG_PACKAGE_libgcc=y                  # **GCC 运行时库 (自动选择)**
CONFIG_PACKAGE_libgmp=y                  # **GNU 多精度算术库 (某些加密或工具可能需要)**
CONFIG_PACKAGE_libjson-c=y               # **JSON-C 库 (许多应用/服务使用 JSON)**
CONFIG_PACKAGE_liblua=y                  # **Lua 解释器库 (LuCI 依赖)**
CONFIG_PACKAGE_liblucihttp=y             # **LuCI HTTP 库 (LuCI 依赖)**
CONFIG_PACKAGE_liblucihttp-ucode=y       # **LuCI HTTP ucode 绑定**
CONFIG_PACKAGE_libmnl=y                  # **迷你 Netlink 库 (用于 netlink 通信)**
# CONFIG_PACKAGE_libncurses is not set     # 依赖构建系统按需添加
CONFIG_PACKAGE_libnl-genl=y              # **Netlink Generic 库**
CONFIG_PACKAGE_libnl-route=y             # **Netlink Route 库 (iproute2 等依赖)**
CONFIG_PACKAGE_libopenssl=y              # **OpenSSL 库 (提供广泛的加密功能, 与 wolfssl 共存)**
CONFIG_PACKAGE_libpthread=y              # **POSIX 线程库 (自动选择)**
CONFIG_PACKAGE_librt=y                   # **POSIX 实时扩展库 (自动选择)**
CONFIG_PACKAGE_libubox=y                 # **OpenWrt 基础库 (事件循环、JSON 等)**
CONFIG_PACKAGE_libubus=y                 # **OpenWrt 进程间通信库 (ubus)**
CONFIG_PACKAGE_libuci=y                  # **OpenWrt 配置管理库 (uci)**
CONFIG_PACKAGE_libuclient=y              # **uclient 下载库 (uclient-fetch 依赖)**
CONFIG_PACKAGE_libucode=y                # **ucode 功能库**
CONFIG_PACKAGE_libuuid=y                 # **UUID 生成库 (保留)**
CONFIG_PACKAGE_libwolfssl=y              # **wolfSSL 库 (wpad-wolfssl 依赖)**
CONFIG_PACKAGE_libz=y                    # **zlib 压缩库 (旧名, 兼容性)**
CONFIG_PACKAGE_zlib=y                    # **zlib 压缩库 (新名)**

# ==================================================
# 实用工具 (Utilities) - 适配 OpenWrt 23.05
# ==================================================
CONFIG_PACKAGE_iputils-ping=y            # **IPv4 ping 工具**
CONFIG_PACKAGE_iputils-ping6=y           # **IPv6 ping 工具**
CONFIG_PACKAGE_p910nd=y                  # **非假脱机打印守护进程 (USB 打印服务器)**
CONFIG_PACKAGE_usbutils=y                # **USB 设备查看工具 (lsusb)**

# ==================================================
# 构建与内核优化 (Build & Kernel Optimizations)
# ==================================================
# CONFIG_PACKAGE_kmod-ikconfig is not set
CONFIG_STRIP_PACKAGES=y                  # **剥离软件包中的调试符号 (减小体积)**
CONFIG_USE_STRIP=y                       # **使用 strip 工具进行剥离**
CONFIG_KERNEL_DEBUG_INFO=n               # **不编译内核调试信息 (减小体积, 加快编译)**
CONFIG_KERNEL_DEBUG_KERNEL=n             # **不编译内核调试功能 (减小体积)**
# CONFIG_KERNEL_MAGIC_SYSRQ is not set   # 禁用 SysRq 魔术键
CONFIG_KERNEL_SWAP=n                     # **不支持 SWAP 交换分区/文件 (路由器内存通常足够)**
