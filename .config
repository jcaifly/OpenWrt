CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# CONFIG_SIGNATURE_CHECK is not set
# CONFIG_SIGNED_PACKAGES is not set

# IPv6 支持
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_6to4=y

# Wireless 驱动程序(开源)
CONFIG_PACKAGE_kmod-mt76=y

# Wireless 驱动程序(闭源)
# CONFIG_PACKAGE_luci-app-mtwifi is not set
# CONFIG_PACKAGE_mt_wifi is not set
# CONFIG_PACKAGE_kmod-mt7603e is not set
# CONFIG_PACKAGE_kmod-mt76x2e is not set

# USB 相关
CONFIG_PACKAGE_automount=y # 功能: 自动挂载: 已选择。用于自动挂载插入的USB存储设备（如U盘、移动硬盘）。
CONFIG_PACKAGE_e2fsprogs=y # 功能: EXT2/3/4 文件系统工具: 已选择。提供创建、检查和修复 EXT2/EXT3/EXT4 文件系统所需的工具 (例如格式化U盘为EXT4)。
CONFIG_PACKAGE_smartmontools=y # 功能: S.M.A.R.T. 监控工具: 已选择。用于检查和监控硬盘驱动器（HDD/SSD）的健康状态。
CONFIG_PACKAGE_luci-app-hd-idle=y # 功能: LuCI App - 硬盘休眠: 已选择。提供一个Web界面，用于配置连接的USB硬盘在空闲一段时间后进入休眠状态以节能或延长寿命。
CONFIG_PACKAGE_luci-app-usb-printer=y # 功能: LuCI App - USB 打印服务器: 已选择。提供一个Web界面，用于设置和管理通过USB连接的打印机，使其可以通过网络共享。

# USB 网络共享
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-hso=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_libudev-fbsd=y
CONFIG_PACKAGE_usbutils=y

# USB 网络存储
# CONFIG_PACKAGE_autosamba is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
CONFIG_PACKAGE_luci-app-samba=y
CONFIG_PACKAGE_luci-app-vsftpd=y

# LUCI Appliciations
CONFIG_PACKAGE_luci-app-accesscontrol=y # LuCI App - 访问控制: 基于时间和MAC地址管理互联网访问权限。
# CONFIG_PACKAGE_luci-app-argon-config=y # LuCI App - Argon主题配置: (未选择) 为Argon主题提供设置界面。
# CONFIG_PACKAGE_luci-app-adbyby-plus=y # LuCI App - Adbyby Plus广告过滤: (未选择) 广告屏蔽应用程序的界面。
# CONFIG_PACKAGE_luci-app-adguardhome=y # LuCI App - AdGuard Home: (未选择) 网络范围的广告和跟踪器拦截DNS服务器的界面。
CONFIG_PACKAGE_luci-app-autoupdate=y # LuCI App - 自动更新: 配置固件或软件包列表的自动更新。
# CONFIG_PACKAGE_luci-app-aria2=y # LuCI App - Aria2下载工具: (未选择) Aria2下载管理器的Web界面。
# CONFIG_PACKAGE_luci-app-aliyundrive-webdav=y # LuCI App - 阿里云盘WebDAV: (未选择) 通过WebDAV协议共享阿里云盘存储。
CONFIG_PACKAGE_luci-app-ddns=y # LuCI App - 动态DNS (DDNS): 用于配置动态DNS客户端的界面。
CONFIG_PACKAGE_ddns-scripts_aliyun=y # DDNS脚本 - 阿里云: 用于luci-app-ddns的阿里云DNS提供商脚本。
CONFIG_PACKAGE_ddns-scripts_dnspod=y # DDNS脚本 - DNSPod: 用于luci-app-ddns的DNSPod提供商脚本。
CONFIG_PACKAGE_ddns-scripts_cloudflare.com-v4=y # DDNS脚本 - Cloudflare API v4: 用于luci-app-ddns的Cloudflare提供商脚本。
CONFIG_PACKAGE_ddns-scripts_no-ip_com=y # DDNS脚本 - No-IP.com: 用于luci-app-ddns的No-IP.com提供商脚本。
CONFIG_PACKAGE_luci-app-eqos=y # LuCI App - 简易QoS: 简化的服务质量(Quality of Service)管理界面。
CONFIG_PACKAGE_luci-app-filetransfer=y # LuCI App - 文件传输: 用于在路由器上上传/下载文件的简单Web界面。
# CONFIG_PACKAGE_luci-app-frpc is not set # LuCI App - FRP客户端 (内网穿透): (未选择) 用于管理FRP客户端连接的界面。
# CONFIG_PACKAGE_luci-app-ipsec-vpnd=y # LuCI App - IPSec VPN 服务: (未选择) 用于配置基于IPSec的VPN的界面。
# CONFIG_PACKAGE_luci-app-iperf3-server=y # LuCI App - iPerf3 服务器: (未选择) 允许通过界面运行iPerf3网络基准测试服务器。
# CONFIG_PACKAGE_luci-app-jd-dailybonus is not set # LuCI App - 京东签到: (未选择) 自动执行京东每日签到任务。
CONFIG_PACKAGE_luci-app-mwan3=y # LuCI App - MWAN3多拨负载均衡: 多WAN口管理界面，用于负载均衡和故障转移。
CONFIG_PACKAGE_luci-app-mwan3helper=y # LuCI App - MWAN3 助手: 为MWAN3提供额外的工具或UI增强功能。
CONFIG_PACKAGE_luci-app-nlbwmon=y # LuCI App - 网络带宽监视器 (nlbwmon): 按客户端监控网络流量使用情况。
CONFIG_PACKAGE_luci-app-natter=y # LuCI App - NAT类型优化/FullCone NAT: 与改善NAT类型相关的工具 (常用于游戏/P2P)。
CONFIG_PACKAGE_luci-app-openclash=y # LuCI App - OpenClash: OpenClash代理客户端（科学上网）的界面。
CONFIG_PACKAGE_luci-app-onliner=y # LuCI App - 在线用户: 显示当前连接的DHCP客户端/用户。
# CONFIG_PACKAGE_luci-app-pptp-server=y # LuCI App - PPTP VPN 服务器: (未选择) 用于设置PPTP VPN服务器的界面 (注意: PPTP不安全)。
# CONFIG_PACKAGE_luci-app-rclone is not set # LuCI App - Rclone (云存储管理): (未选择) 用于挂载/同步云存储的Rclone界面。
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_fuse-utils is not set # Rclone Fuse 依赖: (未选择) 通过FUSE挂载时需要。
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng is not set # Rclone NG Web界面选项: (未选择) Rclone的备选Web界面。
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui is not set # Rclone 标准Web界面选项: (未选择) Rclone的默认Web界面。
# CONFIG_PACKAGE_luci-app-serverchan=y # LuCI App - Server酱推送: (未选择) 通过ServerChan微信推送服务发送路由器通知。
CONFIG_PACKAGE_luci-app-sqm=y # LuCI App - SQM QoS (智能队列管理): 高级QoS，用于减少网络延迟(Bufferbloat)。
CONFIG_PACKAGE_luci-app-syncdial=y # LuCI App - 同步拨号: 用于在多个WAN接口上同步拨号的界面（例如多线路PPPoE）。
CONFIG_PACKAGE_luci-app-smartdns=y # LuCI App - SmartDNS: 本地DNS服务器界面，旨在提高DNS速度并防止污染。
# CONFIG_PACKAGE_luci-app-socat=y # LuCI App - Socat端口转发: (未选择) 用于配置Socat（多功能中继工具）的界面。
# CONFIG_PACKAGE_luci-app-ttyd=y # LuCI App - ttyd 网页终端: (未选择) 提供可通过Web浏览器访问的终端界面。
CONFIG_PACKAGE_luci-app-turboacc=y # LuCI App - Turbo ACC 网络加速: 用于管理网络加速功能（如 Offloading）的界面。
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y # Turbo ACC Flow Offloading 支持: 启用与硬件/软件流卸载的集成。
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set # Turbo ACC Shortcut-FE 引擎: (未选择) 一种特定的软件网络加速引擎（Fast Path/SFE）。
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM is not set # Turbo ACC Shortcut-FE 连接管理器: (未选择) Shortcut-FE的组件。
CONFIG_PACKAGE_luci-app-udpxy=y # LuCI App - udpxy (UDP转HTTP代理): udpxy的界面 (UDP到HTTP的多播/单播代理，常用于IPTV)。
CONFIG_PACKAGE_luci-app-uhttpd=y # LuCI App - uHTTPd 设置: 用于配置LuCI Web服务器本身的界面。
CONFIG_PACKAGE_luci-app-upnp=y # LuCI App - UPnP / NAT-PMP: 通用即插即用/NAT端口映射协议的界面。
# CONFIG_PACKAGE_luci-app-unblockmusic=y # LuCI App - 解锁网易云音乐: (未选择) 用于绕过地区限制工具的界面。
# CONFIG_PACKAGE_luci-app-unblockmusic_INCLUDE_UnblockNeteaseMusic_Go is not set # 解锁网易云音乐 Go 版本: (未选择) luci-app-unblockmusic的Go语言后端。
# CONFIG_PACKAGE_luci-app-unblockmusic_INCLUDE_UnblockNeteaseMusic_NodeJS is not set # 解锁网易云音乐 NodeJS 版本: (未选择) luci-app-unblockmusic的NodeJS后端。
CONFIG_PACKAGE_luci-app-webadmin=y # LuCI App - Web 管理: 基本的Web管理界面访问。
CONFIG_PACKAGE_luci-app-webd=y # LuCI App - Webd 文件管理器: 另一个简单的基于Web的文件管理器界面。
CONFIG_PACKAGE_luci-app-wol=y # LuCI App - 网络唤醒 (WoL): 用于发送WoL数据包唤醒设备的界面。
# CONFIG_PACKAGE_luci-app-wireguard=y # LuCI App - WireGuard: (未选择) 用于配置WireGuard VPN接口的界面。
# CONFIG_PACKAGE_luci-app-zerotier=y # LuCI App - ZeroTier: (未选择) 用于管理ZeroTier虚拟网络连接的界面。
CONFIG_PACKAGE_luci-ssl-openssl=y # LuCI SSL 支持 (使用 OpenSSL): 为LuCI Web界面启用HTTPS访问。
CONFIG_PACKAGE_luci-app-partexp # LuCI App - 分区扩展: 用于扩展磁盘分区（尤其在SD卡启动的设备上）的界面

# 主题包
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-argon-mod=y

# Other Appliciations
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_davfs2=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_ppp-mod-pptp=y
CONFIG_PACKAGE_ppp-mod-pppol2tp=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_xl2tpd=y
