# ==================================================
# 目标系统配置 (Target System): Newifi D2 (MT7621)
# ==================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ==================================================
# 目标镜像格式 (Target Image Format): SquashFS Sysupgrade
# ==================================================
CONFIG_TARGET_IMAGES_SQUASHFS=y
# CONFIG_TARGET_IMAGES_GZIP is not set
# CONFIG_TARGET_IMAGES_INITRAMFS=n

# ==================================================
# 基本系统组件 (Base System)
# ==================================================
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_diskman=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
# --- WiFi 驱动明确配置 ---
CONFIG_PACKAGE_kmod-mt7603=y           # **2.4GHz WiFi 驱动 (确认选中)**
# CONFIG_PACKAGE_kmod-mt7603e is not set # **确认冲突包禁用**
CONFIG_PACKAGE_kmod-mt76x2=y           # **5GHz WiFi 驱动 (确认选中)**
# CONFIG_PACKAGE_kmod-mt76 is not set    # 通常被 mt7603/mt76x2 依赖自动选择, 但如果缺失则明确添加 kmod-mt76-core 或 kmod-mt76 (下面添加了 core)
# CONFIG_PACKAGE_kmod-mt76-connac is not set # 非 Newifi D2 需要的模块
# --- WiFi 固件 (通常包含在驱动内, 但可补充) ---
# CONFIG_PACKAGE_kmod-mt76-firmware=y # 如果上面驱动无效, 可以尝试这个通用固件包
# CONFIG_PACKAGE_kmod-mt7603-firmware=y # 单独的固件包，通常不需要，除非明确指出

# --- 其他基础系统 ---
# CONFIG_PACKAGE_logd is not set
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y                # **确保网络守护进程在**
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y       # **无线信息 RPC 模块，重要**
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_shortcut-fe=y           # TurboACC 后端
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-http=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-process=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_lsblk=y

# ==================================================
# 无线网络安全与管理工具 (Wireless Security & Management)
# ==================================================
CONFIG_PACKAGE_hostapd-common=y          # **hostapd/wpad 基础包**
CONFIG_PACKAGE_wireless-regdb=y        # **无线规则数据库**
CONFIG_PACKAGE_iwinfo=y                # **命令行无线信息工具**
CONFIG_PACKAGE_iw=y                    # **新的无线配置工具 (用于 nl80211)**
# CONFIG_PACKAGE_wireless-tools is not set # 旧的无线工具，通常不再需要
CONFIG_PACKAGE_wpad-basic-mbedtls=y     # **包含 hostapd 和 wpa_supplicant 的精简包**

# ==================================================
# DHCP 和 DNS 服务器
# ==================================================
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-base is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_libnetfilter-conntrack=y
CONFIG_PACKAGE_libnettle=y

# ==================================================
# LuCI Web 用户界面 (Web User Interface)
# ==================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y      # **LuCI 网络界面，包含无线配置**
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_luci-app-shutdown=y
CONFIG_PACKAGE_luci-app-turboacc=y

# ==================================================
# LuCI 主题 (Theme)
# ==================================================
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ==================================================
# LuCI 语言支持 (Language Support): 中文
# ==================================================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-shutdown-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
# CONFIG_LUCI_SRCDIET is not set

# ==================================================
# 网络相关工具和库 (Networking)
# ==================================================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_libnl-tiny=y
CONFIG_PACKAGE_libpcre=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_wget-ssl=y

# ==================================================
# 内核模块 (Kernel Modules): 驱动与功能
# ==================================================
# --- 网络 ---
CONFIG_PACKAGE_kmod-cfg80211=y          # **802.11 配置核心 (WiFi 基础)**
CONFIG_PACKAGE_kmod-mac80211=y          # **Linux 无线局域网子系统 (WiFi 基础)**
CONFIG_PACKAGE_kmod-mt76-core=y         # **MT76系列无线驱动通用核心 (新增)**
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipv6=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-nf-reject=y
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-tun=y
# --- USB ---
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
# --- 文件系统 ---
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
# --- NLS ---
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# --- 加密模块 ---
CONFIG_PACKAGE_kmod-crypto-hash=y
CONFIG_PACKAGE_kmod-crypto-authenc=y
CONFIG_PACKAGE_kmod-crypto-aead=y

# ==================================================
# 必要的共享库 (Libraries)
# ==================================================
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libblkid=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libext2fs=y
CONFIG_PACKAGE_libfdisk=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libgmp=y
CONFIG_PACKAGE_libiwinfo=y             # **无线信息库 (LuCI/iwinfo 依赖)**
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_libnl-genl=y            # **通用 Netlink 库 (iw 等依赖)**
CONFIG_PACKAGE_libnl-route=y           # **Netlink 路由库 (某些无线/网络工具依赖)**
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libparted=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libsmartcols=y
CONFIG_PACKAGE_libss=y
CONFIG_PACKAGE_libubox=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_libuclient=y
CONFIG_PACKAGE_libucode=y
CONFIG_PACKAGE_libuuid=y
CONFIG_PACKAGE_libz=y
CONFIG_PACKAGE_zlib=y

# ==================================================
# 实用工具 (Utilities)
# ==================================================
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_exfatprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_hdparm=y
# CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-ping6=y
CONFIG_PACKAGE_lsblk=y
# CONFIG_PACKAGE_nano=n
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_util-linux=y

# ==================================================
# 构建与内核优化 (Build & Kernel Optimizations)
# ==================================================
CONFIG_PACKAGE_kmod-ikconfig=n
CONFIG_STRIP_PACKAGES=y
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_KERNEL=n
CONFIG_KERNEL_MAGIC_SYSRQ=n
CONFIG_KERNEL_SWAP=n
