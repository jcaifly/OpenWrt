# Target System Configuration
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# Firmware Type - SquashFS Sysupgrade
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y # Default compression
# CONFIG_TARGET_IMAGES_FIT is not set (FIT images are generally for newer U-Boot/devices)
CONFIG_TARGET_ROOTFS_PARTSIZE=100 # (Optional) Adjust rootfs partition size if needed, leave blank for auto

# Base system
# CONFIG_BUSYBOX_CUSTOM is not set (Use default Busybox unless specific applets needed)
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_ca-bundle=y # For HTTPS connections
CONFIG_PACKAGE_wget-ssl=y # Or curl with SSL support, needed by OpenClash/Opkg updates
# CONFIG_PACKAGE_curl is not set (choose wget or curl)

# IPv6 Configuration (Usually enabled by default, ensure kernel mods)
CONFIG_IPV6=y
CONFIG_PACKAGE_ip6tables=y # Although using nftables, some tools might still call this
CONFIG_PACKAGE_kmod-ip6tables=y # Kernel modules for IPv6 firewalling
CONFIG_PACKAGE_kmod-ipv6=y
CONFIG_PACKAGE_odhcp6c=y # IPv6 client
CONFIG_PACKAGE_odhcpd-ipv6only=y # Optional: IPv6 DHCP server

# LuCI Configuration
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y # Recommended for secure access
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-bootstrap=y # Default theme
# CONFIG_PACKAGE_luci-theme-argon is not set (User requested default theme)
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # Chinese translation for base LuCI

# Networking Applications
CONFIG_PACKAGE_firewall4=y # Use nftables based firewall
CONFIG_PACKAGE_kmod-nft-offload=y # Flow offloading for NFTables (used by TurboACC)
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_iptables-nft=y # Provides iptables command using nftables backend
# CONFIG_PACKAGE_firewall is not set (Legacy iptables firewall)
# CONFIG_PACKAGE_iptables is not set (Legacy iptables utilities)

# Handle dnsmasq conflict
CONFIG_PACKAGE_dnsmasq-full=y # Select full version
# CONFIG_PACKAGE_dnsmasq is not set # CRITICAL: Deselect default dnsmasq

# UPnP and NAT-PMP
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nft=y # UPnP daemon for NFTables
# CONFIG_PACKAGE_miniupnpd is not set (UPnP daemon for iptables)
# NAT-PMP is typically included within miniupnpd functionality

# USB Support
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-printer=y # USB Printer support
CONFIG_PACKAGE_kmod-usb2=y # EHCI (USB 2.0) support
CONFIG_PACKAGE_kmod-usb-ohci=y # Optional: OHCI (USB 1.1) support if needed
CONFIG_PACKAGE_kmod-usb-uhci=y # Optional: UHCI (USB 1.1) support if needed
# CONFIG_PACKAGE_kmod-usb3 is not set (Newifi3 likely has USB 2.0 ports)
CONFIG_PACKAGE_p910nd=y # Printer daemon (Raw TCP/IP on port 9100)
CONFIG_PACKAGE_luci-app-p910nd=y # LuCI interface for p910nd (May not exist as separate package, often integrated or manual config) - Check availability if needed

# Wireless Drivers (Use defaults provided by target profile)
# Assuming CONFIG_PACKAGE_kmod-mt76=y or similar is set by default for the target
# Ensure kmod-mt7603, kmod-mt76x2 (for MT7612E) etc. are selected automatically or manually if needed based on official OpenWrt defaults for Newifi D2

# Added Applications from diy-part1.sh
CONFIG_PACKAGE_luci-app-openclash=y
# Dependencies for OpenClash (Verify if build system picks these up, otherwise add manually)
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y # Often needed by Ruby scripts dealing with YAML like OpenClash config
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_kmod-inet-diag=y # May be needed for connection state tracking
CONFIG_PACKAGE_kmod-ipt-ipset=y # Or kmod-nft-ipset depending on OpenClash version/config
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_geoip-database=y # For GeoIP rules

CONFIG_PACKAGE_luci-app-turboacc=y # Ensure it selects the correct accelerator (e.g., NFT Flow Offload)

CONFIG_PACKAGE_luci-app-poweroffdevice=y

CONFIG_PACKAGE_kmod-nft-fullcone=y # FullCone NAT kernel module

# Kernel modules (Ensure minimum necessary are included)
CONFIG_PACKAGE_kmod-ipt-core=y # Base iptables modules (even with nftables, needed for iptables-nft compat layer)
CONFIG_PACKAGE_kmod-nft-core=y # Base nftables modules
CONFIG_PACKAGE_kmod-nft-nat=y # NAT support for nftables
CONFIG_PACKAGE_kmod-nf-reject=y # Reject targets for firewall
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nf-log=y # Logging
CONFIG_PACKAGE_kmod-nf-log6=y
# Add other kernel modules if specific features require them (e.g., VPNs, specific filesystems)
