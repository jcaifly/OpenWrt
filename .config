#
# Target Profile Configuration
#
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
# 核心：选择 Newifi D2 (Newifi 3) 设备配置文件
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

#
# Target Images
#
# 核心：确保生成 squashfs-sysupgrade 格式的固件
CONFIG_TARGET_IMAGES_squashfs=y
# 确保根文件系统是 squashfs
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 可选：如果不需要 initramfs 镜像，可以取消选择以减少编译时间
# CONFIG_TARGET_IMAGES_initramfs is not set

#
# Base system
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
# 核心：设置默认语言为简体中文
CONFIG_LUCI_LANG_zh_Hans=y

#
# LuCI ---> Applications
#
CONFIG_PACKAGE_luci-app-firewall=y
# 核心：编译 OpenClash LuCI 应用 (来自 diy-part1.sh 添加的源)
CONFIG_PACKAGE_luci-app-openclash=y
# 核心：编译 TurboACC LuCI 应用 (来自 diy-part1.sh 添加的源)
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-upnp=y
# 核心：编译 USB 打印服务器 LuCI 应用
CONFIG_PACKAGE_luci-app-usb-printer=y
# 核心：编译 关机助手 LuCI 应用 (来自 diy-part1.sh 添加的源)
CONFIG_PACKAGE_luci-app-poweroffdevice=y

#
# LuCI ---> Themes
#
# 核心：使用默认主题 Bootstrap
CONFIG_PACKAGE_luci-theme-bootstrap=y

#
# LuCI ---> Translations ---> Chinese (zh-cn)
#
# 核心：基础 LuCI 中文翻译 (通常由 CONFIG_LUCI_LANG_zh_Hans=y 自动选中)
# CONFIG_PACKAGE_luci-i18n-base-zh-cn is not set # 通常由主语言选项自动选择，无需手动设y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-usb-printer-zh-cn=y
# 注意：OpenClash, TurboACC, PoweroffDevice 的中文翻译通常包含在其各自的包内，无需单独选择 i18n 包。

#
# Network ---> DHCP / DNS
#
# 核心：处理 dnsmasq 冲突 - 禁用默认版本
CONFIG_PACKAGE_dnsmasq=n
# 核心：启用功能更全的 dnsmasq-full
CONFIG_PACKAGE_dnsmasq-full=y

#
# Network ---> Firewall
#
CONFIG_PACKAGE_firewall4=y # OpenWrt 默认防火墙后端 (nftables based)
CONFIG_PACKAGE_kmod-nft-offload=y # Flow Offloading (通常被 TurboACC 依赖)
CONFIG_PACKAGE_iptables-nft=y # 提供 iptables 命令兼容层 (OpenClash 可能需要)
CONFIG_PACKAGE_ipset=y # OpenClash 常用依赖

#
# Network ---> IP Addresses and Names
#
# 核心：确保 IPv6 相关基础组件被选中
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcpd-ipv6only=y # 或者 CONFIG_PACKAGE_odhcpd=y (处理 DHCPv4/v6)
CONFIG_PACKAGE_odhcp6c=y # 如果需要 DHCPv6 Client 功能

#
# Network ---> UPnP
#
# 核心：编译 miniupnpd (UPnP 和 NAT-PMP 服务守护进程)
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_natpmpc=y # NAT-PMP client utility (miniupnpd 可能依赖)

#
# Kernel modules ---> USB Support
#
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y  # USB 1.1 (OHCI)
CONFIG_PACKAGE_kmod-usb-uhci=y  # USB 1.1 (UHCI)
CONFIG_PACKAGE_kmod-usb2=y      # USB 2.0 (EHCI)
CONFIG_PACKAGE_kmod-usb3=y      # USB 3.0 (XHCI) - Newifi3 有 USB 3.0
# 核心：USB 打印机内核支持
CONFIG_PACKAGE_kmod-usb-printer=y

#
# Kernel modules ---> Network Support
#
# 核心：确保 TUN/TAP 内核模块被编译，OpenClash 的 TUN 模式需要
CONFIG_PACKAGE_kmod-tun=y
# TurboACC / Flow Offloading 依赖 (通常会自动选中，但明确指定更安全)
CONFIG_PACKAGE_kmod-ipt-offload=y

#
# Kernel modules ---> Wireless Drivers
#
# 核心：Newifi3 的无线驱动 (通常由 Target Profile 自动选择，但可显式确认)
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt7603=y  # 2.4 GHz
CONFIG_PACKAGE_kmod-mt76x2=y  # 5 GHz (MT7612E)
CONFIG_PACKAGE_wpad-basic-wolfssl=y # 或选择 wpad-openssl/wpad-wolfssl 以支持更完整的 WiFi 功能

#
# Utilities ---> Filesystem
#
# 可选，如果需要挂载 USB 存储设备 (例如打印机假脱机可能需要)
# CONFIG_PACKAGE_kmod-fs-ext4=y
# CONFIG_PACKAGE_kmod-fs-vfat=y
# CONFIG_PACKAGE_kmod-nls-cp437=y
# CONFIG_PACKAGE_kmod-nls-iso8859-1=y
# CONFIG_PACKAGE_kmod-nls-utf8=y
# CONFIG_PACKAGE_block-mount=y # 用于自动挂载

#
# Utilities ---> Printing
#
# 核心：编译 p910nd 打印服务器守护进程 (被 luci-app-usb-printer 使用)
CONFIG_PACKAGE_p910nd=y

#
# Utilities (Ensure basic tools are present)
#
CONFIG_PACKAGE_coreutils=y      # 提供更全的命令行工具 (OpenClash 可能需要，如 base64, timeout等)
CONFIG_PACKAGE_bash=y           # OpenClash 可能需要 bash 环境
CONFIG_PACKAGE_curl=y           # 网络请求工具 (OpenClash 更新配置等需要)
CONFIG_PACKAGE_ca-bundle=y      # SSL 证书 (curl 等需要)
#CONFIG_PACKAGE_wget=y          # 另一个网络下载工具，按需选择
CONFIG_PACKAGE_libmaxminddb=y   # GeoIP 数据库库文件 (OpenClash GeoIP 功能需要)
CONFIG_PACKAGE_ip-full=y        # 功能更全的 iproute2 工具 (OpenClash 可能需要)

#
# Extra packages for dependencies (If needed and not pulled automatically)
#
# 例如：CONFIG_PACKAGE_libcap=y
# 例如：CONFIG_PACKAGE_libyaml=y (OpenClash 可能间接需要)
# 大部分依赖应该会被主软件包的 Makefile 自动处理和选中，这里只列出一些关键或易遗漏的

#
# Final checks and optimizations
#
CONFIG_USE_SENDFILE=y
CONFIG_KERNEL_PERF_EVENTS=y # 一些性能分析可能需要，酌情选择
