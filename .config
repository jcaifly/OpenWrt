#
# Target Platform Configuration
#
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

#
# Image Configuration
#
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set # 明确不编译 EXT4 格式的根文件系统

#
# Base system
#
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-bundle=y          # ca-bundle 通常包含了 ca-certificates
# CONFIG_PACKAGE_ca-certificates=y # 如果 ca-bundle 不可用或需要明确指定，则选这个
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_fwtool=y             # Firmware validation tool
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y # 支持按钮触发事件 (如 Reset)
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-offload=y   # MT7621 硬件流量分载支持 (依赖 nftables)
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_procd-ujail=y        # 更安全的进程沙箱
CONFIG_PACKAGE_swconfig=y           # Switch configuration utility (MT7621 使用)
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

#
# DNS and DHCP (Using dnsmasq-full)
#
# CONFIG_PACKAGE_dnsmasq is not set # 禁用标准版 dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y        # 使用功能更全的 dnsmasq

#
# IPv6 Configuration
#
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y    # IPv6 DHCP Server/Relay
# 保留 ip6tables 包以防 OpenClash 等应用在 nftables 环境下仍需要 iptables 的 IPv6 NAT 兼容层
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y     # 内核模块 for ip6tables NAT

#
# Wireless Drivers (Open Source)
#
CONFIG_PACKAGE_kmod-mt7603e=y       # 2.4GHz radio driver
CONFIG_PACKAGE_kmod-mt76x2e=y       # 5GHz radio driver
CONFIG_PACKAGE_wpad-openssl=y      # WPA Supplicant/HostAPD with OpenSSL (for WPA2/WPA3)
CONFIG_PACKAGE_iw=y                # Wireless tools
CONFIG_PACKAGE_iwinfo=y            # Wireless information library used by LuCI

#
# USB Support
#
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y         # EHCI support
CONFIG_PACKAGE_kmod-usb3=y         # XHCI support (Newifi D2 has USB 3.0)
CONFIG_PACKAGE_block-mount=y       # For mounting block devices (USB storage)
# USB Storage Support
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y # Additional drivers (e.g., UAS)
CONFIG_PACKAGE_kmod-usb-storage-uas=y    # UAS support for faster transfers
# Filesystem Support
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y      # FAT16/FAT32 support
CONFIG_PACKAGE_kmod-fs-ntfs=y      # Basic NTFS support (read-only typically)
CONFIG_PACKAGE_ntfs-3g=y           # Provides read-write support for NTFS
# USB Printer Support
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y            # Printer daemon
CONFIG_PACKAGE_luci-app-p910nd=y   # LuCI interface for p910nd

#
# LuCI Web Interface
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y     # Needed for PPPoE dial-up
CONFIG_PACKAGE_luci-ssl-openssl=y  # Enable HTTPS access for LuCI using OpenSSL
CONFIG_PACKAGE_luci-theme-bootstrap=y # Default theme

# LuCI Chinese Language Support
CONFIG_LUCI_LANG_zh_Hans=y          # Enable Chinese Simplified Language
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
# Add translations for specific apps if available as separate packages (check app Makefiles)
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

#
# LuCI Applications (User Requested)
#
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-upnp=y            # UPnP / NAT-PMP Service (depends on miniupnpd)
CONFIG_PACKAGE_luci-app-openclash=y       # OpenClash Application
CONFIG_PACKAGE_luci-app-turboacc=y        # TurboACC Acceleration Suite Application
CONFIG_PACKAGE_luci-app-poweroffdevice=y  # Shutdown/Poweroff LuCI App

#
# Required Services/Packages for LuCI Apps
#
# For UPnP/NAT-PMP
CONFIG_PACKAGE_miniupnpd=y

# For FullCone NAT (nftables version)
CONFIG_PACKAGE_kmod-nft-fullcone=y     # Requires kmod-nft-nat (usually pulled by firewall4)

# For TurboACC Acceleration Suite
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y # Enable Flow Offloading acceleration option
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y    # Enable BBR congestion control option
CONFIG_PACKAGE_kmod-tcp-bbr=y          # TCP BBR kernel module
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_PDNSD=y # Enable Pdnsd option if needed for DNS acceleration/cache
CONFIG_PACKAGE_pdnsd-alt=y             # Pdnsd (Alternative) needed by TurboACC option

# For OpenClash
# Dependencies are extensive, list common ones explicitly
# Check OpenClash documentation for complete/up-to-date list
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y             # Provides basic utils like 'sort', 'uniq', etc.
# CONFIG_PACKAGE_coreutils-nohup=y is part of coreutils
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y               # Required for advanced IP rule/route management
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y          # Compatibility layer for iptables commands on nftables system
CONFIG_PACKAGE_iptables-mod-tproxy=y   # Required for TPROXY mode
CONFIG_PACKAGE_iptables-mod-extra=y    # Extra iptables matches/targets potentially needed
CONFIG_PACKAGE_kmod-ipt-tproxy=y      # Kernel module for TPROXY support (used with iptables-nft)
CONFIG_PACKAGE_libcap-ng=y             # Use libcap-ng instead of older libcap if possible/compatible
CONFIG_PACKAGE_libyaml=y               # Dependency for ruby-yaml or directly by clash core
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-tun=y              # TUN/TAP device support (required for TUN mode)
# GEOIP/GEOData Support (Needed for Geo-based rules in OpenClash)
# CONFIG_PACKAGE_sing-geoip=y            # Newer GeoIP lib
# CONFIG_PACKAGE_sing-geosite=y          # Newer Geosite lib
# or choose other geoip/geosite packages if required by your clash core/config

#
# Additional Useful Applications and Utilities
#
CONFIG_PACKAGE_htop=y                  # Interactive process viewer
CONFIG_PACKAGE_diffutils=y             # File comparison utilities
CONFIG_PACKAGE_nano=y                  # Simple text editor
# CONFIG_PACKAGE_vim-full=y # Feature-rich text editor (larger)
CONFIG_PACKAGE_wget=y                  # Non-interactive network downloader
CONFIG_PACKAGE_luci-app-nlbwmon=y      # Network bandwidth monitor
CONFIG_PACKAGE_luci-app-wol=y          # Wake-on-LAN client
CONFIG_PACKAGE_luci-app-ttyd=y         # Terminal access via Web UI

#
# System Configuration
#
CONFIG_PACKAGE_zoneinfo-asia=y         # Timezone data for Asia
CONFIG_SYSTEM_TIMEZONE="Asia/Shanghai" # Set default timezone
# CONFIG_SYSTEM_DEFAULT_LANG="zh_CN"     # Set default system language if needed
