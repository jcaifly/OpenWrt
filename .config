# Target System
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_newifi_d2=y # 确认这是 newifi3 (Newifi D2) 的设备名

# Base system
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_LUCI_LANG_zh_Hans=y # 中文界面支持 (可选)
CONFIG_PACKAGE_luci-compat=y # 为一些老应用提供兼容性，OpenClash 可能需要
CONFIG_PACKAGE_wget-ssl=y # 或者 curl，很多应用需要下载资源
CONFIG_PACKAGE_ca-bundle=y # SSL 证书

# 1. Shutdown
CONFIG_PACKAGE_luci-app-shutdown=y

# 2. Printer Support
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_luci-app-p910nd=y # p910nd 是简单常用的打印服务器
CONFIG_PACKAGE_p910nd=y
# 或者使用 CUPS (更强大，但资源占用更高，可能不适合 newifi3)
# CONFIG_PACKAGE_cups=y
# CONFIG_PACKAGE_luci-app-cups=y

# 3. USB Overlay (ext4)
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y # USB Attached SCSI Protocol, 提高性能
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y # ext4 文件系统工具 (mkfs.ext4, fsck.ext4)
# USB 控制器驱动 (MT7621 通常需要 ehci 和 xhci)
CONFIG_PACKAGE_kmod-usb-ohci=y # 可能不需要，但选上无害
CONFIG_PACKAGE_kmod-usb-uhci=y # 可能不需要，但选上无害
CONFIG_PACKAGE_kmod-usb2=y # EHCI
CONFIG_PACKAGE_kmod-usb3=y # XHCI

# 4. Network Acceleration (MT7621 Hardware Flow Offloading)
CONFIG_PACKAGE_kmod-nft-offload=y # 基于 nftables 的硬件卸载
CONFIG_NETFILTER_NETLINK_GLUE_CT=y # 某些卸载功能可能需要
# Software Flow Offloading (如果硬件卸载有问题或需要兼容某些功能)
# CONFIG_PACKAGE_kmod-ipt-offload=y # 基于 iptables (如果使用旧防火墙或兼容包)
# CONFIG_PACKAGE_kmod-nf-flow=y # 基础流表支持，可能被自动选中
CONFIG_HAS_NETFILTER_OFFLOAD=y # 确保内核支持 Offload

# 5. File Management (Samba for Windows Share)
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
# 可选: NFS for Linux/macOS Share
# CONFIG_PACKAGE_luci-app-nfs=y
# CONFIG_PACKAGE_nfs-kernel-server=y

# 6. Scientific Internet Access (OpenClash from kenzo/small feeds)
# 假设 openclash 包名为 luci-app-openclash
CONFIG_PACKAGE_luci-app-openclash=y
# OpenClash 依赖通常会被自动选中，但确认几个关键的
CONFIG_PACKAGE_coreutils=y # 基础工具
CONFIG_PACKAGE_coreutils-nohup=y # OpenClash 可能用到 nohup
CONFIG_PACKAGE_bash=y # 有些脚本可能需要 bash
CONFIG_PACKAGE_curl=y # 下载 clash core 或订阅
CONFIG_PACKAGE_dnsmasq-full=y # 推荐使用 full 版，提供更强 DNS 功能配合 Clash
CONFIG_PACKAGE_libyaml=y # YAML 解析库
# 可能需要iptables相关包，即使默认是nftables，以防openclash依赖 (检查kenzo源的说明)
# CONFIG_PACKAGE_iptables-nft=y
# CONFIG_PACKAGE_kmod-ipt-core=y
# CONFIG_PACKAGE_kmod-ipt-nat=y
# ... 其他 iptables 模块视 OpenClash 具体实现而定
# 如果 OpenClash 需要 Go 运行时，通常会打包好或自动选择依赖

# 7. IPv6 Support
CONFIG_IPV6=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y # IPv6 Client (DHCPv6)
CONFIG_PACKAGE_odhcpd-ipv6only=y # IPv6 Server (RA/DHCPv6) - 如果需要局域网 IPv6
CONFIG_PACKAGE_kmod-ipv6=y
CONFIG_PACKAGE_kmod-ip6tables=y # 如果使用 iptables
CONFIG_PACKAGE_ip6tables-extra=y # 如果使用 iptables
CONFIG_PACKAGE_kmod-nf-conntrack6=y
CONFIG_PACKAGE_kmod-nf-ipt6=y # 如果使用 iptables
CONFIG_PACKAGE_kmod-nft-nat6=y # 如果使用 nftables (默认)

# LuCI Applications (ensure base is selected)
CONFIG_PACKAGE_luci-app-firewall=y # Firewall4 (nftables) LuCI interface
CONFIG_PACKAGE_luci-app-opkg=y # Package management in LuCI

# Utilities (可选，但推荐)
CONFIG_PACKAGE_htop=y # 进程监控
CONFIG_PACKAGE_tcpdump-mini=y # 网络抓包
CONFIG_PACKAGE_nano=y # 命令行编辑器 (比 vi 易用)
CONFIG_PACKAGE_irqbalance=y # 中断均衡，可能提升 MT7621 性能

# Wireless Drivers for Newifi D2 (MT7603EN + MT7612EN)
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y # MT7612E/MT7662E driver
# CONFIG_PACKAGE_kmod-mt7615e=y # newifi3 D2 应该是 MT7612EN，不是 15E，确认一下
# CONFIG_PACKAGE_kmod-mt7615-firmware=y

# Filesystems Utilities
CONFIG_PACKAGE_fdisk=y # 磁盘分区工具
CONFIG_PACKAGE_lsblk=y # 查看块设备

# 移除不需要的包以节省空间 (示例)
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ppp is not set # 如果不用 PPPoE/VPN client
# CONFIG_PACKAGE_kmod-ppp is not set

# Important: Run 'make menuconfig' after placing this .config file
# to ensure all dependencies are resolved correctly and load the config.
# Then save the configuration via menuconfig before running 'make'.
