# ======================
# 核心系统配置
# ======================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y
CONFIG_TARGET_ROOTFS_PARTSIZE=512    # 防止空间不足

# ======================
# 基础功能套件
# ======================
CONFIG_PACKAGE_block-mount=y          # 存储挂载
CONFIG_PACKAGE_fdisk=y                # 分区工具
CONFIG_PACKAGE_lsblk=y                # 存储设备列表
CONFIG_PACKAGE_resize2fs=y            # 分区扩容
CONFIG_PACKAGE_e2fsprogs=y            # 文件系统工具

# ======================
# 内核模块 (存储/USB支持)
# ======================
CONFIG_PACKAGE_kmod-usb3=y            # USB3.0支持
CONFIG_PACKAGE_kmod-usb-storage=y     # USB存储
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-fs-exfat=y        # exFAT支持
CONFIG_PACKAGE_kmod-fs-f2fs=y         # F2FS支持
CONFIG_PACKAGE_kmod-fs-ntfs=y         # NTFS支持
CONFIG_PACKAGE_ntfs-3g=y              # NTFS读写工具

# ======================
# 网络加速与优化
# ======================
CONFIG_PACKAGE_luci-app-turboacc=y    # TurboACC核心
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_flow-offload=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_shortcut-fe=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_dnsproxy=y

# ======================
# 网络服务与安全
# ======================
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_miniupnpd=y            # UPnP IGD
CONFIG_PACKAGE_luci-app-upnp=y        # UPnP界面
CONFIG_PACKAGE_ip6tables=y            # IPv6防火墙
CONFIG_PACKAGE_ip6tables-mod-nat=y

# ======================
# IPv6完整支持
# ======================
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y      # 增强IPv6 DHCP

# ======================
# 存储扩展功能
# ======================
CONFIG_PACKAGE_automount=y            # 自动挂载
CONFIG_PACKAGE_badblocks=y            # 磁盘检测
CONFIG_PACKAGE_hd-idle=y              # 硬盘休眠
CONFIG_PACKAGE_smartmontools=y        # SMART监控

# ======================
# 文件管理与共享
# ======================
CONFIG_PACKAGE_filebrowser=y          # 新一代文件管理器
CONFIG_PACKAGE_luci-app-filebrowser=y # Web管理界面
CONFIG_PACKAGE_samba4-server=y        # SMB共享
CONFIG_PACKAGE_samba4-libs=y
CONFIG_PACKAGE_luci-app-samba4=y      # SMB管理界面

# ======================
# DDNS动态域名
# ======================
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y         # 基础脚本
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y

# ======================
# 实用工具包
# ======================
CONFIG_PACKAGE_curl=y                 # 网络调试工具
CONFIG_PACKAGE_htop=y                 # 进程监控
CONFIG_PACKAGE_openssl-util=y         # 加密工具
CONFIG_PACKAGE_vim-full=y             # 增强版编辑器

# ======================
# 界面与本地化
# ======================
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # 中文界面
CONFIG_PACKAGE_luci-theme-material=y  # 现代化主题
CONFIG_PACKAGE_luci-app-advanced=y    # 高级设置

# ======================
# OpenClash核心配置
# ======================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_coremark=y             # 性能测试工具

# ======================
# 打印机服务增强
# ======================
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_usbutils=y             # USB设备检测

# ======================
# 系统监控与维护
# ======================
CONFIG_PACKAGE_luci-app-statistics=y  # 实时监控
CONFIG_PACKAGE_lm-sensors=y           # 硬件传感器
CONFIG_PACKAGE_smartd=y               # 磁盘健康监控

# ======================
# 安全增强功能
# ======================
CONFIG_PACKAGE_openssh-sftp-server=y  # SFTP支持
CONFIG_PACKAGE_fail2ban=y             # 入侵防御
CONFIG_PACKAGE_tcpdump=y              # 网络抓包
