# ========================================
# Target System Configuration
# ========================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ========================================
# Build Options
# ========================================
CONFIG_TARGET_IMAGES_squashfs=y                 # Build SquashFS image
CONFIG_TARGET_ROOTFS_SQUASHFS=y                # Use SquashFS for rootfs
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256          # SquashFS block size (from reference)
# CONFIG_TARGET_ROOTFS_TARGZ is not set         # Disable tar.gz rootfs image generation (not needed for sysupgrade)
CONFIG_TARGET_IMAGES_PAD=y                       # Pad images
CONFIG_TARGET_ROOTFS_PARTSIZE=128              # Rootfs partition size (adjust if needed and if space allows)
CONFIG_KERNEL_BUILD_USER="OpenWrt"             # Kernel build user (from reference)
CONFIG_KERNEL_BUILD_DOMAIN="openwrt.org"       # Kernel build domain (from reference)

# ========================================
# Base system & Utilities
# ========================================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ca-bundle=y                    # Already dependency, but good to ensure for SSL
CONFIG_PACKAGE_ca-certificates=y              # From reference
CONFIG_PACKAGE_coreutils=y                    # Essential utils (OpenClash dep)
CONFIG_PACKAGE_coreutils-nohup=y              # Essential for OpenClash
CONFIG_PACKAGE_curl=y                         # Essential for OpenClash & others
CONFIG_PACKAGE_htop=y                         # Process viewer (from reference)
CONFIG_PACKAGE_nano=y                         # Text editor (from reference)
CONFIG_PACKAGE_wget-ssl=y                     # Wget with SSL support (from reference)
CONFIG_PACKAGE_rpcd=y                         # LuCI backend
CONFIG_PACKAGE_ucode=y                        # Scripting language for config
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uloop=y
CONFIG_PACKAGE_ip-full=y                      # Advanced IP utility (OpenClash dep from reference)
CONFIG_PACKAGE_ipset=y                        # IP set utility (OpenClash dep)

# ========================================
# IPv6 Support (Enhanced based on reference)
# ========================================
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_6to4=y
CONFIG_PACKAGE_luci-proto-ipv6=y              # LuCI IPv6 connection protocols

# ========================================
# Kernel Modules - Drivers & Core Netfilter
# ========================================
# Wireless Drivers (Corrected based on reference analysis)
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt7603=y                  # MT7603E driver (2.4GHz) - Corrected
CONFIG_PACKAGE_kmod-mt76x2=y                  # MT76x2E driver (5GHz)
# USB Support
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-printer=y             # USB Printer support
# Filesystem support (Often useful, implicitly needed)
CONFIG_PACKAGE_kmod-fs-vfat=y                 # FAT filesystem (USB drives)
CONFIG_PACKAGE_kmod-fs-exfat=y                # exFAT filesystem (USB drives)
CONFIG_PACKAGE_kmod-fs-ext4=y                 # Ext4 filesystem (USB drives)
CONFIG_PACKAGE_kmod-nls-cp437=y               # Code page for FAT
CONFIG_PACKAGE_kmod-nls-iso8859-1=y           # Code page for FAT
CONFIG_PACKAGE_kmod-nls-utf8=y                # UTF8 support for filesystems
# Tunneling
CONFIG_PACKAGE_kmod-tun=y                     # TUN/TAP device support (OpenClash)
# Netfilter Core & Modules (nftables focused)
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y             # Nftables Hardware Flow Offload (TurboACC)
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y           # IPv6 Connection tracking
CONFIG_PACKAGE_kmod-nf-flow=y                 # Software flow offloading core
CONFIG_PACKAGE_kmod-nf-nat6=y                 # IPv6 NAT support
CONFIG_PACKAGE_kmod-nf-reject6=y              # IPv6 Reject support
CONFIG_PACKAGE_kmod-nf-log6=y                 # IPv6 Logging support
CONFIG_PACKAGE_kmod-iptables=y                # Core iptables (for compatibility)
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-nat=y                 # Iptables NAT (potentially needed by OpenClash/others)
CONFIG_PACKAGE_kmod-ipt-offload=y             # Iptables Hardware Flow Offload (TurboACC)
CONFIG_PACKAGE_kmod-ipt-ipset=y               # ipset support for iptables (OpenClash)
CONFIG_PACKAGE_kmod-ipt-tproxy=y              # TPROXY target for iptables (OpenClash TRANSPARENT_PROXY)
CONFIG_PACKAGE_iptables-mod-extra=y           # Extra iptables matches (OpenClash dependency)
CONFIG_PACKAGE_iptables-nft=y                 # ***IMPORTANT: iptables compat layer for nftables***
# FullCone NAT (NFT version from diy-part1.sh)
CONFIG_PACKAGE_kmod-nft-fullcone=y            # Correct FullCone for nftables/firewall4
# CONFIG_PACKAGE_kmod-ipt-fullconenat is not set # Avoid iptables version conflict
# CONFIG_PACKAGE_iptables-mod-fullconenat is not set # Avoid iptables version conflict
# TCP Congestion Control
CONFIG_PACKAGE_kmod-tcp-bbr=y                 # TCP BBR (for TurboACC CCA option)

# ========================================
# Libraries
# ========================================
CONFIG_PACKAGE_libopenssl=y                   # Using OpenSSL variant (better compatibility than wolfssl sometimes)
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_libyaml=y                      # OpenClash dependency
CONFIG_PACKAGE_ruby-yaml=y                    # OpenClash dep from reference (more specific)
CONFIG_PACKAGE_libcap=y                       # OpenClash dependency
CONFIG_PACKAGE_libmnl=y                       # ipset dependency

# ========================================
# Network Daemons & Services
# ========================================
# DNS (Use dnsmasq-full, disable base dnsmasq)
# CONFIG_PACKAGE_dnsmasq is not set              # ***IMPORTANT: Disable default dnsmasq***
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_auth=y            # Enable detailed options from reference
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y          # Required for IPv6 DHCP
CONFIG_PACKAGE_dnsmasq_full_dnssec=y          # DNSSEC support
CONFIG_PACKAGE_dnsmasq_full_ipset=y           # ipset integration (OpenClash FAKE-IP needs this)
# CONFIG_PACKAGE_dnsmasq_full_noid is not set    # Generally safe to keep default (enabled)
CONFIG_PACKAGE_dnsmasq_full_tftp=y            # TFTP server support (optional, included as per ref)
# Firewall
CONFIG_PACKAGE_firewall4=y                    # Use Firewall4 (nftables based)
# USB Printer Server
CONFIG_PACKAGE_p910nd=y                       # Non-spooling Printer Daemon
# UPnP / NAT-PMP (NFT version)
CONFIG_PACKAGE_miniupnpd-nftables=y           # ***IMPORTANT: UPnP daemon for nftables/firewall4***
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y      # Includes NAT-PMP helper
CONFIG_PACKAGE_natpmpc=y                      # NAT-PMP client tool (ref) - miniupnpd should provide server part
# WiFi Security
CONFIG_PACKAGE_wpad-openssl=y                 # Use OpenSSL variant of wpad for full WPA2/WPA3 support
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad is not set                # Meta package, select specific implementation
# CONFIG_PACKAGE_wpad-wolfssl is not set        # Alternative to openssl variant

# ========================================
# LuCI (Web Interface)
# ========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y                  # Compatibility layer for older LuCI apps (ref)
CONFIG_PACKAGE_luci-lib-base=y                # Base LuCI library (ref)
CONFIG_PACKAGE_luci-lib-ip=y                  # IP library for LuCI (ref)
CONFIG_PACKAGE_luci-lib-jsonc=y               # JSON library for LuCI (ref)
CONFIG_PACKAGE_luci-lib-nixio=y               # Nixio library for LuCI (ref)
CONFIG_PACKAGE_luci-mod-admin-full=y          # Full admin module for LuCI (ref)
CONFIG_PACKAGE_luci-mod-network=y             # Network configuration module (ref)
CONFIG_PACKAGE_luci-mod-status=y              # Status pages module (ref)
CONFIG_PACKAGE_luci-mod-system=y              # System settings module (ref)
# LuCI Applications
CONFIG_PACKAGE_luci-app-firewall=y            # LuCI for Firewall4
CONFIG_PACKAGE_luci-app-openclash=y           # LuCI for OpenClash (from diy-part1.sh)
CONFIG_PACKAGE_luci-app-p910nd=y              # LuCI for USB Print Server (from diy-part1.sh)
CONFIG_PACKAGE_luci-app-poweroffdevice=y      # LuCI for Shutdown (from diy-part1.sh)
CONFIG_PACKAGE_luci-app-turboacc=y            # LuCI for Turbo ACC (from diy-part1.sh)
CONFIG_PACKAGE_luci-app-upnp=y                # LuCI for UPnP/NAT-PMP
# Optional: DDNS (from reference)
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y      # Example: Include Cloudflare script (add others as needed)
CONFIG_PACKAGE_ddns-scripts-dnspod=y          # Example: Include DNSPod script
CONFIG_PACKAGE_luci-app-ddns=y
# Themes
CONFIG_PACKAGE_luci-theme-bootstrap=y         # Default theme
# Language (Chinese Simplified)
CONFIG_LUCI_LANG_zh_Hans=y                    # Enable Chinese translation globally
# Specific i18n packages for better translation coverage (from reference)
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y    # Add OpenClash i18n if available (check package makefile)
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y # Add Poweroff i18n if available
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y         # Add DDNS i18n if DDNS is enabled

# ========================================
# Turbo ACC Specific Config Options (Refined)
# ========================================
# Settings enabled within luci-app-turboacc itself via Kconfig if available
# Or handled by selecting kernel modules directly as done above (e.g., offload modules, bbr)
# Explicit Kconfig options for the LuCI App itself:
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y  # Enable Offloading section in LuCI (relies on kmods)
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y     # Enable BBR CCA section in LuCI (relies on kmod-tcp-bbr)
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_PDNSD is not set # ***IMPORTANT: Disable conflicting PDNSD option***

# ========================================
# OpenClash Specific Dependencies (Refined)
# ========================================
CONFIG_PACKAGE_ruby=y                         # Ruby interpreter
# Ensure required executables/links are available (often symlinks handled by packages)
