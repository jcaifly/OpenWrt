# ============================================
# Target System & Image Configuration (目标系统及镜像配置)
# ============================================
CONFIG_TARGET_ramips=y                     # 目标平台架构: ramips
CONFIG_TARGET_ramips_mt7621=y              # 目标子架构: mt7621
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y # 目标设备型号: Newifi D2 (新路由3)

# --- Target Images (目标镜像类型) ---
CONFIG_TARGET_IMAGES_SQUASHFS=y       # 构建 SquashFS 文件系统镜像 (推荐)
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256 # SquashFS 块大小优化 (可选, 256k)
# CONFIG_TARGET_IMAGES_EXT4 is not set  # 不构建 EXT4 镜像
CONFIG_TARGET_IMAGES_GZIP=y           # 使用 Gzip 压缩固件

# ============================================
# Base System Core Components (基础系统核心组件)
# ============================================
CONFIG_PACKAGE_libc=y                     # C 标准库
CONFIG_PACKAGE_libgcc=y                   # GCC 运行时库
CONFIG_PACKAGE_libpthread=y           # POSIX 线程库
CONFIG_PACKAGE_librt=y                    # POSIX 实时扩展库
CONFIG_PACKAGE_libstdcpp=y            # C++ 标准库
CONFIG_PACKAGE_busybox=y                  # 核心工具集
CONFIG_BUSYBOX_CONFIG_POWEROFF=y      # 确保 Busybox 包含 poweroff 命令
CONFIG_PACKAGE_base-files=y               # OpenWrt 基础文件
CONFIG_PACKAGE_ca-bundle=y            # SSL 证书包 (基础)
CONFIG_PACKAGE_ca-certificates=y      # SSL 证书包 (更新机制)
CONFIG_PACKAGE_procd=y                    # OpenWrt 进程管理器
CONFIG_PACKAGE_procd-ujail=y              # procd Ujail 支持
CONFIG_PACKAGE_procd-seccomp=y        # procd Seccomp 支持
CONFIG_PACKAGE_opkg=y                     # OpenWrt 包管理器
CONFIG_PACKAGE_kmodloader=y               # 内核模块加载器
CONFIG_PACKAGE_resolveip=y            # DNS 解析工具 (命令行)
CONFIG_PACKAGE_usign=y                    # 软件包签名验证
CONFIG_PACKAGE_urngd=y                # 硬件熵守护进程
CONFIG_PACKAGE_fstools=y                  # 文件系统工具
CONFIG_PACKAGE_fwtool=y                   # 固件工具
CONFIG_PACKAGE_logd=y                     # 日志守护进程
CONFIG_PACKAGE_mtd=y                      # MTD 工具 (Flash 操作)
CONFIG_PACKAGE_netifd=y                   # 网络接口守护进程
CONFIG_PACKAGE_uclient-fetch=y        # URL 文件获取客户端 (opkg 等依赖)
CONFIG_PACKAGE_urandom-seed=y         # 随机种子保存

# --- 基本网络工具 ---
CONFIG_PACKAGE_ip-full=y              # 完整版 ip 命令
CONFIG_PACKAGE_iwinfo=y               # 无线信息库
CONFIG_PACKAGE_iw=y                   # 无线配置工具 (命令行)
CONFIG_PACKAGE_ethtool=y              # 以太网卡工具

# ============================================
# Administration & LuCI Web Interface (系统管理及 LuCI 网页界面)
# ============================================
CONFIG_PACKAGE_luci=y                     # LuCI 元包
CONFIG_PACKAGE_luci-base=y                # LuCI 基础
CONFIG_PACKAGE_luci-compat=y              # LuCI 兼容性层 (某些旧插件可能需要)
CONFIG_PACKAGE_luci-mod-admin-full=y  # 完整 LuCI 管理模块
CONFIG_PACKAGE_luci-theme-bootstrap=y # LuCI 默认主题 (Bootstrap)
CONFIG_PACKAGE_rpcd=y                     # LuCI 后端 RPC 守护进程
CONFIG_PACKAGE_rpcd-mod-file=y        # RPC 文件模块
CONFIG_PACKAGE_rpcd-mod-iwinfo=y      # RPC 无线信息模块
CONFIG_PACKAGE_rpcd-mod-luci=y        # RPC LuCI 核心模块
CONFIG_PACKAGE_rpcd-mod-rrdns=y       # RPC RRDNS 模块

# --- Web Server for LuCI (LuCI 依赖的网页服务器) ---
CONFIG_PACKAGE_uhttpd=y               # uHTTPd 轻量级 Web 服务器
CONFIG_PACKAGE_uhttpd-mod-ubus=y      # uHTTPd ubus 模块
CONFIG_PACKAGE_luci-app-uhttpd=y      # LuCI uHTTPd 设置界面

# --- SSL Library Preference (SSL 库偏好) ---
CONFIG_PACKAGE_libustream-openssl=y   # 使用 OpenSSL 作为 ustream 的后端 (推荐)
CONFIG_PACKAGE_openssl-util=y         # OpenSSL 命令行工具

# ============================================
# Language Support (语言支持)
# ============================================
CONFIG_LUCI_LANG_zh_Hans=y            # LuCI 简体中文 (元包)
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # LuCI 基础 - 中文
CONFIG_PACKAGE_kmod-nls-utf8=y        # 内核 UTF8 字符集支持 (USB 存储挂载中文名)

# ============================================
# Core Networking Configuration (核心网络配置)
# ============================================
CONFIG_PACKAGE_ipv6helper=y           # IPv6 辅助工具
CONFIG_PACKAGE_kmod-ipv6=y            # 内核 IPv6 支持
CONFIG_PACKAGE_kmod-inet-core=y       # 内核网络核心

# --- Firewall (防火墙 - 使用 Firewall4/nftables) ---
CONFIG_PACKAGE_firewall4=y            # 防火墙管理 - Firewall4 (基于 nftables)
CONFIG_PACKAGE_luci-app-firewall=y    # LuCI 防火墙配置界面
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y # LuCI 防火墙 - 中文

CONFIG_PACKAGE_kmod-nft-core=y        # 内核 Nftables 核心
CONFIG_PACKAGE_kmod-nft-offload=y     # 内核 Nftables 硬件卸载 (TurboACC 需要)
CONFIG_PACKAGE_kmod-nft-compat=y      # 内核 Nftables 兼容模块
CONFIG_PACKAGE_kmod-nfnetlink=y       # 内核 Netfilter Netlink
CONFIG_PACKAGE_nftables=y             # nftables 用户空间工具
# CONFIG_PACKAGE_nftables-nojson=y is not set # 通常不需要, 除非明确要减小体积且不使用 json 输出
CONFIG_PACKAGE_libnftnl=y             # nftables netlink 库
CONFIG_PACKAGE_libmnl=y               # Minimalistic Netlink 库

# --- Iptables Compatibility & IPSet (iptables 兼容层及 IPSet) ---
CONFIG_PACKAGE_iptables-nft=y         # iptables 命令 -> nftables 兼容层
CONFIG_PACKAGE_ip6tables-nft=y        # ip6tables 命令 -> nftables 兼容层
CONFIG_PACKAGE_ipset=y                # IP 地址集合工具 (OpenClash/DNSMasq)
CONFIG_PACKAGE_kmod-ipt-ipset=y       # 内核 IPSet 支持 (iptables/nftables 都可能用)
CONFIG_PACKAGE_iptables-mod-tproxy=y  # Iptables TPROXY 模块 (OpenClash 需要兼容层)
# --- 移除冲突项 ---
# CONFIG_PACKAGE_iptables is not set
# CONFIG_PACKAGE_ip6tables is not set
# CONFIG_PACKAGE_iptables-mod-fullconenat is not set # 严重冲突
# CONFIG_PACKAGE_kmod-ipt-fullconenat is not set # 严重冲突
# CONFIG_PACKAGE_kmod-ipt-offload is not set # 严重冲突

# --- IPv6 Support (IPv6 相关支持) ---
CONFIG_PACKAGE_odhcpd-ipv6only=y      # IPv6 DHCP 服务器/RA
CONFIG_PACKAGE_odhcp6c=y              # IPv6 DHCP 客户端
CONFIG_PACKAGE_luci-proto-ipv6=y      # LuCI IPv6 协议支持

# --- L2TP Support (L2TP 支持) ---
CONFIG_PACKAGE_kmod-l2tp=y            # 内核 L2TP 模块

# ============================================
# DHCP & DNS Services (DHCP 与 DNS 服务)
# ============================================
# CONFIG_PACKAGE_dnsmasq is not set   # 禁用默认基础版 dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y         # 启用功能更全的 dnsmasq-full (自动包含常用功能)
# (dnsmasq-full 的子选项通常会自动选择, 无需手动全选)

# ============================================
# Wireless Networking (无线网络)
# ============================================
# --- Wireless Drivers (无线驱动 - Newifi3 MT7621) ---
CONFIG_PACKAGE_kmod-mt7603=y          # 内核模块 - MT7603 (2.4GHz)
# CONFIG_PACKAGE_kmod-mt7603e is not set # 确保禁用冲突驱动
CONFIG_PACKAGE_kmod-mt76x2=y          # 内核模块 - MT76x2 (5GHz)
CONFIG_PACKAGE_kmod-mt76-core=y       # 内核模块 - Mediatek 无线核心库
CONFIG_PACKAGE_kmod-mt76x02-common=y  # 内核模块 - MT76x0/x2 通用库

# --- Wireless Authentication (无线认证) ---
CONFIG_PACKAGE_wpad-openssl=y         # WiFi 认证 (支持 WPA/WPA2/WPA3 PSK & EAP, 使用 OpenSSL)
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set # 如果需要 EAP 企业认证, 则 OpenSSL 版是必要的
# CONFIG_PACKAGE_hostapd-common is not set # wpad 会自动依赖

# ============================================
# Kernel Modules (内核模块)
# ============================================
# --- Filesystem Support (文件系统支持) ---
CONFIG_PACKAGE_kmod-fs-ext4=y         # EXT4 文件系统支持
CONFIG_PACKAGE_kmod-fs-ntfs=y         # NTFS 文件系统支持 (只读内核驱动, 如需读写安装 ntfs-3g)
CONFIG_PACKAGE_kmod-fs-exfat=y        # exFAT 文件系统支持
CONFIG_PACKAGE_kmod-fs-vfat=y         # FAT/VFAT (FAT32) 文件系统支持

# --- Network Support Modules (网络支持模块) ---
CONFIG_PACKAGE_kmod-nf-flow=y         # 内核 Flow Offloading 支持 (TurboACC)
CONFIG_PACKAGE_kmod-nf-reject=y
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nf-log=y
CONFIG_PACKAGE_kmod-nf-log6=y
CONFIG_PACKAGE_kmod-nf-nat=y          # 内核 NAT
CONFIG_PACKAGE_kmod-tcp-bbr=y         # 内核 TCP BBR 拥塞控制 (TurboACC)
CONFIG_PACKAGE_kmod-tun=y             # 内核 TUN/TAP 支持 (OpenClash TUN 模式)
CONFIG_PACKAGE_kmod-inet-diag=y       # 内核网络套接字监控 (OpenClash 依赖)
CONFIG_PACKAGE_kmod-nft-tproxy=y      # 内核 Nftables TPROXY (透明代理, OpenClash)
CONFIG_PACKAGE_kmod-ipt-tproxy=y      # 内核 Iptables TPROXY (兼容性, iptables-nft 需要)
CONFIG_PACKAGE_kmod-nft-fullcone=y    # 内核 FullCone NAT 支持 (TurboACC 依赖 - 需 diy-part1.sh 添加源)
# CONFIG_PACKAGE_kmod-nf-nathelper is not set # 通常由 kmod-nf-nat 自动处理或按需添加
# CONFIG_PACKAGE_kmod-nf-nathelper-extra is not set # 同上

# --- Hardware Acceleration Modules (硬件加速模块) ---
CONFIG_PACKAGE_kmod-shortcut-fe=y     # 内核 Shortcut Forwarding Engine (SFE) (TurboACC)
CONFIG_PACKAGE_kmod-shortcut-fe-cm=y  # SFE Connection Manager (推荐)
# CONFIG_PACKAGE_kmod-fast-classifier is not set # SFE 通常已包含所需

# --- USB Support Modules (USB 支持模块) ---
CONFIG_PACKAGE_kmod-usb-core=y        # 内核 USB 核心
CONFIG_PACKAGE_kmod-usb-ohci=y        # USB 1.1 OHCI
CONFIG_PACKAGE_kmod-usb-uhci=y        # USB 1.1 UHCI
CONFIG_PACKAGE_kmod-usb2=y            # USB 2.0 EHCI
CONFIG_PACKAGE_kmod-usb3=y            # USB 3.0 XHCI (Newifi3)
CONFIG_PACKAGE_libusb-1.0=y           # 用户空间 USB 库
CONFIG_PACKAGE_usbutils=y             # USB 工具 (lsusb)
CONFIG_PACKAGE_kmod-usb-printer=y     # 内核 USB 打印机驱动
CONFIG_PACKAGE_kmod-usb-storage=y     # 内核 USB 存储驱动
CONFIG_PACKAGE_kmod-usb-storage-extras=y # USB 存储 - 额外支持 (读卡器等)
CONFIG_PACKAGE_block-mount=y          # 块设备挂载支持

# --- Crypto Hardware Acceleration & RNG (加密硬件加速与随机数) ---
CONFIG_PACKAGE_kmod-crypto-hash=y     # 内核通用加密 Hash
CONFIG_PACKAGE_kmod-crypto-hwrng=y    # 内核硬件随机数生成器驱动
CONFIG_PACKAGE_kmod-crypto-aes=y      # 内核 AES 加密
CONFIG_PACKAGE_kmod-crypto-crc32c=y   # 内核 CRC32c
CONFIG_PACKAGE_kmod-random-core=y     # 内核随机数核心
CONFIG_PACKAGE_kmod-random-mt7621=y   # 内核 MT7621 硬件随机数生成器

# --- Watchdog Timer (硬件看门狗) ---
CONFIG_PACKAGE_kmod-wdt-mt7621=y      # MT7621 硬件看门狗内核模块
CONFIG_PACKAGE_watchcat=y             # 看门狗守护进程

# ============================================
# LuCI Applications (LuCI 应用插件)
# ============================================
# --- Core Functionality Apps (核心功能 LuCI 应用) ---
# luci-app-firewall 已在上面 Firewall 部分选择
CONFIG_PACKAGE_luci-app-opkg=y        # LuCI 软件包管理器
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y # LuCI 软件包管理器 - 中文

# --- User Requested Apps (用户指定安装的 LuCI 应用) ---
CONFIG_PACKAGE_luci-app-openclash=y         # LuCI - OpenClash
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y  # LuCI - OpenClash (中文)
CONFIG_PACKAGE_luci-app-turboacc=y          # LuCI - Turbo ACC 网络加速
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y   # LuCI - Turbo ACC (中文)
CONFIG_PACKAGE_luci-app-upnp=y              # LuCI - UPnP / NAT-PMP
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y       # LuCI - UPnP / NAT-PMP (中文)
CONFIG_PACKAGE_luci-app-usb-printer=y       # LuCI - USB 打印服务器
CONFIG_PACKAGE_luci-i18n-usb-printer-zh-cn=y # LuCI - USB 打印服务器 (中文)
CONFIG_PACKAGE_luci-app-poweroffdevice=y    # LuCI - 关机/重启
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y # LuCI - 关机/重启 (中文)
CONFIG_PACKAGE_luci-app-nlbwmon=y           # LuCI - 网络带宽监视器
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y    # LuCI - 网络带宽监视器 (中文)
# CONFIG_PACKAGE_luci-app-wrtbwmon=y is not set # 选择 nlbwmon

# --- Additional Network/System Apps (额外网络/系统应用) ---
CONFIG_PACKAGE_luci-app-ddns=y              # LuCI - DDNS 动态域名
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y       # LuCI - DDNS (中文)
CONFIG_PACKAGE_luci-app-wol=y               # LuCI - 网络唤醒 (Wake on LAN)
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y        # LuCI - 网络唤醒 (中文)
CONFIG_PACKAGE_luci-app-statistics=y        # LuCI - 系统状态统计 (需要 collectd)
CONFIG_PACKAGE_luci-app-netdata=y           # LuCI - Netdata 实时监控 (较重)
CONFIG_PACKAGE_luci-app-watchcat=y          # LuCI - 看门狗设置
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y   # LuCI - 看门狗 (中文)
CONFIG_PACKAGE_luci-app-hd-idle=y           # LuCI - 硬盘休眠设置
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y    # LuCI - 硬盘休眠 (中文)
CONFIG_PACKAGE_luci-app-filetransfer=y      # LuCI - 文件传输 (上传/下载)
CONFIG_PACKAGE_luci-i18n-filetransfer-zh-cn=y # LuCI - 文件传输 (中文)
CONFIG_PACKAGE_luci-app-ttyd=y              # LuCI - TTYD 网页终端
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y       # LuCI - TTYD (中文)
# CONFIG_PACKAGE_luci-app-vlmcsd=y is not set # KMS 服务, 非通用需求

# ============================================
# Network Services (网络服务程序)
# ============================================
CONFIG_PACKAGE_p910nd=y               # p910nd 打印服务器守护程序
CONFIG_PACKAGE_miniupnpd=y            # UPnP 和 NAT-PMP 守护进程
CONFIG_PACKAGE_dropbear=y             # 轻量级 SSH 服务器
CONFIG_PACKAGE_ttyd=y                 # TTYD 守护进程

# ============================================
# Dependencies for Specific Applications (特定应用的依赖)
# ============================================
# --- OpenClash Dependencies ---
CONFIG_PACKAGE_coreutils=y            # 核心工具 (base64, head, tail 等)
CONFIG_PACKAGE_coreutils-base64=y     # 明确包含 base64
CONFIG_PACKAGE_coreutils-nohup=y      # 明确包含 nohup
CONFIG_PACKAGE_bash=y                 # Bash Shell
CONFIG_PACKAGE_curl=y                 # 网络内容获取
CONFIG_PACKAGE_libcurl=y              # Curl 库
CONFIG_PACKAGE_libcap=y               # POSIX 能力库
CONFIG_PACKAGE_libcap-ng=y            # 另一个 POSIX 能力库
CONFIG_PACKAGE_libcap-bin=y           # 能力查看/设置工具
CONFIG_PACKAGE_ruby=y                 # Ruby 解释器
CONFIG_PACKAGE_ruby-yaml=y            # Ruby YAML 库
CONFIG_PACKAGE_ruby-psych=y           # Ruby YAML 库

# ============================================
# Utilities (实用工具)
# ============================================
CONFIG_PACKAGE_nano=y                 # Nano 文本编辑器 (可选)
CONFIG_PACKAGE_htop=y                 # Htop 交互式进程查看器
CONFIG_PACKAGE_wget=y                 # 文件下载工具 (命令行)
CONFIG_PACKAGE_coremark=y             # CPU 性能测试工具 (可选)

# ============================================
# Security Components (安全相关组件)
# ============================================
CONFIG_PACKAGE_acl=y                  # 文件访问控制列表 (ACL) 支持
CONFIG_PACKAGE_libacl=y               # ACL 库

# ============================================
# Essential Libraries (基础库)
# ============================================
CONFIG_PACKAGE_zlib=y                 # 通用压缩库

# ============================================
# Default Network/System LuCI Modules (默认的网络/系统 LuCI 模块)
# ============================================
CONFIG_PACKAGE_luci-mod-network=y     # LuCI 网络设置
CONFIG_PACKAGE_luci-mod-system=y      # LuCI 系统设置
CONFIG_PACKAGE_luci-mod-status=y      # LuCI 状态概览
CONFIG_PACKAGE_luci-proto-ppp=y       # LuCI PPPoE/PPTP/L2TP 协议

# ============================================
# Final Review & Notes (最终检查与说明)
# ============================================
# - 使用 firewall4/nftables, 移除了 iptables 核心冲突包.
# - TurboACC 依赖正确配置 (kmod-shortcut-fe*, kmod-nft-fullcone, kmod-tcp-bbr).
# - 包含 OpenClash, USB打印, UPnP, 关机, IPv6, TurboACC, 中文界面等核心需求.
# - 添加了 Watchdog, Netdata, DDNS, WOL, 文件传输, ttyd, 硬盘休眠等实用功能.
# - 确认无线驱动为 mt7603/mt76x2, 无线认证为 wpad-openssl.
# - 移除无效 KERNEL_* 配置项.
# - 需配合包含 kmod-nft-fullcone 源码的 diy-part1.sh 使用.
# ============================================
