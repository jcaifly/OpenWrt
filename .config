# ==================================================
# Target System Settings (Newifi D3)
# ==================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7621=y
CONFIG_TARGET_mediatek_mt7621_DEVICE_d-team_newifi-d2=y

# ==================================================
# Firmware Image Options
# ==================================================
# CONFIG_TARGET_IMAGES_GZIP is not set # 不编译 Gzip 压缩的镜像
CONFIG_TARGET_IMAGES_SQUASHFS=y        # 编译 SquashFS 镜像
CONFIG_TARGET_IMAGE_OPTIONS_SPLIT_IMAGES=y # 分割镜像文件（通常生成 factory 和 sysupgrade）
CONFIG_TARGET_ROOTFS_SQUASHFS=y        # RootFS 使用 SquashFS
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024 # (可选) SquashFS 块大小 (1024k 常用)
# CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE is not set # 通常不需要 initramfs

# ==================================================
# LuCI (Web Interface) Configuration
# ==================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y                    # LuCI HTTPS 支持
CONFIG_PACKAGE_luci-theme-bootstrap=y        # 默认 Bootstrap 主题
# 确保其他主题未被选中 (示例)
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-material is not set

# --- LuCI Core Apps ---
CONFIG_PACKAGE_luci-app-firewall=y           # Firewall4 LuCI 界面
CONFIG_PACKAGE_luci-proto-ipv6=y             # IPv6 相关协议支持 (如 Relay)
CONFIG_PACKAGE_luci-proto-ppp=y              # PPPoE/PPTP 等 PPP 协议支持

# --- LuCI Translations ---
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y        # LuCI 基础中文翻译
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y    # Firewall 中文翻译

# ==================================================
# Networking Configuration
# ==================================================
CONFIG_IPV6=y                                # 启用 IPv6 支持
CONFIG_PACKAGE_ipv6helper=y                  # IPv6 辅助工具
CONFIG_PACKAGE_ip-full=y                     # 完整的 iproute2 工具集

# --- Firewall (Firewall4 based on nftables) ---
CONFIG_PACKAGE_firewall4=y                   # 启用 Firewall4
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y                # IP/IPv6 Route/Rule lookup support
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nft-nat=y                # NAT 支持
CONFIG_PACKAGE_kmod-nft-offload=y            # Flow Offloading 支持 (依赖硬件)
CONFIG_PACKAGE_kmod-nft-tproxy=y             # TPROXY target (OpenClash TPROXY 模式可能需要)
CONFIG_PACKAGE_libnftnl=y                    # nftables 用户空间库
CONFIG_PACKAGE_nftables-json=y               # nftables JSON 定义支持
CONFIG_PACKAGE_iptables-nft=y                # iptables -> nftables 兼容层 (一些脚本或应用可能需要)
CONFIG_PACKAGE_ipset=y                       # IP sets support (OpenClash/SmartDNS 等可能需要)
# --- Ensure old firewall is disabled ---
# CONFIG_PACKAGE_firewall is not set

# --- DNS ---
# 使用 dnsmasq-full 替换 dnsmasq
CONFIG_PACKAGE_dnsmasq_full=y                # 选用 dnsmasq-full
# CONFIG_PACKAGE_dnsmasq is not set          # 禁用标准版 dnsmasq
# 注意：LuCI 的 DHCP/DNS 配置在 Network -> DHCP and DNS 下，通常不需要单独的 luci-app-dnsmasq*
# CONFIG_PACKAGE_luci-app-dnsmasq-full is not set
# CONFIG_PACKAGE_luci-app-dhcp is not set

# ==================================================
# Wireless Drivers & Configuration (Newifi D3)
# ==================================================
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt7603e=y                # 2.4GHz Wireless Driver (MT7603E)
CONFIG_PACKAGE_kmod-mt76x2e=y                # 5GHz Wireless Driver (MT7612E)
# --- Ensure other similar drivers are not set ---
# CONFIG_PACKAGE_kmod-mt76x0e is not set
# CONFIG_PACKAGE_kmod-mt76x2u is not set
CONFIG_PACKAGE_wpad-mbedtls=y                # 使用 wpad (mbedtls 版本, 支持 WPA2/WPA3)
# --- Ensure basic wpad versions are not set ---
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-wolfssl is not set

# ==================================================
# USB Support
# ==================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y                   # EHCI (USB 2.0) Support
CONFIG_PACKAGE_kmod-usb3=y                   # XHCI (USB 3.0) Support (Newifi D3 has USB3)
# CONFIG_PACKAGE_kmod-usb-ohci is not set    # OHCI (USB 1.1) Support (可能不需要)

# --- USB Printer Support ---
CONFIG_PACKAGE_kmod-usb-printer=y            # USB Printer kernel module
CONFIG_PACKAGE_kmod-lp=m                     # Line Printer driver (编译为模块 'm', 可选)
CONFIG_PACKAGE_p910nd=y                      # Printer server daemon (常用)
CONFIG_PACKAGE_luci-app-p910nd=y             # LuCI for p910nd
CONFIG_PACKAGE_luci-i18n-p910nd-zh-cn=y      # p910nd 中文翻译

# ==================================================
# Excluded Packages (UPnP, DDNS)
# ==================================================
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_ddns-scripts-cloudflare is not set # 示例：明确禁用几个常见的 ddns 脚本
# CONFIG_PACKAGE_ddns-scripts-aliyun is not set
# CONFIG_PACKAGE_ddns-scripts-dnspod is not set

# ==================================================
# Custom Added Packages (Selected via menuconfig after feeds install)
# Dependencies should be automatically handled or manually verified.
# Ensure these are set to 'y' in menuconfig.
# ==================================================

# --- OpenClash ---
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
# --- OpenClash Dependencies (Key Ones, others may be auto-selected) ---
CONFIG_PACKAGE_coreutils=y                   # Need full coreutils, not busybox versions sometimes
CONFIG_PACKAGE_coreutils-nohup=y             # Specifically needed by OpenClash scripts
CONFIG_PACKAGE_bash=y                        # Often required by complex scripts
CONFIG_PACKAGE_curl=y                        # For downloading rules/updates
CONFIG_PACKAGE_ca-bundle=y                   # SSL Certificates
CONFIG_PACKAGE_libcap=y                      # Linux Capabilities support
# CONFIG_PACKAGE_libcurl is implicitly selected by curl
CONFIG_PACKAGE_libyaml=y                     # YAML parsing library (C version)
CONFIG_PACKAGE_ruby=y                        # Ruby interpreter
CONFIG_PACKAGE_ruby-yaml=y                   # Ruby bindings for YAML
CONFIG_PACKAGE_ruby-psych=y                  # Alternative Ruby YAML parser (check OpenClash requirements)
CONFIG_PACKAGE_jsonfilter=y                  # Used by LuCI JS
CONFIG_PACKAGE_wget-ssl=y                    # Alternative downloader (ensure one is selected)
CONFIG_PACKAGE_unzip=y                       # For GeoIP/GeoSite databases
CONFIG_PACKAGE_kmod-tun=y                    # TUN/TAP device support for TUN mode
# CONFIG_PACKAGE_upx is not set                # UPX packer (optional, can reduce size but might have issues)
# GeoIP/GeoSite DBs are usually handled by OpenClash Makefile at runtime or build time

# --- SmartDNS ---
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y                    # Ensure this matches the name in pymumu's Makefile
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_luci-compat=y                 # May be needed for LuCI compatibility

# --- Turbo ACC ---
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
# --- Turbo ACC Dependencies ---
CONFIG_PACKAGE_kmod-nft-fullcone=y           # Include the FullCone NAT module from custom source
CONFIG_PACKAGE_kmod-tcp-bbr=y                # TCP BBR Congestion Control
CONFIG_PACKAGE_kmod-sched-cake=y             # CAKE packet scheduler (useful for QoS/SQM)
# kmod-nft-offload is selected under Firewall section

# --- PoweroffDevice ---
CONFIG_PACKAGE_luci-app-poweroffdevice=y
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y
# luci-compat is selected under SmartDNS

# --- kmod-nft-fullcone (already listed as dep, ensure it's selected) ---
CONFIG_PACKAGE_kmod-nft-fullcone=y

# ==================================================
# Utilities & Libraries
# ==================================================
CONFIG_PACKAGE_htop=y                        # Process viewer
CONFIG_PACKAGE_nano-full=y                   # Text editor (full version)
CONFIG_PACKAGE_tcpdump-mini=m                # Network packet analyzer (compile as module)
# CONFIG_PACKAGE_ncurses is implicitly selected by htop/nano

# ==================================================
# Build System Options & Optimizations
# ==================================================
# CONFIG_USE_MIPS16 is not set               # Avoid MIPS16 instructions (can cause issues)
# CONFIG_STRIP_KERNEL_EXPORTS is not set     # Usually not needed
# CONFIG_USE_LTO is not set                  # Link Time Optimization (can be experimental)
# CONFIG_USE_GC_SECTIONS is not set          # Garbage Collect Sections (can reduce size but needs testing)

# ==================================================
# Security Considerations
# ==================================================
CONFIG_PACKAGE_openssl-util=y                # OpenSSL command-line utility
CONFIG_PACKAGE_dropbear=y                    # SSH server (default)
CONFIG_DROPBEAR_DISABLE_REVERSE_LOOKUP=y     # Speed up SSH login
# CONFIG_DROPBEAR_PASSWORD_AUTH is not set   # Consider disabling password auth for better security (use keys)
# --- Ensure insecure services are disabled ---
# CONFIG_PACKAGE_telnetd is not set

# ==================================================
# Kernel options (Usually defaults are fine)
# ==================================================
# Verify kernel modules needed are selected ('y' or 'm')
